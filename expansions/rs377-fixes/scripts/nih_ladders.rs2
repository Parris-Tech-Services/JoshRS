    case 2_47_56_28_41 : ~nih_climb(2_47_56_28_41, 1_47_56_28_41, false);
    case 2_47_56_28_54 : ~nih_climb(2_47_56_28_54, 1_47_56_28_54, false);
    case default : mes("Nothing interesting happens.");
}

