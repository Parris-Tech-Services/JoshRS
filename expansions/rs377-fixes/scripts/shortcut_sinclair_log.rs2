// JoshRS: log balance over the river north of Sinclair Mansion (GitHub issue #297).
// loc_9322/9323/9324 "Log balance" (Walk-across) sit at 2722,3593-3595 over the river
// (blocked water at z 3592-3596) but had no handler. Banks: 2722,3591 (south), 2722,3597 (north).
// Uses the same pattern as the existing loc_2296 log shortcut. JoshRS family-world rule:
// no Agility requirement and no falling, so every player can use the crossing.

// The logs are ground decor over blocked water, so no tile is ever adjacent to them and an
// operate (oploc) trigger always says "I can't reach that!". An approach trigger (aploc),
// as used by the Waterfall crossing rock, runs from the bank instead.
[aploc1,loc_9322] @joshrs_sinclair_log;
[aploc1,loc_9323] @joshrs_sinclair_log;
[aploc1,loc_9324] @joshrs_sinclair_log;

[label,joshrs_sinclair_log]
if (distance(loc_coord, coord) > 5) {
    p_aprange(5);
    return;
}
def_int $dir = 1; // walking north
def_coord $start = 0_42_56_34_7;
if (coordz(coord) > 3594) {
    $dir = -1; // walking south
    $start = 0_42_56_34_13;
}
p_teleport($start);
p_arrivedelay;
mes("You walk carefully across the slippery log...");
~set_readywalk_bas(human_walk_logbalance_ready, human_walk_logbalance);
~forcemove(movecoord(coord, 0, 0, $dir));
sound_synth(log_balance, 2, 0);
~forcemove(movecoord(coord, 0, 0, multiply($dir, 4)));
sound_synth(log_balance, 1, 0);
~forcemove(movecoord(coord, 0, 0, $dir));
~update_bas;
stat_advance(agility, 85);
mes("...You make it safely to the other side.");
