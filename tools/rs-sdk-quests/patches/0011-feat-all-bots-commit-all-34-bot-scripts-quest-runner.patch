+        if (await q.run(ctx as Ctx)) { log(`DONE ${q.name}`); break; }
+        log(`FAILED ${q.name}`);
+      } catch (e: any) { log(`ERROR ${q.name}: ${e?.message ?? e}`); }
+      await ctx.bot.dismissBlockingUI();
+    }
+  }
+}, { timeout: 15 * 60_000 });
