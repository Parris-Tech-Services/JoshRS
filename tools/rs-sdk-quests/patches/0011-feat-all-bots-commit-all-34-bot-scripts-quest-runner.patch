+    if (tree) {
+        console.log(`Found tree at (${tree.x}, ${tree.z})`);
+        const result = await bot.chopTree(tree);
+        console.log(result.message);
+    }
+
+    // === END SCRIPT LOGIC ===
+
+}, {
+    timeout: 60_000,  // 1 minute timeout
+});
