+
+      const magicBefore = xp(sdk, 'Magic');
+      if (!(await talk(c, /^wizard mizgog$/i))) return false;
+      const done = await waitCond(() => xp(sdk, 'Magic') > magicBefore || !has(sdk, /^red bead$/i), 6000, 250);
