+      if (done || has(sdk, /^amulet of accuracy$/i)) {
+        questComplete = true;
+        return true;
+      }
+      return false;
+    });
+
+    if (!(await startQuest())) return false;
+    if (!(await farmBeads())) return false;
+    if (!(await handIn())) return false;
+    return true;
+  },
+};
