    case rag_troll_bone, rag_pot_troll_bone, rag_polished_troll_bone : return(24);
    case rag_seagull_bone, rag_pot_seagull_bone, rag_polished_seagull_bone : return(25);
    case rag_undead_cow_bone, rag_pot_undead_cow_bone, rag_polished_undead_cow_bone : return(26);
    case rag_experiment_bone, rag_pot_experiment_bone, rag_polished_experiment_bone : return(27);
    case rag_rabbit_bone, rag_pot_rabbit_bone, rag_polished_rabbit_bone : return(28);
    case rag_baby_basilisk_bone, rag_pot_baby_basilisk_bone, rag_polished_baby_basilisk_bone : return(29);
    case rag_desert_lizard_bone, rag_pot_desert_lizard_bone, rag_polished_desert_lizard_bone : return(30);
