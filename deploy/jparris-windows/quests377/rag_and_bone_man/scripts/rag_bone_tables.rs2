// GENERATED by gen_rag.py - bone chain tables (raw -> in vinegar -> polished). Names come from the pinned 377 cache.
// UNVERIFIED: the original 2006 bone list and order; indices below are this bundle's own bookkeeping.

[proc,rag_bone_index](obj $bone)(int)
switch_obj ($bone) {
    case rag_goblin_bone, rag_pot_goblin_bone, rag_polished_goblin_bone : return(0);
    case rag_bear_bone, rag_pot_bear_bone, rag_polished_bear_bone : return(1);
    case rag_ram_bone, rag_pot_ram_bone, rag_polished_ram_bone : return(2);
