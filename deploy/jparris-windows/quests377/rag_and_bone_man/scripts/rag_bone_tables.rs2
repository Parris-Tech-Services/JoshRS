// Raw bone used on a pot of vinegar.
[opheldu,rag_pot_vinegar]
def_int $i = ~rag_bone_index(last_useitem);
if ($i = -1 | last_useitem ! ~rag_raw_bone($i)) {
    ~displaymessage(^dm_default);
    return;
}
inv_del(inv, last_useitem, 1);
inv_del(inv, rag_pot_vinegar, 1);
inv_add(inv, ~rag_potted_bone($i), 1);
mes("You put the bone into the pot of vinegar.");

// Jug of vinegar into an empty pot.
[opheldu,rag_vinegar]
if (last_useitem = pot_empty) {
    inv_del(inv, rag_vinegar, 1);
    inv_del(inv, pot_empty, 1);
    inv_add(inv, jug_empty, 1);
    inv_add(inv, rag_pot_vinegar, 1);
    mes("You pour the vinegar into the pot.");
} else {
    ~displaymessage(^dm_default);
}
