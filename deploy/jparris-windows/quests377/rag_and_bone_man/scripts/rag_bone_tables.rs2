    case rag_snake_bone, rag_pot_snake_bone, rag_polished_snake_bone : return(16);
    case rag_zombie_bone, rag_pot_zombie_bone, rag_polished_zombie_bone : return(17);
    case rag_werewolf_bone, rag_pot_werewolf_bone, rag_polished_werewolf_bone : return(18);
    case rag_moss_giant_bone, rag_pot_moss_giant_bone, rag_polished_moss_giant_bone : return(19);
