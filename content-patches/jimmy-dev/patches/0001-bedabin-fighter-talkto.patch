+[opnpc1,bedabin_fighter]
+~chatnpc("<p,neutral>Hello Effendi! How can I help you?");
+def_int $op = ~bedabin_fighter_options;
+while($op ! null) {
+    if($op = 1) {
+        ~chatplayer("<p,neutral>What is this place?");
+        ~chatnpc("<p,neutral>This is the camp of the Bedabin. Talk to our leader, Al Shabim, he'll be happy to chat.");
+        $op = ~bedabin_fighter_options;
+    } else if($op = 2) {
+        ~chatplayer("<p,neutral>Where is the Shantay Pass?");
+        ~chatnpc("<p,neutral>It is North East of here effendi, across the trackless desert. It will be a thirsty trip.");
+        $op = ~bedabin_fighter_options;
+    } else if($op = 4) {
+        ~chatplayer("<p,neutral>Do you know where I could get a tenti pineapple?");
+        ~chatnpc("<p,shifty>Oooh, <text_gender("sir","madam")> is looking for a really very special item then! You must go and talk to our very illustrious leader, Al Shabim. He's located in the largest tent in our village.");
+        $op = ~bedabin_fighter_options;
+    }
+}
+~chatplayer("<p,neutral>Okay, thanks");
+
+[proc,bedabin_fighter_options]()(int)
+def_int $op;
+if(%desertrescue = ^desertrescue_finding_pineapple) {
+    $op = ~p_choice4("What is this place?", 1, "Do you know where I could get a tenti pineapple?", 4, "Where is the Shantay Pass?", 2, "Okay, thanks", null);
+} else {
+    $op = ~p_choice3("What is this place?", 1, "Where is the Shantay Pass?", 2, "Okay, thanks", null);
+}
+return ($op);
