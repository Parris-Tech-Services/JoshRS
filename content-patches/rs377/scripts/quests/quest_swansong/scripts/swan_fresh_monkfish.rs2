// Swan Song quest: original JoshRS handling for the revision-377 fishing spot.
// This produces only the quest-specific fresh fish while Arnold is waiting for food.
// Regular post-quest monkfish fishing is intentionally NOT enabled here.
[opnpc1,swan_fishingspot]
if (%swansong ! ^swansong_fish) {
    mes("These fishing spots are reserved for the colony's food stores.");
    return;
}
if (stat(fishing) < 62) {
    ~mesbox("You need at least 62 Fishing to catch fresh monkfish.");
    return;
}
if (~check_fish_equipment(net) = false) {
    return;
}
if (inv_freespace(inv) < 1) {
    ~mesbox("You can't carry any more fish.");
    return;
}
if (%action_delay >= map_clock) {
    mes("You are still gathering your net.");
    return;
}
%action_delay = calc(map_clock + 4);
anim(human_smallnet, 0);
sound_synth(net, 1, 0);
p_delay(4);
// Recheck after the delay: do not hand out fish after a stage change or full inventory.
if (%swansong ! ^swansong_fish | inv_total(inv, net) < 1 | inv_freespace(inv) < 1) {
    return;
}
inv_add(inv, swan_raw_monkfish, 1);
stat_advance(fishing, 10);
mes("You catch a fresh monkfish.");
