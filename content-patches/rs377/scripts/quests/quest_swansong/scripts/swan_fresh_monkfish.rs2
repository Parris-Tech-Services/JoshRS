// Swan Song small-net fishing at the actual pinned 377 NPC option 3.
// Quest stage: only fresh food-store fish; after quest: ordinary monkfish.
// Neither stage grants items before the three real sea-troll deaths.
[opnpc1,swan_fishingspot]
mes("Use your small net to catch fresh monkfish here.");

[opnpc3,swan_fishingspot]
if (%swansong ! ^swansong_fish & %swansong ! ^swansong_complete) {
    mes("Fishing here will be possible when the colony is safe.");
    return;
}
if (stat(fishing) < 62) {
    ~mesbox("You need at least 62 Fishing to catch fresh monkfish.");
    return;
}
if (~check_fish_equipment(net) = false) {
    return;
}
if (inv_freespace(inv) < 1) {
    ~mesbox("You can't carry any more fish.");
    return;
}
// The three genuine fishing troll deaths are required before food collection.
// Each kill is credited by the NPC death queue, never by the fishing click.
if (%swansong = ^swansong_fish & %swansong_trolls < 3) {
    ~swan_spawn_fishing_troll;
    return;
}
if (%action_delay >= map_clock) {
    mes("You are still gathering your net.");
    return;
}
%action_delay = calc(map_clock + 4);
anim(human_smallnet, 0);
sound_synth(net, 1, 0);
p_delay(4);
// Recheck after the delay: do not hand out fish after a stage change or full inventory.
if ((%swansong ! ^swansong_fish & %swansong ! ^swansong_complete) | inv_total(inv, net) < 1 | inv_freespace(inv) < 1) {
    return;
}
if (%swansong = ^swansong_fish) {
    inv_add(inv, swan_raw_monkfish, 1);
    stat_advance(fishing, 10);
    mes("You catch a fresh monkfish for the colony.");
} else {
    inv_add(inv, raw_monkfish, 1);
    stat_advance(fishing, 1200);
    mes("You catch a monkfish.");
}
