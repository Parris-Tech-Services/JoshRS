// Swan Song. The cache's varbit [swansong] (basevar=swansong_quest, bits 0-8) is the main quest
// state; the in-between stage numbers are a JoshRS reconstruction (the 377 cache never shipped
// scripts for this quest). See JOSHRS_SIXQUEST_NOTES.md.
^swansong_not_started = 0
^swansong_sent_to_find_wom = 1
^swansong_runes_requested = 2
^swansong_trolls_defended = 3
^swansong_colony_repaired = 4
^swansong_frumscone_visited = 5
^swansong_malignius_dealt = 6
^swansong_complete = 7
// Sub-task varbits (JoshRS reconstruction of values; see all.varbit for bit ranges).
^swansong_franklin_done = 1
^swansong_arnold_done = 1
// Wiki-sourced, UNVERIFIED for 377: rewards and requirements.
^swansong_questpoints = 2
^swansong_req_qp = 100
// Missingness (tombstone, disposition=substitute): lava runes and mist runes do not exist as
// items in the pinned 377 cache. The Wise Old Man's 10 lava + 10 mist + 5 blood rune request is
// substituted with blood runes only until those items are added.
^swansong_blood_runes_needed = 10
^swansong_monkfish_needed = 5
^swansong_iron_sheets_needed = 5
