// Swan Song (2 May 2006). Stage values are original JoshRS; cache varbit swansong is 9 bits wide.
^swansong_not_started = 0
^swansong_started = 10
^swansong_met_franklin = 20
^swansong_met_arnold = 30
^swansong_fish = 40
^swansong_trolls = 50
^swansong_queen = 60
^swansong_return = 70
^swansong_complete = 100
^swansong_questpoints = 2
^swansong_fish_needed = 5

// The pinned 377 swansong varbit is 9 bits; 65 is reserved for army deployment.
^swansong_army_deployed = 65
