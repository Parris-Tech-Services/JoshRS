// Moved out of scripts/_unpack/377/all.varp (see 1002-move-six-quest-varps-out-of-unpack.patch).
// transmit=yes is required: the cache's swan_* varbits on swansong_quest are resolved client-side.
// scope=perm is required to persist: engine default scope is temp.
[swansong_quest]
scope=perm
transmit=yes
