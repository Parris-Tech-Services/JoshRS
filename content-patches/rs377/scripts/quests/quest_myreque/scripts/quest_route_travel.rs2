// In Search of the Myreque: Cyreg, 2005 swamp boat, three plank repairs and hideout access.
// All entrypoints bind actual revision-377 NPC/loc IDs. Never award quest progress from travel alone.

// Cyreg knows how to reach the Hollows. He will not take anyone without real supplies.
[opnpc1,route_cyreg_paddlehorn]
switch_int (%routequest) {
    case ^route_not_started :
        ~chatnpc("<p,neutral>My boat is not for sightseeing.|Ask in the Canifis tavern if you are seeking the Myreque.");
    case ^route_started :
        ~chatnpc("<p,neutral>I will not ferry strangers into a swamp for a careless errand.");
        def_int $yes = ~p_choice2("The Myreque need these steel weapons.", 1, "I will leave.", 2);
        if ($yes ! 1) return;
        if (~route_has_six_weapons = false) {
            ~chatnpc("<p,neutral>Come back with the full set: dagger, mace, two swords,|longsword and warhammer. No substitutes.");
            return;
        }
        if (inv_total(inv, woodplank) < 6) {
            ~chatnpc("<p,neutral>Six ordinary wooden planks: three to fix my boat,|and three more for the old bridge.");
            return;
        }
        if (inv_total(inv, nails) < 225 | inv_total(inv, hammer) < 1) {
            ~chatnpc("<p,neutral>The old bridge needs 225 steel nails and a hammer.");
            return;
        }
        if (inv_total(inv, druid_pouch) < ^route_druid_pouch_charges) {
            ~chatnpc("<p,neutral>Only a charged druid pouch keeps the ghasts at bay.|You will need five charges.");
            return;
        }
        if (inv_total(inv, silver_sickle_blessed) < 1) {
            ~chatnpc("<p,neutral>Take a blessed silver sickle.|You may need to refill your pouch on the crossing.");
            return;
        }
        if (inv_total(inv, coins) < ^route_boat_fare) {
            ~chatnpc("<p,neutral>The crossing costs ten coins.");
            return;
        }
        ~chatnpc("<p,neutral>Very well. Your cargo is ready and I will guide you.|My boat needs three planks and ten coins for the passage.");
        $yes = ~p_choice2("Pay and prepare the boat.", 1, "Not yet.", 2);
        if ($yes ! 1) return;
        // Atomic from the player's perspective: all materials verified before deductions.
        inv_del(inv, woodplank, ^route_woodplanks_to_boatman);
        inv_del(inv, coins, ^route_boat_fare);
        %routequest = ^route_boat_ready;
        ~chatnpc("<p,neutral>Board the old rowboat. Do not waste your remaining planks.");
    case ^route_boat_ready :
        ~chatnpc("<p,neutral>The boat is ready. Board it beside the jetty.");
    case ^route_hollows, ^route_bridge_one, ^route_bridge_two, ^route_bridge_fixed, ^route_guard_passed, ^route_hideout, ^route_members_met, ^route_hound_fight, ^route_hound_dead, ^route_secret_exit, ^route_tunnel_open, ^route_return :
        ~chatnpc("<p,neutral>That crossing is open to you now. The swamp is still dangerous.");
    case default :
        ~chatnpc("<p,neutral>I am sorry for the part I played.|The boat remains available for your journeys.");
}

// Use actual map-spawned boats 6969 at (3523,3284), 6970 at (3498,3377).
// Object 5051 is absent from pinned maps and must not be relied on.
[oploc1,route_rowboat_mortton]
@route_board_to_hollows;
[oploc1,route_rowboat_hollows]
@route_board_to_mortton;

[label,route_board_to_hollows]
if (%routequest < ^route_boat_ready) {
    mes("Cyreg will not let you take the boat until he has agreed to the journey.");
    return;
}
if (inv_total(inv, druid_pouch) < ^route_druid_pouch_charges) {
    mes("Bring a druid pouch with at least five charges before crossing the swamp.");
    return;
}
mes("You climb into the rowboat and travel into the Hollows.");
// Actual Hollows rowboat at plane 0, (3498,3377). Land beside it, not on water.
def_coord $hollows = map_findsquare(0_54_52_43_49, 1, 4, ^map_findsquare_lineofwalk);
if ($hollows = null) {
    mes("There is no safe landing here. The crossing has not been charged again.");
    return;
}
p_telejump($hollows);
if (%routequest = ^route_boat_ready) %routequest = ^route_hollows;

[label,route_board_to_mortton]
if (%routequest < ^route_hollows) {
    mes("You do not yet know how to handle this boat.");
    return;
}
mes("You take the boat south, back towards Mort'ton.");
// Actual southern boat at plane 0, (3523,3284) beside Cyreg.
def_coord $mortton = map_findsquare(0_55_51_4_20, 1, 4, ^map_findsquare_lineofwalk);
if ($mortton = null) {
    mes("The boat cannot find a safe landing. You remain in the Hollows.");
    return;
}
p_telejump($mortton);

// Exactly four bridge locs exist on plane 1; only the first THREE need repairs.
// Cache action on swamp_bridge1: option 1 = Walk-here, option FIVE = Repair.
// Never repurpose Walk-here as Repair, which would make ordinary travel consume nails.
[oploc5,swamp_bridge1]
if (%routequest < ^route_hollows) {
    mes("Arrange passage with Cyreg before crossing the swamp.");
    return;
}
if (%routequest >= ^route_bridge_fixed) {
    mes("The three planks are securely attached.");
    return;
}
def_coord $expected = 1_54_53_46_35;
if (%routequest = ^route_bridge_one) $expected = 1_54_53_46_36;
if (%routequest = ^route_bridge_two) $expected = 1_54_53_46_37;
if (loc_coord ! $expected) {
    mes("Repair the next damaged span, starting at the south end.");
    return;
}
if (inv_total(inv, hammer) < 1) {
    mes("You need a hammer.");
    return;
}
if (inv_total(inv, woodplank) < 1 | inv_total(inv, nails) < ^route_steel_nails_per_span) {
    mes("Each damaged span requires one plank and 75 steel nails.");
    return;
}
inv_del(inv, woodplank, 1);
inv_del(inv, nails, ^route_steel_nails_per_span);
// Cache varbits 176-178 persist and transmit with routequestmulti ID 388.
if (%routequest = ^route_hollows) %bridgerung1 = 1;
if (%routequest = ^route_bridge_one) %bridgerung2 = 1;
if (%routequest = ^route_bridge_two) %bridgerung3 = 1;
%routequest = calc(%routequest + 1);
mes("You secure the damaged span with a plank and 75 nails.");
if (%routequest = ^route_bridge_fixed) {
    mes("All three bridge spans are now safe. Continue north.");
} else {
    mes("Move forward to the next damaged span.");
}

// In this 377 map the ground-floor trees are *harmless_dead_palm_mid*
// (5005) at (3502,3426) and (3502,3431).
// Their walkable bridge endpoints are spooky_tree_mid_forbridge (5004) at plane 1.
[oploc1,harmless_dead_palm_mid]
if (%routequest < ^route_hollows) {
    mes("Speak to Cyreg and take the swamp boat before exploring the bridge.");
    return;
}
if (loc_coord = 0_54_53_46_34) {
    mes("You climb the southern tree to reach the raised bridge.");
    p_teleport(1_54_53_46_34);
} else if (loc_coord = 0_54_53_46_39) {
    if (%routequest < ^route_bridge_fixed) {
        mes("The bridge is too dangerous to use from this side.");
        return;
    }
    mes("You climb the northern tree onto the repaired bridge.");
    p_teleport(1_54_53_46_39);
}

[oploc2,harmless_dead_palm_mid]
if (loc_coord = 1_54_53_46_34) {
    mes("You climb down the southern tree.");
    p_teleport(0_54_53_46_34);
} else if (loc_coord = 1_54_53_46_39) {
    if (%routequest < ^route_bridge_fixed) {
        mes("The bridge must be repaired before crossing to the far side.");
        return;
    }
    mes("You climb down the northern tree.");
    p_teleport(0_54_53_46_39);
}

// Cache hollowtree_entrance loc 5045 has NO clickable options.
// The actual entrance doors at (3509..3510,3447) do: 5060 & 5061 = Open.
[oploc1,freedomfighterundergroundentrancel]
@route_open_hollowtree_doors;
[oploc1,freedomfighterundergroundentrancer]
@route_open_hollowtree_doors;

[label,route_open_hollowtree_doors]
if (%routequest < ^route_guard_passed) {
    mes("Curpile Fyod is watching. Ask his permission before entering.");
    return;
}
mes("You open the door and descend through the old hollow tree.");
def_coord $entrance = map_findsquare(0_54_153_36_32, 1, 4, ^map_findsquare_lineofwalk);
if ($entrance = null) {
    mes("You cannot find a safe foothold inside the tunnel.");
    return;
}
p_teleport($entrance);

// The real underground stalagmite at (3492,9824), plane 0,
// has option 1=Look and option TWO=Squeeze-past.
[oploc2,route_stalagmite_cave_entrace]
if (%routequest < ^route_guard_passed | stat_base(agility) < 25) {
    mes("You need Curpile's permission and 25 Agility to squeeze through.");
    return;
}
def_coord $hideout = map_findsquare(3_54_153_52_49, 1, 4, ^map_findsquare_lineofwalk);
if ($hideout = null) {
    mes("The narrow way is obstructed.");
    return;
}
mes("You squeeze between the rocks and find the Myreque hideout.");
p_teleport($hideout);

// Only the specific plane-3 cavewall on the Myreque's passage can return
// to the plane-0 main tunnel. Other locs of this type are unrelated.
[oploc1,route_cavewalltunnel]
if (loc_coord ! 3_54_153_49_39) {
    mes("This cave wall leads nowhere useful.");
    return;
}
if (%routequest < ^route_hideout) {
    mes("You need to meet the Myreque before using this tunnel.");
    return;
}
def_coord $tunnel = map_findsquare(0_54_153_49_39, 1, 4, ^map_findsquare_lineofwalk);
if ($tunnel = null) {
    mes("The tunnel is blocked.");
    return;
}
mes("You follow the dim passage towards the Canifis cellar.");
p_teleport($tunnel);

// Only the ACTUAL secret wall near Canifis basement (3480,9837)
// can open the exit. The 16 generic route_cavewalltunnel locs do NOT.
[oploc1,thrttavernbasementfalsewall]
if (%routequest < ^route_secret_exit) {
    mes("You cannot find the hidden passage here yet.");
    return;
}
if (%routequest = ^route_secret_exit) {
    %routequest = ^route_tunnel_open;
    mes("You find a concealed passage behind the stonework.");
}
def_coord $passage = map_findsquare(0_54_153_21_53, 1, 4, ^map_findsquare_lineofwalk);
if ($passage ! null) {
    p_teleport($passage);
}

[oploc1,thrttavernbasementladder]
if (%routequest < ^route_tunnel_open) {
    mes("You cannot leave this way before revealing the secret passage.");
    return;
}
def_coord $canifis = map_findsquare(0_54_54_38_8, 1, 4, ^map_findsquare_lineofwalk);
if ($canifis = null) {
    mes("The ladder's exit is obstructed; your quest progress is safe.");
    return;
}
mes("You climb out of the underground passage into Canifis.");
p_teleport($canifis);
if (%routequest = ^route_tunnel_open) %routequest = ^route_return;

// Real shortcut after completing the quest, never a pre-quest teleport gate.
[oploc1,thrt_tavern_trap_door]
if (%routequest ! ^route_complete) {
    mes("The trapdoor is locked. Finish In Search of the Myreque first.");
    return;
}
def_coord $basement = map_findsquare(0_54_153_21_53, 1, 4, ^map_findsquare_lineofwalk);
if ($basement ! null) {
    p_teleport($basement);
}
