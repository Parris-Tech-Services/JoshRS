// Rum Deal: NPC handlers. STATUS: scaffold; compiled against pinned disposable 377; full
// player playthrough unverified. Dialogue is original wording. Implemented: Pirate Pete
// start. Not implemented: the boat trip, Braindeath Island, Captain Braindeath, the
// brewery and the zombie protesters (see JOSHRS_QUESTBUNDLE2_NOTES.md).

// ---------------------------------------------------------------------------
// Pirate Pete (Port Phasmatys dock, main quest giver). Cache NPC deal_pete (id 2825).
// ---------------------------------------------------------------------------
[opnpc1,deal_pete]
switch_int(%deal_quest) {
    case ^deal_not_started : @deal_pete_not_started;
    case ^deal_started : @deal_pete_started;
    case default : @deal_pete_complete;
}

[label,deal_pete_not_started]
~chatnpc("<p,quiz>Oi! You look like you can keep yer mouth shut, matey.");
def_int $option = ~p_choice2("Depends who's asking.", 1, "I don't talk to pirates.", 2);
if($option = 2) {
    ~chatplayer("<p,neutral>I don't talk to pirates.");
    ~chatnpc("<p,neutral>Yer loss. There's good coin in it, there is.");
    return;
}
~chatplayer("<p,neutral>Depends who's asking.");
~chatnpc("<p,neutral>Name's Pete. I run errands fer a certain captain what brews a certain rum, an' he's in a spot o' bother.");
~chatnpc("<p,neutral>His crew's dead - proper dead, then un-proper - an' he needs hands that ain't attached to anythin' rotten.");
def_int $accept = ~p_choice2("I'll hear him out.", 1, "Sounds cursed. No.", 2);
if($accept = 2) {
    ~chatplayer("<p,neutral>Sounds cursed. No.");
    ~chatnpc("<p,neutral>Cursed it is! Smart lad. If ye change yer mind, I'll be here.");
    return;
}
~chatplayer("<p,happy>I'll hear him out.");
~chatnpc("<p,neutral>Grand! Hop in me boat an' mind the squid.");
%deal_quest = ^deal_started;
~send_quest_progress(questlist:deal, %deal_quest, ^deal_complete);
~mesbox("NOT YET IMPLEMENTED IN THIS WORLD: the boat trip to Braindeath Island, the brewery and the zombie protest.");

[label,deal_pete_started]
~chatnpc("<p,quiz>Still willin' to sail, matey?");
~chatplayer("<p,neutral>Still here, aren't I?");
~chatnpc("<p,neutral>That ye are. The captain's waitin' on his island, an' the dead are waitin' on him.");

[label,deal_pete_complete]
~chatnpc("<p,happy>The captain says ye did right by him! First round o' holy rum is on me, matey.");
