// Wanted!: NPC handlers. STATUS: scaffold; compiled against pinned disposable 377; full
// player playthrough unverified. Dialogue is original wording. Implemented: Sir Tiffy
// Cashien start. Not implemented: the commorb missions, Savant, the Black Knight Fortress
// hunt, Solus Dellagar (see JOSHRS_QUESTBUNDLE2_NOTES.md).

// ---------------------------------------------------------------------------
// Sir Tiffy Cashien (Falador Park, main quest giver). Cache NPC rd_teleporter_guy (id 2290).
// ---------------------------------------------------------------------------
[opnpc1,rd_teleporter_guy]
switch_int(%quest_wanted) {
    case ^wanted_not_started : @wanted_tiffy_not_started;
    case ^wanted_briefed : @wanted_tiffy_briefed;
    case ^wanted_hunt : @wanted_tiffy_hunt;
    case default : @wanted_tiffy_complete;
}

[label,wanted_tiffy_not_started]
~chatnpc("<p,happy>Top o' the mornin'! A fine day for the Knights of Falador, what?");
def_int $option = ~p_choice2("Do you have work for a Temple Knight?", 1, "Just enjoying the park.", 2);
if($option = 2) {
    ~chatplayer("<p,neutral>Just enjoying the park.");
    ~chatnpc("<p,happy>Jolly good! The pigeons keep a chap company.");
    return;
}
~chatplayer("<p,neutral>Do you have work for a Temple Knight?");
if(%recruitmentdrive ! ^rd_complete) {
    ~chatnpc("<p,quiz>Temple Knight, eh? Sir Amik's word carries weight, but I only field agents the order has fully accepted. Finish your recruitment first.");
    ~mesbox("You must have completed Recruitment Drive before Sir Tiffy will discuss this.");
    return;
}
~chatnpc("<p,neutral>As it happens, yes. A mage by the name of Solus Dellagar has slipped our net once too often.");
~chatnpc("<p,neutral>The order wants him found and stopped. It will take a sharp eye and a strong arm, no mistake.");
def_int $accept = ~p_choice2("I'll take the case.", 1, "Sounds too dangerous.", 2);
if($accept = 2) {
    ~chatplayer("<p,neutral>Sounds too dangerous.");
    ~chatnpc("<p,neutral>Quite all right. Safety first, what!");
    return;
}
~chatplayer("<p,happy>I'll take the case.");
%quest_wanted = ^wanted_briefed;
~send_quest_progress(questlist:wanted, %quest_wanted, ^wanted_complete);

[label,wanted_tiffy_briefed]
~chatnpc("<p,quiz>Ready for your orders, agent?");
~chatplayer("<p,neutral>Ready.");
~chatnpc("<p,neutral>The trail starts with the Black Knights' fortress north of Falador. Watch, listen, and report what you find.");
%quest_wanted = ^wanted_hunt;
~send_quest_progress(questlist:wanted, %quest_wanted, ^wanted_complete);
~mesbox("NOT YET IMPLEMENTED IN THIS WORLD: the commorb missions, the fortress search and the confrontation with Solus Dellagar.");

[label,wanted_tiffy_hunt]
~chatnpc("<p,neutral>Any trace of Dellagar? Keep at it, agent. The man is slippery as an eel.");

[label,wanted_tiffy_complete]
~chatnpc("<p,happy>Splendid work, agent! The order is in your debt. Do have a sit-down on this fine bench.");
