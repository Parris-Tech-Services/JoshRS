// Wanted! quest journal. STATUS: scaffold; compiled against pinned disposable 377; full
// player playthrough unverified. Wording is original.
[if_button,questlist:wanted]
def_string $text;

if(%quest_wanted = ^wanted_not_started) {
    $text = "@dbl@I can start this quest by speaking to @dre@Sir Tiffy Cashien@dbl@ in @dre@Falador Park@dbl@.||@dbl@I must have been accepted into the @dre@Temple Knights@dbl@, in @dre@Recruitment Drive@dbl@, and be able to hold my own in a fight.";
} else if(%quest_wanted = ^wanted_briefed) {
    $text = "@str@Sir Tiffy has briefed me: a dangerous mage is loose, and the Temple Knights want him found.||@dbl@I should ask him for my @dre@commorb@dbl@ orders and begin the hunt.||@red@NOT YET IMPLEMENTED IN THIS WORLD: the commorb and its missions.";
} else if(%quest_wanted = ^wanted_hunt) {
    $text = "@str@The hunt has taken me from @dre@Falador@dbl@ to the @dre@Black Knight Fortress@dbl@ and beyond.||@dbl@I must corner the mage @dre@Solus Dellagar@dbl@ and end his trail of destruction.||@red@NOT YET IMPLEMENTED IN THIS WORLD: the fortress search and the confrontation.";
} else {
    $text = "@str@I hunted down Solus Dellagar for the Temple Knights and earned a place among their field agents.||@red@QUEST COMPLETE!";
}

~quest_journal("Wanted!", $text);
