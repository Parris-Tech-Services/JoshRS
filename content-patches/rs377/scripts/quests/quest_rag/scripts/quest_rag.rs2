// Rag and Bone Man - structural implementation on top of the pinned 377 cache definitions.
// Every line of NPC dialogue below is PLACEHOLDER wording. UNVERIFIED: no 2006 source for the real text was found.
// See ../README.md for the full UNVERIFIED list.

[proc,rag_bone_delivered](int $i)(boolean)
if ($i < 32) {
    if (testbit(%rag_bones_a, $i) = ^true) {
        return(true);
    }
    return(false);
}
if (testbit(%rag_bones_b, calc($i - 32)) = ^true) {
    return(true);
}
return(false);

[proc,rag_mark_delivered](int $i)
if ($i < 32) {
    %rag_bones_a = setbit(%rag_bones_a, $i);
} else {
    %rag_bones_b = setbit(%rag_bones_b, calc($i - 32));
}

// The 2006 Rag and Bone Man quest asks for 8 bones; 27 more belong to its wish list.
[proc,rag_is_required_bone](int $i)(boolean)
if ($i >= 0 & $i <= 5) {
    return(true);
}
if ($i = 14 | $i = 32) {
    return(true);
}
return(false);

[proc,rag_delivered_count]()(int)
def_int $i = 0;
def_int $n = 0;
while ($i < ^rag_bone_catalog_total) {
    if (~rag_is_required_bone($i) = true & ~rag_bone_delivered($i) = true) {
        $n = calc($n + 1);
    }
    $i = calc($i + 1);
}
return($n);

[opnpc1,rag_odd_old_man]
switch_int (%rag_quest) {
    case ^rag_not_started :
        // UNVERIFIED: placeholder dialogue
        ~chatnpc("<p,neutral>Hello. I collect bones.|Would you like to help me?");
        def_int $option = ~p_choice2("Yes, I'll help.", 1, "No thanks.", 2);
        if ($option = 1) {
            ~chatplayer("<p,happy>Yes, I'll help.");
            ~chatnpc("<p,neutral>Bring me bones, cleaned in vinegar and polished.|Check my wish-list for what I need.");
            %rag_quest = ^rag_started;
            ~send_quest_progress(questlist:rag, %rag_quest, ^rag_complete);
        } else {
            ~chatplayer("<p,neutral>No thanks.");
        }
    case ^rag_started :
        @rag_turn_in;
    case ^rag_complete :
        if (%rag_bonesack = 0) {
            @rag_extra_turn_in;
        } else {
            ~chatnpc("<p,happy>You have finished both collections. Thank you.");
            @rag_exchange_reward;
        }
}

[label,rag_turn_in]
def_int $given = 0;
def_int $i = 0;
while ($i < ^rag_bone_catalog_total) {
    def_namedobj $polished = ~rag_polished_bone($i);
    if (~rag_is_required_bone($i) = true & ~rag_bone_delivered($i) = false & inv_total(inv, $polished) > 0) {
        inv_del(inv, $polished, 1);
        ~rag_mark_delivered($i);
        $given = calc($given + 1);
    }
    $i = calc($i + 1);
}
if ($given > 0) {
    ~mesbox("You hand over <tostring($given)> polished bone(s).");
}
if (~rag_delivered_count = ^rag_bone_total) {
    // UNVERIFIED: placeholder dialogue
    ~chatnpc("<p,happy>That is every bone I wanted. Thank you!");
    queue(rag_quest_complete, 0, 0);
} else {
    // UNVERIFIED: placeholder dialogue
    ~chatnpc("<p,neutral>I still need <tostring(calc(^rag_bone_total - ~rag_delivered_count))> more bone(s).|Check the wish-list.");
}

// The 27 extra bones are a separate 2006 wishlist, not additional prerequisites for the eight-bone main quest.
[proc,rag_extra_delivered_count]()(int)
def_int $i = 0;
def_int $n = 0;
while ($i < ^rag_bone_catalog_total) {
    if (~rag_is_required_bone($i) = false & ~rag_bone_delivered($i) = true) {
        $n = calc($n + 1);
    }
    $i = calc($i + 1);
}
return($n);

[label,rag_extra_turn_in]
def_int $i = 0;
def_int $given = 0;
while ($i < ^rag_bone_catalog_total) {
    if (~rag_is_required_bone($i) = false & ~rag_bone_delivered($i) = false) {
        def_namedobj $bone = ~rag_polished_bone($i);
        if (inv_total(inv, $bone) > 0) {
            inv_del(inv, $bone, 1);
            ~rag_mark_delivered($i);
            $given = calc($given + 1);
        }
    }
    $i = calc($i + 1);
}
if ($given > 0) {
    mes("You hand over <tostring($given)> more polished bones.");
}
if (~rag_extra_delivered_count < ^rag_extra_bone_total) {
    ~chatnpc("<p,neutral>I have recorded <tostring(~rag_extra_delivered_count)> of the 27 extra bones.|Please keep collecting the rest.");
    return;
}
if (%rag_bonesack = 1) {
    return;
}
~chatnpc("<p,happy>My extra collection is complete.|Choose a reward to carry as a reminder.");
if (inv_freespace(inv) < 1) {
    mes("Free one inventory slot and ask me again to collect your reward.");
    return;
}
def_int $chosen = ~p_choice2("A bonesack.", 1, "A ram skull helm.", 2);
if ($chosen = 1) {
    inv_add(inv, rag_bonesack, 1);
    %rag_helmet = 0;
} else {
    inv_add(inv, rag_ram_helm, 1);
    %rag_helmet = 1;
}
// Both flags live in the permanent rag_bone_2 varp. Award once per character.
%rag_bonesack = 1;
stat_advance(prayer, 50000);
~update_questpoints;
session_log(^log_adventure, "Completed Rag and Bone Man extra wish list");
mes("You completed the extra wish list and received 5,000 Prayer XP.");

[label,rag_exchange_reward]
def_int $choice = ~p_choice2("Exchange my reward.", 1, "Keep it.", 2);
if ($choice ! 1) {
    return;
}
if (%rag_helmet = 0) {
    if (inv_total(inv, rag_bonesack) < 1 | inv_total(inv, rag_ram_helm) > 0) {
        mes("Bring your existing bonesack to exchange; you cannot duplicate rewards.");
        return;
    }
    inv_del(inv, rag_bonesack, 1);
    inv_add(inv, rag_ram_helm, 1);
    %rag_helmet = 1;
} else {
    if (inv_total(inv, rag_ram_helm) < 1 | inv_total(inv, rag_bonesack) > 0) {
        mes("Bring your existing ram skull helm to exchange; you cannot duplicate rewards.");
        return;
    }
    inv_del(inv, rag_ram_helm, 1);
    inv_add(inv, rag_bonesack, 1);
    %rag_helmet = 0;
}
mes("You exchange your reward. The extra wish list stays complete.");

// UNVERIFIED: the real rewards. The cache holds a ram skull helm and a bonesack, but which are quest rewards is unconfirmed.
// QP value is also unverified.
[queue,rag_quest_complete]
if (%rag_quest ! ^rag_started | ~rag_delivered_count ! ^rag_bone_total) {
    return;
}
%rag_quest = ^rag_complete;
session_log(^log_adventure, "Quest complete: Rag and Bone Man");
~send_quest_complete(questlist:rag, rag_ram_helm, 200, ^rag_questpoints, "You have completed the Rag and Bone Man Quest!", "1 Quest Point");

[if_button,questlist:rag]
def_string $text;
if (%rag_quest = ^rag_not_started) {
    $text = "@dbl@I can start this quest by talking to the @dre@Odd Old Man@dbl@.";
} else if (%rag_quest = ^rag_started) {
    $text = "@str@I have spoken to the Odd Old Man.||@dbl@I need to bring him @dre@polished bones@dbl@.|";
    $text = append($text, "@dbl@I have delivered <tostring(~rag_delivered_count)> of <tostring(^rag_bone_total)> bones.");
} else {
    $text = "@str@I have spoken to the Odd Old Man.||@str@I brought him all eight required bones.|@red@QUEST COMPLETE!";
    if (%rag_bonesack = 1) {
        $text = append($text, "|@red@Extra wish list: COMPLETE!");
    } else {
        $text = append($text, "|@dbl@Extra wish list: <tostring(~rag_extra_delivered_count)> / 27 polished bones.");
    }
}
~quest_journal("Rag and Bone Man", $text);

// Wish-list loc (placeholder text).
[oploc1,rag_shopping_list]
// UNVERIFIED: placeholder text
if (%rag_quest ! ^rag_complete) {
    mes("The Odd Old Man needs eight polished bones for his first collection.");
    mes("The list names: goblin, bear, ram, unicorn, giant rat, giant bat, monkey and big frog.");
    mes("You have delivered <tostring(~rag_delivered_count)> of <tostring(^rag_bone_total)>.");
} else {
    mes("The extra wish list contains all 27 other bone types.");
    mes("You have delivered <tostring(~rag_extra_delivered_count)> of 27 extra bones.");
    if (%rag_bonesack = 1) {
        mes("You completed the extra wish list.");
    }
}
