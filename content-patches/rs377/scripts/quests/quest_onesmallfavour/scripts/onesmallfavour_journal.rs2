// One Small Favour quest journal. STATUS: scaffold; compiled against pinned disposable 377;
// full player playthrough unverified. Wording is original.
[if_button,questlist:onesmallfavour]
def_string $text;

if(%onesmallfavour = ^osf_not_started) {
    $text = "@dbl@I can start this quest by speaking to @dre@Yanni Salika@dbl@ in his antique shop in @dre@Shilo Village@dbl@.";
} else if(%onesmallfavour = ^osf_started) {
    $text = "@str@Yanni asked me for one small favour: a @dre@battered axe@dbl@ for his collection.||@dbl@One favour leads to another across @dre@Gielinor@dbl@ - each new friend needs something before they can help me.||@red@NOT YET IMPLEMENTED IN THIS WORLD: the chain of favours.";
} else {
    $text = "@str@After favours enough to fill a ledger, I brought Yanni his axe and earned a place in his story.||@red@QUEST COMPLETE!";
}

~quest_journal("One Small Favour", $text);
