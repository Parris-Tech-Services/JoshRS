// JoshRS revision-377 Mort'ton quest-only temple and funeral pyre interactions.
// MIT-inspired implementation based on LostCityRS/Content (274) gameplay contracts.
// Solo-safe five-repair threshold uses persistent bits in the EXISTING morttonmulti
// varp; this is not the original multiplayer temple-building minigame.
// No free quest flags, free items, or imaginary deaths.
//
// Five physical wall repairs require 20 Crafting and consume one real wood
// plank, limestone brick and five swamp paste each. Each grants 4 sanctity
// toward the 20 needed to bless oil. The permanent bits survive relogging.
[oploc1,templewall_base]
~mortton_repair_temple;

[oploc1,templewall_1]
~mortton_repair_temple;

[oploc1,templewall_2]
~mortton_repair_temple;

[oploc1,templewall_3]
~mortton_repair_temple;

[oploc1,templewall_4]
~mortton_repair_temple;

[oploc1,templewall_5]
~mortton_repair_temple;

[oploc1,templewall_6]
~mortton_repair_temple;

[oploc1,templewall_7]
~mortton_repair_temple;

[oploc1,templewall_8]
~mortton_repair_temple;

[oploc1,templewall_9]
~mortton_repair_temple;

[oploc1,templewall_10]
~mortton_repair_temple;

[oploc1,templewallcorner_base]
~mortton_repair_temple;

[oploc1,templewallcorner_1]
~mortton_repair_temple;

[oploc1,templewallcorner_2]
~mortton_repair_temple;

[oploc1,templewallcorner_3]
~mortton_repair_temple;

[oploc1,templewallcorner_4]
~mortton_repair_temple;

[oploc1,templewallcorner_5]
~mortton_repair_temple;

[oploc1,templewallcorner_6]
~mortton_repair_temple;

[oploc1,templewallcorner_7]
~mortton_repair_temple;

[oploc1,templewallcorner_8]
~mortton_repair_temple;

[oploc1,templewallcorner_9]
~mortton_repair_temple;

[oploc1,templewallcorner_10]
~mortton_repair_temple;

[proc,mortton_repair_temple]
if (%morttonquest < ^mortton_ulsquire_temple) {
    mes("Ask Ulsquire about the ruined temple first.");
    return;
}
if (stat(crafting) < 20) {
    mes("You need level 20 Crafting to repair the temple.");
    return;
}
if (inv_total(inv, hammer) < 1 & inv_total(inv, flamtaer_hammer) < 1) {
    mes("You need a hammer to repair the temple.");
    return;
}
if (%morttonquest >= ^mortton_can_light_altar) {
    mes("You have already restored enough of the temple to sanctify the altar.");
    return;
}
if (inv_total(inv, woodplank) < 1 | inv_total(inv, limestonebrick) < 1 | inv_total(inv, swamppaste) < 5) {
    mes("Each repair needs a wood plank, a limestone brick and five swamp paste.");
    return;
}
inv_del(inv, woodplank, 1);
inv_del(inv, limestonebrick, 1);
inv_del(inv, swamppaste, 5);
stat_advance(crafting, 50);
if (testbit(%morttonmulti, ^mortton_repair_one) = ^false) {
    %morttonmulti = setbit(%morttonmulti, ^mortton_repair_one);
} else if (testbit(%morttonmulti, ^mortton_repair_two) = ^false) {
    %morttonmulti = setbit(%morttonmulti, ^mortton_repair_two);
} else if (testbit(%morttonmulti, ^mortton_repair_three) = ^false) {
    %morttonmulti = setbit(%morttonmulti, ^mortton_repair_three);
} else if (testbit(%morttonmulti, ^mortton_repair_four) = ^false) {
    %morttonmulti = setbit(%morttonmulti, ^mortton_repair_four);
} else {
    %morttonmulti = setbit(%morttonmulti, ^mortton_repair_five);
}
if (%morttonquest = ^mortton_ulsquire_temple) {
    %morttonquest = ^mortton_rebuild_temple;
}
if (loc_type = templewall_base) {
    loc_change(templewall_1, 9000);
} else if (loc_type = templewall_1) {
    loc_change(templewall_2, 9000);
} else if (loc_type = templewall_2) {
    loc_change(templewall_3, 9000);
} else if (loc_type = templewall_3) {
    loc_change(templewall_4, 9000);
} else if (loc_type = templewall_4) {
    loc_change(templewall_5, 9000);
} else if (loc_type = templewallcorner_base) {
    loc_change(templewallcorner_1, 9000);
} else if (loc_type = templewallcorner_1) {
    loc_change(templewallcorner_2, 9000);
} else if (loc_type = templewallcorner_2) {
    loc_change(templewallcorner_3, 9000);
} else if (loc_type = templewallcorner_3) {
    loc_change(templewallcorner_4, 9000);
} else if (loc_type = templewallcorner_4) {
    loc_change(templewallcorner_5, 9000);
}
if (testbit(%morttonmulti, ^mortton_repair_five) = ^true) {
    %morttonquest = ^mortton_can_light_altar;
    if (loc_find(^mortton_temple_altar_coord, templefire_altar_nofire_broken) = ^true) {
        loc_change(templefire_altar_nofire, 9000);
    }
    mes("The temple stands restored! Its altar can now be lit.");
} else {
    mes("You repair part of the wall and gain sanctity. Keep rebuilding.");
}
~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_quest_complete);

// The original 377 map has a ruined (non-clickable) altar at 0_54_51_50_52.
// Repairing it above morphs it to this existing clickable altar type.
[oploc1,templefire_altar_nofire]
if (%morttonquest < ^mortton_can_light_altar) {
    mes("The altar cannot be lit until you restore the temple.");
    return;
}
if (stat(firemaking) < 5) {
    mes("You need level 5 Firemaking to light the altar.");
    return;
}
if (inv_total(inv, tinderbox) < 1) {
    mes("You need a tinderbox to light this altar.");
    return;
}
loc_change(templefire_altar, 9000);
mes("The flame burns brightly. Olive oil can now be made sacred.");

// Bless olive oil, and optionally make permanent serum 208. Authentic items,
// paid building supplies and ordinary Firemaking are required; none spawned.
[oplocu,templefire_altar]
if (%morttonquest < ^mortton_can_light_altar) {
    mes("You must help restore the temple first.");
    return;
}
if (last_useitem = oliveoil4 | last_useitem = oliveoil3 | last_useitem = oliveoil2 | last_useitem = oliveoil1) {
    if (inv_total(inv, last_useitem) < 1) {
        return;
    }
    inv_del(inv, last_useitem, 1);
    if (last_useitem = oliveoil4) {
        inv_add(inv, sacred_oil4, 1);
    } else if (last_useitem = oliveoil3) {
        inv_add(inv, sacred_oil3, 1);
    } else if (last_useitem = oliveoil2) {
        inv_add(inv, sacred_oil2, 1);
    } else {
        inv_add(inv, sacred_oil1, 1);
    }
    if (%morttonquest < ^mortton_created_sacred_oil) {
        %morttonquest = ^mortton_created_sacred_oil;
        ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_quest_complete);
    }
    mes("The sacred flame blesses the oil.");
    return;
}
if (last_useitem = mort_serum3 | last_useitem = mort_serum2 | last_useitem = mort_serum1) {
    if (inv_total(inv, last_useitem) < 1) {
        return;
    }
    inv_del(inv, last_useitem, 1);
    if (last_useitem = mort_serum3) {
        inv_add(inv, mort_serum_perm3, 1);
    } else if (last_useitem = mort_serum2) {
        inv_add(inv, mort_serum_perm2, 1);
    } else {
        inv_add(inv, mort_serum_perm1, 1);
    }
    mes("The flame strengthens the serum into Serum 208.");
    return;
}
~displaymessage(^dm_default);

// Sacred oil needs two doses to bless an ordinary log.
[opheldu,logs]
if (last_useitem = sacred_oil4 | last_useitem = sacred_oil3 | last_useitem = sacred_oil2 | last_useitem = sacred_oil1) {
    ~mortton_make_pyre_logs;
} else {
    ~displaymessage(^dm_default);
}

[opheldu,sacred_oil4]
if (last_useitem = logs) {
    ~mortton_make_pyre_logs;
} else {
    ~displaymessage(^dm_default);
}

[opheldu,sacred_oil3]
if (last_useitem = logs) {
    ~mortton_make_pyre_logs;
} else {
    ~displaymessage(^dm_default);
}

[opheldu,sacred_oil2]
if (last_useitem = logs) {
    ~mortton_make_pyre_logs;
} else {
    ~displaymessage(^dm_default);
}

[proc,mortton_make_pyre_logs]
if (%morttonquest < ^mortton_created_sacred_oil) {
    mes("First bless your own olive oil in the temple flame.");
    return;
}
if (inv_total(inv, logs) < 1) {
    mes("You need ordinary logs to make pyre logs.");
    return;
}
if (inv_total(inv, sacred_oil4) > 0) {
    inv_del(inv, sacred_oil4, 1);
    inv_add(inv, sacred_oil2, 1);
} else if (inv_total(inv, sacred_oil3) > 0) {
    inv_del(inv, sacred_oil3, 1);
    inv_add(inv, sacred_oil1, 1);
} else if (inv_total(inv, sacred_oil2) > 0) {
    inv_del(inv, sacred_oil2, 1);
    inv_add(inv, vial_empty, 1);
} else {
    mes("You need at least two doses of sacred oil for an ordinary log.");
    return;
}
inv_del(inv, logs, 1);
inv_add(inv, logs_pyre, 1);
if (%morttonquest < ^mortton_created_pyre_logs) {
    %morttonquest = ^mortton_created_pyre_logs;
    ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_quest_complete);
}
mes("You soak the logs in sacred oil to prepare funeral pyre logs.");

// Stage-gated physical funeral pyre: logs -> remains -> fire -> Ulsquire.
[oplocu,temple_pyre]
if (last_useitem ! logs_pyre) {
    ~displaymessage(^dm_default);
    return;
}
if (%morttonquest < ^mortton_created_pyre_logs) {
    mes("Make pyre logs with sacred oil before starting a funeral.");
    return;
}
if (inv_total(inv, logs_pyre) < 1) {
    return;
}
inv_del(inv, logs_pyre, 1);
loc_change(temple_pyre_logs, 9000);
if (%morttonquest < ^mortton_logs_on_pyre) {
    %morttonquest = ^mortton_logs_on_pyre;
    ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_quest_complete);
}
mes("You place the sacred logs on the funeral pyre.");

[oplocu,temple_pyre_logs]
if (last_useitem ! shade_bones1) {
    ~displaymessage(^dm_default);
    return;
}
if (%morttonquest < ^mortton_logs_on_pyre | inv_total(inv, shade_bones1) < 1) {
    mes("You need Loar remains from a genuine shade kill.");
    return;
}
inv_del(inv, shade_bones1, 1);
loc_change(temple_pyre_bones_logs, 9000);
mes("You place the Loar shade's remains on the pyre.");

[oploc1,temple_pyre_bones_logs]
if (%morttonquest < ^mortton_logs_on_pyre) {
    mes("You need to prepare the pyre with sacred logs first.");
    return;
}
if (stat(firemaking) < 5) {
    mes("You need level 5 Firemaking to cremate a Loar shade.");
    return;
}
if (inv_total(inv, tinderbox) < 1) {
    mes("You need a tinderbox to light the pyre.");
    return;
}
if (inv_freespace(inv) < 1) {
    mes("Make room to collect the shade's gift before lighting the pyre.");
    return;
}
loc_change(temple_pyre, 9000);
if (%morttonquest < ^mortton_lit_pyre) {
    stat_advance(prayer, 250);
    inv_add(inv, shadekey_bronze_bloodred, 1);
    %morttonquest = ^mortton_lit_pyre;
    ~send_quest_progress(questlist:mortton, %morttonquest, ^mortton_quest_complete);
    mes("The shade's spirit is freed. You find a bronze shade key.");
    mes("Tell Ulsquire what you have accomplished.");
} else {
    mes("The spirit rises from the funeral pyre.");
}
