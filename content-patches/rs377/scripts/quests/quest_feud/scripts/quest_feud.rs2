// The Feud - JoshRS original chain on 377 cache items/NPCs (camel receipt, mayor's house keys,
// mayor's jewels, desert disguise; NPCs Ali M, the bandit boss, Ali the barman's kebab seller,
// Ali the discount camel seller, the cowardly guard).
// Original JoshRS content. Persistence: add scope=perm to cache varp main_feud_var (patch 0009).
// NOT IMPLEMENTED: the Pollnivneach murder-mystery framing, Ali the Mayor's scenes, and the
// camel Ali; the chain here is a condensed reconstruction. Rewards: 1,500 Thieving XP.

// Ali M - start NPC, Al Kharid north of the palace.
[opnpc1,feud_ali_m]
switch_int (%main_feud_var) {
    case ^feud_not_started :
        ~chatnpc("<p,sad>My poor wife! Dead, and the bandits of the desert camp|did it, I know it. The guards do nothing. Will you go to|the bandit camp and find the truth of it?");
        def_int $option = ~p_choice2("I'll find your wife's killers.", 1, "Sounds dangerous. No.", 2);
        if ($option = 1) {
            ~chatplayer("<p,neutral>I'll find out what the bandits know.");
            %main_feud_var = ^feud_started;
            ~send_quest_progress(questlist:feud, %main_feud_var, ^feud_complete);
        }
    case ^feud_started :
    case ^feud_disguise :
    case ^feud_jewels :
        ~chatnpc("<p,sad>The bandit camp, south-west past the Shantay Pass.|Be careful - they are not forgiving folk.");
    case ^feud_report :
        ~chatnpc("<p,neutral>So the bandits deny it... and point at my own household.|The desert keeps its secrets, but at least I know the camp|did not do it. Take this, and my thanks.");
        queue(feud_quest_complete, 0, 0);
    case default :
        ~chatnpc("<p,neutral>Peace be on you. My wife rests, and the bandits keep|their distance from my house now.");
}

// Bandit boss - wants proof of loyalty before talking: the mayor's jewels.
[opnpc1,feud_bandit_boss]
switch_int (%main_feud_var) {
    case ^feud_started :
        ~chatnpc("<p,neutral>An outsider asking about a murder? Ha! Words are wind.|You want in with us, you bring me the mayor's jewels from|his house in Pollnivneach. A beard and a turban help a|stranger not be a stranger - the kebab seller trades in|such things.");
        %main_feud_var = ^feud_disguise;
    case ^feud_disguise :
        ~chatnpc("<p,neutral>Jewels. The mayor's. Until then, we never spoke.");
    case ^feud_jewels :
        if (inv_total(inv, feud_mayors_jewels) > 0) {
            ~chatnpc("<p,laugh>Well now! You ARE useful. The mayor's own jewels!|About your murder, little word: none of mine did it.|Ali M's own household had hands in it, if you ask me.|Now clear off before the camp wakes.");
            inv_del(inv, feud_mayors_jewels, 1);
            %main_feud_var = ^feud_report;
        } else {
            ~chatnpc("<p,neutral>Empty hands get empty answers.");
        }
    case ^feud_report :
        ~chatnpc("<p,neutral>You have your answer. Go tell the widower.");
    case default :
        ~chatnpc("<p,neutral>The camp is closed to strangers. Mostly.");
}

// Ali the kebab seller - trades the desert disguise for a camel receipt, sells kebabs for 3 coins.
[opnpc1,feud_bjseller]
if (%main_feud_var = ^feud_disguise & inv_total(inv, feud_karidian_fakebeard_and_hat) = 0 & inv_total(inv, feud_desert_disguise) = 0) {
    if (inv_total(inv, feud_camel_receipt) > 0) {
        ~chatnpc("<p,neutral>A camel receipt? For that I can part with a fine|Karidian false beard and hat. Blend right in, you will.|Kebab with it? On the house.");
        inv_del(inv, feud_camel_receipt, 1);
        inv_add(inv, feud_karidian_fakebeard_and_hat, 1);
    } else {
        ~chatnpc("<p,neutral>Disguises cost a camel receipt - the discount camel|seller writes them. Kebabs are three coins, if you're|hungry now.");
    }
} else if (%main_feud_var = ^feud_disguise) {
    ~chatnpc("<p,neutral>Looking properly Karidian now! Kebab? Three coins.");
} else {
    ~chatnpc("<p,neutral>Kebabs! Finest in the desert! Three coins!");
}

// Buy a kebab from the kebab seller (3 coins).
[queue,feud_buy_kebab]
if (inv_total(inv, coins) >= 3) {
    inv_del(inv, coins, 3);
    inv_add(inv, kebab, 1);
    mes("You buy a kebab. It smells... authentic.");
} else {
    mes("You need 3 coins for a kebab.");
}

[opnpc2,feud_bjseller]
queue(feud_buy_kebab, 0, 0);

// Ali the discount camel seller - writes a camel receipt for free.
[opnpc1,feud_ali_the_discount_camel_seller]
if (%main_feud_var = ^feud_disguise) {
    ~chatnpc("<p,neutral>A receipt for a camel you have not bought? It is a|desert tradition. Here - signed and worthless, exactly|as intended.");
    inv_add(inv, feud_camel_receipt, 1);
} else {
    ~chatnpc("<p,neutral>Camels! Discount! Slightly!");
}

// Cowardly guard at the mayor's house - trades the house keys for a kebab.
[opnpc1,feud_arabian_guard_coward]
if (%main_feud_var = ^feud_disguise) {
    if (inv_total(inv, kebab) > 0) {
        ~chatnpc("<p,scared>You didn't see me, I didn't see you - is that a kebab?|The mayor's out, the keys are under the mat, and my|stomach is empty. Trade you, keys for kebab.");
        inv_del(inv, kebab, 1);
        inv_add(inv, feud_mayors_house_keys, 1);
    } else {
        ~chatnpc("<p,scared>I saw nothing! Nothing at all! ...unless you happen|to have a kebab about you. Then we can talk.");
    }
} else {
    ~chatnpc("<p,scared>Move along! This is the mayor's house! Officially guarded!");
}

// Mayor's house keys - open the jewel case.
[opheld1,feud_mayors_house_keys]
if (%main_feud_var = ^feud_disguise) {
    if (inv_total(inv, feud_karidian_fakebeard_and_hat) > 0 | inv_total(inv, feud_desert_disguise) > 0) {
        mes("You slip inside the mayor's house and open the jewel case.");
        inv_del(inv, feud_mayors_house_keys, 1);
        inv_add(inv, feud_mayors_jewels, 1);
        %main_feud_var = ^feud_jewels;
    } else {
        mes("I should wear a disguise before sneaking in.");
    }
} else {
    mes("A ring of keys stamped 'Mayor'.");
}

[queue,feud_quest_complete]
%main_feud_var = ^feud_complete;
stat_advance(thieving, 15000);
session_log(^log_adventure, "Quest complete: The Feud");
~send_quest_complete(questlist:feud, feud_mayors_jewels, 200, ^feud_questpoints, "You have completed The Feud!", "1,500 Thieving XP");

[if_button,questlist:feud]
def_string $text;
switch_int (%main_feud_var) {
    case ^feud_not_started : $text = "@dbl@I can start this quest by speaking to @dre@Ali M@dbl@ in Al Kharid, north of the palace.";
    case ^feud_started : $text = "@str@Ali M blames the bandits for his wife's death.||@dbl@I should speak to the @dre@bandit boss@dbl@ in the desert bandit camp.";
    case ^feud_disguise : $text = "@str@The bandit boss wants the mayor's jewels as proof of loyalty.||@dbl@I need a @dre@disguise@dbl@ from the kebab seller (he wants a camel receipt from the discount camel seller) and the @dre@house keys@dbl@ from the cowardly guard (for a kebab).";
    case ^feud_jewels : $text = "@str@I have the mayor's jewels.||@dbl@I should bring them to the @dre@bandit boss@dbl@.";
    case ^feud_report : $text = "@str@The bandits deny the murder - and point at Ali M's own household.||@dbl@I should bring the truth back to @dre@Ali M@dbl@.";
    case default : $text = "@str@The feud is settled, after a fashion.||@red@QUEST COMPLETE!";
}
~quest_journal("The Feud", $text);
