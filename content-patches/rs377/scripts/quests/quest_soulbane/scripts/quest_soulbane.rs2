// A Soul's Bane - JoshRS original dialogue and stage logic on top of the 377 cache definitions.
// Dialogue, rewards and stage values are original JoshRS content (not copied from the 2006 game).

[opnpc1,soulbane_launa]
@soulbane_talk_launa;

[opnpc1,soulbane_launa_young]
@soulbane_talk_launa;

[opnpc1,soulbane_tolna_multi]
@soulbane_talk_tolna;

[opnpc1,soulbane_tolna_top]
@soulbane_talk_tolna;

[opnpc1,soulbane_brana]
~chatnpc("<p,neutral>Old houses hold old tempers.|Mind your step in there.");

[label,soulbane_talk_launa]
switch_int (%soulbane_prog) {
    case ^soulbane_not_started :
        ~chatnpc("<p,sad>My son Tolna disappeared into a strange rift 25 years ago.|Even his father Brana went searching and never returned.");
        def_int $o = ~p_choice2("I'll try to help.", 1, "That's not my problem.", 2);
        if ($o = 1) {
            ~chatplayer("<p,neutral>I'll try to help.");
            ~chatnpc("<p,neutral>The rift seems to hold anger, fear, confusion and hopelessness.|Please find Tolna, and bring him home.");
            %soulbane_prog = ^soulbane_started;
            ~send_quest_progress(questlist:soulbane, %soulbane_prog, ^soulbane_complete);
        } else {
            ~chatplayer("<p,neutral>That's not my problem.");
            ~chatnpc("<p,sad>Then I will wait a while longer.");
        }
    case ^soulbane_started, ^soulbane_anger, ^soulbane_fear, ^soulbane_confusion, ^soulbane_hope, ^soulbane_final :
        ~chatnpc("<p,neutral>Find your way through the rift, facing anger, fear, confusion and hopelessness.");
    case ^soulbane_return :
        ~chatnpc("<p,happy>It is quiet at last. Thank you.|Speak to Tolna when he comes back to the surface.");
    case ^soulbane_complete :
        ~chatnpc("<p,happy>My son and his father have returned. Thank you for helping us.");
}

[label,soulbane_talk_tolna]
switch_int (%soulbane_prog) {
    case ^soulbane_not_started :
        ~chatnpc("<p,angry>Please leave me alone. I don't want to talk.");
    case ^soulbane_started, ^soulbane_anger, ^soulbane_fear, ^soulbane_confusion, ^soulbane_hope, ^soulbane_final :
        ~chatnpc("<p,neutral>I cannot hear you properly while I am lost in the rift.");
    case ^soulbane_return :
        ~chatnpc("<p,happy>You helped me escape that terrible place. Thank you.");
        queue(soulbane_quest_complete, 0, 0);
    case ^soulbane_complete :
        ~chatnpc("<p,happy>Mother and I are together again. Thank you for helping us.");
}

[queue,soulbane_quest_complete]
if (%soulbane_prog ! ^soulbane_return) {
    return;
}
// Historical 2006/OSRS quest rewards: 500 Defence XP, 500 Hitpoints XP,
// 500 coins, 1 QP and Tolna's rift access. Prevent an unrecoverable
// completion if the coins cannot be delivered into a full inventory.
if (inv_total(inv, coins) < 1 & inv_freespace(inv) < 1) {
    mes("Make an empty inventory space to receive your reward.");
    return;
}
%soulbane_prog = ^soulbane_complete;
stat_advance(defence, 5000);
stat_advance(hitpoints, 5000);
inv_add(inv, coins, 500);
session_log(^log_adventure, "Quest complete: A Soul's Bane");
~send_quest_complete(questlist:soulbane, coins, 200, ^soulbane_questpoints, "You have completed A Soul's Bane!", "500 Defence XP|500 Hitpoints XP|500 coins");

// Trial 1 kills run through a queue so they execute in player context.
[queue,soulbane_anger_kill](int $bit)
if (%soulbane_prog = ^soulbane_anger) {
    %soulbane_mask = setbit(%soulbane_mask, $bit);
    if (testbit(%soulbane_mask, 0) = ^true & testbit(%soulbane_mask, 1) = ^true & testbit(%soulbane_mask, 2) = ^true & testbit(%soulbane_mask, 3) = ^true) {
        %soulbane_prog = ^soulbane_fear;
        mes("The anger in the air fades. A chill takes its place.");
    }
}

[ai_queue3,soulbane_anger_bear]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_anger_kill, 0, 0);
}

[ai_queue3,soulbane_anger_unicorn]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_anger_kill, 0, 1);
}

[ai_queue3,soulbane_anger_rat]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_anger_kill, 0, 2);
}

[ai_queue3,soulbane_anger_goblin]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_anger_kill, 0, 3);
}

// Historical fear trial requires five fear reaper defeats, not three.
[ai_queue3,soulbane_fear_reaper]
gosub(npc_death);
if (npc_findhero = ^true) {
    if (%soulbane_prog = ^soulbane_fear) {
        queue(soulbane_fear_kill, 0, 0);
    }
}

[queue,soulbane_fear_kill]
%soulbane_fear_killedtally = calc(%soulbane_fear_killedtally + 1);
if (%soulbane_fear_killedtally >= ^soulbane_fear_needed) {
    %soulbane_prog = ^soulbane_confusion;
    mes("The fear lifts, but your thoughts feel muddled.");
}

// In the historical confusion room, numerous illusory beasts must disappear
// before the actual creature/last doorway can be solved. This overlay
// currently models only the real creature death: HISTORICAL-PARITY-GAP.
[ai_queue3,soulbane_confu_creeper]
gosub(npc_death);
if (npc_findhero = ^true) {
    if (%soulbane_prog = ^soulbane_confusion) {
        queue(soulbane_confu_kill, 0, 0);
    }
}

[queue,soulbane_confu_kill]
// The genuine puzzle contains five successive real beasts, each clearing
// exactly one misleading door. Do not award passage after one kill.
if (%soulbane_prog ! ^soulbane_confusion) {
    return;
}
if (%soulbane_confu_door1pres = 0) {
    %soulbane_confu_door1pres = 1;
    mes("One of the confusing doors fades away. Four remain.");
    return;
}
if (%soulbane_confu_door2pres = 0) {
    %soulbane_confu_door2pres = 1;
    mes("Another false doorway disappears.");
    return;
}
if (%soulbane_confu_door3pres = 0) {
    %soulbane_confu_door3pres = 1;
    mes("A third confusing door vanishes.");
    return;
}
if (%soulbane_confu_door4pres = 0) {
    %soulbane_confu_door4pres = 1;
    mes("Only one more false door remains.");
    return;
}
if (%soulbane_confu_door5pres = 0) {
    %soulbane_confu_door5pres = 1;
    %soulbane_confu_door6open = 1;
    %soulbane_prog = ^soulbane_hope;
    mes("The real creature falls for the fifth time. The way ahead clears.");
}

// Hopelessness: original task requires five creatures to be defeated through three phases each (15 phase defeats).
[queue,soulbane_hope_kill]
if (%soulbane_prog = ^soulbane_hope) {
    // Four bits are reserved in the original 377 packed varp (0..15).
    // Never overflow that field or turn repeat deaths into extra progress.
    if (%soulbane_hope_killedtally >= ^soulbane_hope_needed) {
        return;
    }
    %soulbane_hope_killedtally = calc(%soulbane_hope_killedtally + 1);
    if (%soulbane_hope_killedtally >= ^soulbane_hope_needed) {
        %soulbane_hope_bridgepres = 1;
        %soulbane_prog = ^soulbane_final;
        mes("A strange warmth fills the room. One more thing remains.");
    }
}

[ai_queue3,soulbane_hope_monst1]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_hope_kill, 0, 0);
}

[ai_queue3,soulbane_hope_monst2]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_hope_kill, 0, 0);
}

[ai_queue3,soulbane_hope_monst3]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_hope_kill, 0, 0);
}

// Final: the three shades of Tolna. Death flags are written in a
// player-context queue; the last kill completes the trial.
[queue,soulbane_tolna_dead](int $which)
if ($which = 1) { %soulbane_final_tol1dead = 1; }
if ($which = 2) { %soulbane_final_tol2dead = 1; }
if ($which = 3) { %soulbane_final_tol3dead = 1; }
if (%soulbane_prog = ^soulbane_final) {
    if (%soulbane_final_tol1dead = 1 & %soulbane_final_tol2dead = 1 & %soulbane_final_tol3dead = 1) {
        %soulbane_prog = ^soulbane_return;
        mes("The last shade fades. It is finally quiet.");
    }
}

[ai_queue3,soulbane_final_tolna1]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_tolna_dead, 0, 1);
}

[ai_queue3,soulbane_final_tolna2]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_tolna_dead, 0, 2);
}

[ai_queue3,soulbane_final_tolna3]
gosub(npc_death);
if (npc_findhero = ^true) {
    queue(soulbane_tolna_dead, 0, 3);
}

[if_button,questlist:soulbane]
def_string $text;
switch_int (%soulbane_prog) {
    case ^soulbane_not_started : $text = "@dbl@I can start this quest by talking to @dre@Launa@dbl@ at the rift east of @dre@Varrock@dbl@.";
    case ^soulbane_started : $text = "@str@I spoke to Launa.||@dbl@I must face four trials within the rift. First, @dre@anger@dbl@.";
    case ^soulbane_anger : $text = "@str@I spoke to Launa.||@dbl@I must defeat the four @dre@anger@dbl@ monsters.";
    case ^soulbane_fear : $text = "@str@I defeated the anger monsters.||@dbl@Next I must defeat five @dre@fear reapers@dbl@.";
    case ^soulbane_confusion : $text = "@str@I defeated the fear reapers.||@dbl@Now I must find the real @dre@confusion beast@dbl@.";
    case ^soulbane_hope : $text = "@str@I escaped confusion.||@dbl@I must face the creatures of @dre@hopelessness@dbl@.";
    case ^soulbane_final : $text = "@str@I defeated the hopeless creatures.||@dbl@Only the three @dre@shades of Tolna@dbl@ remain.";
    case ^soulbane_return : $text = "@str@I defeated every shade.||@dbl@I should tell @dre@Tolna@dbl@ that it is done.";
    case default : $text = "@str@I faced all four trials and the shades of Tolna.||@red@QUEST COMPLETE!";
}
~quest_journal("A Soul's Bane", $text);
