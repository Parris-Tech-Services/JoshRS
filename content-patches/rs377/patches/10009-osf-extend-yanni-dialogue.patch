 [opnpc1,shiloantiques]
+// JoshRS questbundle2: One Small Favour branch (Yanni is the quest giver). Constants live in
+// quest_onesmallfavour/configs. STATUS: scaffold; full player playthrough unverified.
+if(%onesmallfavour = ^osf_not_started) {
+    ~chatplayer("<p,neutral>Hello there!");
+    ~chatnpc("<p,neutral>Greetings Bwana!|Say - you get around, don't you? A collector's eye like mine spots a useful sort straight away.");
+    def_int $osf = ~p_choice2("What do you need?", 1, "Just browsing your wares.", 2);
+    if($osf = 1) {
+        ~chatplayer("<p,quiz>What do you need?");
+        ~chatnpc("<p,neutral>One small favour, Bwana! There is a battered old axe I have chased for years. Bring it to me and I will remember you fondly.");
+        ~chatnpc("<p,neutral>Finding it will mean asking favours of half of Gielinor, I warn you.");
+        def_int $osf2 = ~p_choice2("I'll ask around.", 1, "Too much running about.", 2);
+        if($osf2 = 1) {
+            ~chatplayer("<p,happy>I'll ask around.");
+            %onesmallfavour = ^osf_started;
+            ~send_quest_progress(questlist:onesmallfavour, %onesmallfavour, ^osf_complete);
+            ~mesbox("NOT YET IMPLEMENTED IN THIS WORLD: the chain of favours across Gielinor.");
+            return;
+        }
+        ~chatplayer("<p,neutral>Too much running about.");
+        ~chatnpc("<p,neutral>I understand, Bwana. The offer stands.");
+    } else {
+        ~chatplayer("<p,neutral>Just browsing your wares.");
+        ~chatnpc("<p,neutral>Then browse away! Everything has a story, and most have a price.");
+    }
+    return;
+} else if(%onesmallfavour = ^osf_started) {
+    ~chatplayer("<p,neutral>Hello there!");
+    ~chatnpc("<p,neutral>Bwana! Any luck with my axe? One favour at a time, that's all I ask.");
+    return;
+} else if(%onesmallfavour = ^osf_complete) {
+    ~chatplayer("<p,neutral>Hello there!");
+    ~chatnpc("<p,happy>Bwana! The axe sits proud in my collection, and your name sits proud in my story!");
+    return;
+}
 ~chatplayer("<p,neutral>Hello there!");
 // https://web.archive.org/web/20050204071450im_/http://www.runehq.com//images/cityguides/shilo9.jpg
 ~chatnpc("<p,neutral>Greetings Bwana!|My name is Yanni and I buy and sell antiques|and other interesting items.|If you have any interesting items that you might");
