diff --git a/scripts/quests/quest_legends/scripts/legends_lamp.rs2 b/scripts/quests/quest_legends/scripts/legends_lamp.rs2
new file mode 100644
index 0000000..3e262f1
--- /dev/null
+++ b/scripts/quests/quest_legends/scripts/legends_lamp.rs2
@@ -0,0 +1,71 @@
+// Legends' Quest reward lamps.
+//
+// The reward is 7,650 experience in each of four skills of the player's choice, and the same
+// skill may be chosen more than once. The 7,650 figure comes from the wiki's change history:
+// the reward was raised to 30,000 only on 30 November 2022, so any pre-2022 reconstruction
+// must use 7,650. stat_advance takes tenths, so 7,650 XP is written 76500.
+//
+// The allowed skills are exactly these twelve. Ranged, Fishing, Cooking, Firemaking, Fletching,
+// Runecraft, Slayer, Farming, Construction, Hunter and Summoning are refused.
+
+[opheld1,legends_lamp]
+%legendslamp = 0;
+if_openmain(legends_lamp);
+
+[if_button,legends_lamp:close] if_close;
+
+[if_button,legends_lamp:confirm]
+if (%legendslamp = 0) {
+    mes("You need to choose which skill you wish to be advanced.");
+    return;
+}
+switch_int (%legendslamp) {
+    case 1  : @legends_lamp_grant(attack);
+    case 2  : @legends_lamp_grant(defence);
+    case 3  : @legends_lamp_grant(strength);
+    case 4  : @legends_lamp_grant(hitpoints);
+    case 5  : @legends_lamp_grant(prayer);
+    case 6  : @legends_lamp_grant(magic);
+    case 7  : @legends_lamp_grant(woodcutting);
+    case 8  : @legends_lamp_grant(crafting);
+    case 9  : @legends_lamp_grant(smithing);
+    case 10 : @legends_lamp_grant(herblore);
+    case 11 : @legends_lamp_grant(agility);
+    case 12 : @legends_lamp_grant(thieving);
+    case default : mes("You need to choose which skill you wish to be advanced.");
+}
+
+[if_button,legends_lamp:attack] %legendslamp = 1;
+[if_button,legends_lamp:defence] %legendslamp = 2;
+[if_button,legends_lamp:strength] %legendslamp = 3;
+[if_button,legends_lamp:hitpoints] %legendslamp = 4;
+[if_button,legends_lamp:prayer] %legendslamp = 5;
+[if_button,legends_lamp:magic] %legendslamp = 6;
+[if_button,legends_lamp:woodcutting] %legendslamp = 7;
+[if_button,legends_lamp:crafting] %legendslamp = 8;
+[if_button,legends_lamp:smithing] %legendslamp = 9;
+[if_button,legends_lamp:herblore] %legendslamp = 10;
+[if_button,legends_lamp:agility] %legendslamp = 11;
+[if_button,legends_lamp:thieving] %legendslamp = 12;
+
+// Skills the original reward does not allow. Selecting one refuses rather than silently doing
+// nothing, so the player is never left guessing why the confirm button had no effect.
+[if_button,legends_lamp:ranged]     @legends_lamp_refuse;
+[if_button,legends_lamp:fishing]    @legends_lamp_refuse;
+[if_button,legends_lamp:cooking]    @legends_lamp_refuse;
+[if_button,legends_lamp:firemaking] @legends_lamp_refuse;
+[if_button,legends_lamp:fletching]  @legends_lamp_refuse;
+[if_button,legends_lamp:runecraft]  @legends_lamp_refuse;
+[if_button,legends_lamp:mining]     @legends_lamp_refuse;
+
+[label,legends_lamp_refuse]
+%legendslamp = 0;
+mes("That is not one of the skills the Legends' lamp can advance.");
+
+[label,legends_lamp_grant](stat $stat)
+if_close;
+inv_del(inv, legends_lamp, 1);
+%legendslamp = 0;
+stat_advance($stat, 76500); // 7,650 experience in tenths
+sound_synth(found_gem, 1, 0);
+~mesbox("You rub the lamp.|You gain 7,650 <enum(stat, string, stat_names, $stat)> experience.");
