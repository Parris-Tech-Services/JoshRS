+// Swan Song - JoshRS original dialogue and stages on top of the 377 cache definitions (swan_* NPCs, varbit swansong).
+// Dialogue, rewards and stage values are original JoshRS content. Catch fresh fish with a small net,
+// cook at a fire/range and bring five cooked fish to Arnold. The pinned client supplies
+// 377 flags for the press, five walls, monkfish, troll deaths and bone seeds.
+
+[opnpc1,swan_herman]
+switch_int (%swansong) {
+    case ^swansong_not_started :
+        ~chatnpc("<p,sad>Our colony is hungry and the sea trolls grow bolder.|I need someone brave to help us.");
+        if (%qp < 100) {
+            ~chatnpc("<p,neutral>We need an experienced adventurer.|Return once you have at least 100 quest points.");
+            return;
+        }
+        def_int $o = ~p_choice2("What can I do?", 1, "Sorry, I'm busy.", 2);
+        if ($o = 1) {
+            ~chatplayer("<p,neutral>What can I do?");
+            ~chatnpc("<p,neutral>First enlist the Wise Old Man in Draynor.|He will ask you to prepare his supplies.");
+            %swansong = ^swansong_started;
+            ~send_quest_progress(questlist:swansong, %swansong, ^swansong_complete);
+        } else {
+            ~chatplayer("<p,neutral>Sorry, I'm busy.");
+        }
+    case ^swansong_started :
+        ~chatnpc("<p,neutral>Please ask the Wise Old Man in Draynor for help.");
+    case ^swansong_met_franklin, ^swansong_met_arnold, ^swansong_fish :
+        ~chatnpc("<p,neutral>Help Arnold with food and Franklin with the walls.");
+    case ^swansong_trolls, 51, 52, 53, 54, 55, 56, 57 :
+        ~chatnpc("<p,neutral>Our supplies are ready. Defeat all eight sea troll attacks.|You have defeated <tostring(calc(%swansong - ^swansong_trolls))> of eight.");
+        ~swan_spawn_ambusher;
+    case ^swansong_queen :
+        ~chatnpc("<p,neutral>Ask Wizard Frumscone in Yanille for help raising our defence.");
+    case ^swansong_army_deployed :
+        ~chatnpc("<p,neutral>Our skeleton magi are deployed. Now defeat the Sea Troll Queen.");
+        ~swan_spawn_queen;
+    case ^swansong_return :
+        ~chatnpc("<p,happy>The Sea Troll Queen is gone and the colony can fish again!");
+        queue(swansong_quest_complete, 0, 0);
+    case ^swansong_complete :
+        ~chatnpc("<p,happy>The colony will not forget what you did.");
+}
+
+[opnpc1,swan_franklin]
+switch_int (%swansong) {
+    case ^swansong_not_started : ~chatnpc("<p,neutral>Herman handles our visitors.");
+    case ^swansong_started :
+        ~chatnpc("<p,neutral>Herman is waiting for the Wise Old Man.|Please find him in Draynor first.");
+    case ^swansong_met_franklin :
+        ~chatnpc("<p,neutral>The west walls need five iron sheets.|Load logs into the press firebox, light them and press five iron bars.|Use the sheets on the damaged walls and bring a hammer.");
+        %swansong = ^swansong_met_arnold;
+    case ^swansong_met_arnold, ^swansong_fish :
+        ~chatnpc("<p,neutral>Repair five wall sections using iron sheets and a hammer.|You have repaired <tostring(~swan_wall_count)> of five sections.");
+        ~swan_rebuild_advance;
+    case ^swansong_trolls, ^swansong_queen, ^swansong_army_deployed, ^swansong_return :
+        ~chatnpc("<p,neutral>Thank you for repairing our walls.");
+    case default : ~chatnpc("<p,happy>Good to see you, friend.");
+}
+
+[opnpc1,swan_arnold]
+switch_int (%swansong) {
+    case ^swansong_not_started, ^swansong_started : ~chatnpc("<p,neutral>Franklin or Herman can tell you more.");
+    case ^swansong_met_franklin, ^swansong_met_arnold :
+        ~chatnpc("<p,neutral>We need five cooked fresh monkfish.|Use a small fishing net at our fishing spots, then cook the fish on a range or fire.");
+        if (inv_total(inv, net) < 1) {
+            if (inv_freespace(inv) < 1) {
+                %swansong = ^swansong_met_arnold;
+                ~chatnpc("<p,neutral>Make some room in your pack and return for a small fishing net.");
+                return;
+            }
+            inv_add(inv, net, 1);
+            ~chatnpc("<p,happy>Here is a net to get you started.");
+        }
+        %swansong = ^swansong_fish;
+    case ^swansong_fish :
+        if (%swansong_trolls < 3) {
+            ~chatnpc("<p,neutral>Sea trolls keep interrupting our fishing.|You have stopped <tostring(%swansong_trolls)> of three attacks.");
+            ~swan_spawn_fishing_troll;
+            return;
+        }
+        if (%swansong_arnold = 1) {
+            ~chatnpc("<p,happy>Our food stores have been replenished.");
+            ~swan_rebuild_advance;
+            return;
+        }
+        if (inv_total(inv, swan_monkfish) >= ^swansong_fish_needed) {
+            ~chatnpc("<p,happy>That's enough fish. Thank you.|Now help Franklin finish the defences.");
+            inv_del(inv, swan_monkfish, ^swansong_fish_needed);
+            %swansong_arnold = 1;
+            ~swan_rebuild_advance;
+        } else {
+            ~chatnpc("<p,neutral>I still need five cooked monkfish.");
+        }
+    case ^swansong_trolls, ^swansong_queen, ^swansong_army_deployed, ^swansong_return :
+        ~chatnpc("<p,neutral>The sea trolls will keep coming until their queen falls.");
+    case default : ~chatnpc("<p,happy>The fish are plentiful again.");
+}
+
+[opnpc1,swan_wom_ambush]
+~chatnpc("<p,neutral>We must secure the colony first.|The Sea Troll Queen is our final challenge.");
+
+[opnpc1,swan_drunkendwarf]
+~chatnpc("<p,happy>Hic! Don't mind me, friend.");
+
+[opnpc1,swan_boatwoman_1]
+~chatnpc("<p,neutral>I only ferry colonists.");
+
+[opnpc1,swan_boatwoman_2]
+~chatnpc("<p,neutral>I only ferry colonists.");
+
+[opnpc1,swan_colonist_1]
+~chatnpc("<p,neutral>The colony is counting on you.");
+
+[opnpc1,swan_colonist_2]
+~chatnpc("<p,neutral>Have you seen the queen's sea trolls yet?");
+
+[opnpc1,swan_colonist_3]
+~chatnpc("<p,neutral>We keep our heads down. The trolls are ruthless.");
+
+[ai_queue3,swan_troll_ambush]
+gosub(npc_death);
+if (npc_findhero = ^true) {
+    if (%swansong >= ^swansong_trolls & %swansong < ^swansong_troll_wave_complete) {
+        queue(swan_troll_kill, 0, 0);
+    }
+}
+
+[queue,swan_troll_kill]
+if (%swansong < ^swansong_trolls | %swansong >= ^swansong_troll_wave_complete) {
+    return;
+}
+%swansong = calc(%swansong + 1);
+if (%swansong = ^swansong_troll_wave_complete) {
+    %swansong = ^swansong_queen;
+    mes("The eighth sea troll falls. Ask Wizard Frumscone to prepare the final defence.");
+} else {
+    mes("A sea troll is defeated. More are approaching!");
+    ~swan_spawn_ambusher;
+}
+
+[ai_queue3,swan_seatroll_queen]
+gosub(npc_death);
+if (npc_findhero = ^true) {
+    if (%swansong = ^swansong_army_deployed) {
+        queue(swan_queen_kill, 0, 0);
+    }
+}
+
+[queue,swan_queen_kill]
+if (%swansong ! ^swansong_army_deployed) {
+    return;
+}
+%swansong = ^swansong_return;
+mes("The Sea Troll Queen falls. Herman will want to hear of it.");
+
+[queue,swansong_quest_complete]
+if (%swansong ! ^swansong_return) {
+    return;
+}
+// Coins use an inventory slot unless the player already carries a stack.
+if (inv_total(inv, coins) < 1 & inv_freespace(inv) < 1) {
+    mes("Make an empty space in your pack for the quest reward.");
+    return;
+}
+%swansong = ^swansong_complete;
+stat_advance(fishing, 100000);
+stat_advance(magic, 150000);
+stat_advance(prayer, 100000);
+inv_add(inv, coins, 25000);
+session_log(^log_adventure, "Quest complete: Swan Song");
+~send_quest_complete(questlist:swansong, swan_monkfish, 200, ^swansong_questpoints, "You have completed Swan Song!", "10,000 Fishing XP|15,000 Magic XP|10,000 Prayer XP|25,000 coins");
+
+[if_button,questlist:swansong]
+def_string $text;
+switch_int (%swansong) {
+    case ^swansong_not_started : $text = "@dbl@I can start this quest by talking to @dre@Herman Caranos@dbl@.";
+    case ^swansong_started : $text = "@str@I spoke to Herman.||@dbl@I need to enlist the Wise Old Man in Draynor (10 lava, 10 mist and 5 blood runes).";
+    case ^swansong_met_franklin : $text = "@dbl@The Wise Old Man agreed to help.||@dbl@I should speak to @dre@Franklin Caranos@dbl@.";
+    case ^swansong_met_arnold, ^swansong_fish :
+        $text = "@dbl@Arnold needs five cooked fresh monkfish.||@dbl@Franklin needs five repaired walls.";
+        $text = append($text, "|@dbl@Walls: <tostring(~swan_wall_count)> / 5.|@dbl@Fishing trolls: <tostring(%swansong_trolls)> / 3.");
+    case ^swansong_trolls, 51, 52, 53, 54, 55, 56, 57 :
+        $text = "@dbl@The colony is supplied.||@dbl@I must defeat eight attacking sea trolls.";
+        $text = append($text, "|@dbl@Attacks defeated: <tostring(calc(%swansong - ^swansong_trolls))> / 8.");
+    case ^swansong_queen : $text = "@dbl@I must ask Wizard Frumscone in Yanille for bone seeds.";
+    case ^swansong_army_deployed : $text = "@dbl@I have deployed the skeleton defenders.||@dbl@Defeat the Sea Troll Queen.";
+    case ^swansong_return : $text = "@str@I defeated the Sea Troll Queen.||@dbl@I should tell @dre@Herman@dbl@.";
+    case default : $text = "@str@I helped the colony defeat the sea trolls.||@red@QUEST COMPLETE!";
+}
+~quest_journal("Swan Song", $text);
diff --git a/scripts/quests/quest_swansong/scripts/swan_colony_repairs.rs2 b/scripts/quests/quest_swansong/scripts/swan_colony_repairs.rs2
new file mode 100644
index 0000000..a6b8841
--- /dev/null
+++ b/scripts/quests/quest_swansong/scripts/swan_colony_repairs.rs2
@@ -0,0 +1,95 @@
+// Pinned 377 objects/varbits: loc_14954/55 morph by swansong_franklin;
+// loc_14956/57 press, loc_14958/59/60 firebox, loc_14945..47 damaged walls.
+// Wall bitfields live in the permanent swansong_quest varp.
+[oplocu,loc_14958]
+if (last_useitem ! logs | %swansong < ^swansong_met_arnold) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (%swansong_franklin > 1) {
+    mes("The press already has fuel.");
+    return;
+}
+if (inv_total(inv, logs) < 1) { return; }
+inv_del(inv, logs, 1);
+%swansong_franklin = 2;
+mes("You feed logs into the metal press firebox.");
+
+[oplocu,loc_14959]
+if (last_useitem ! tinderbox | %swansong < ^swansong_met_arnold) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (stat(firemaking) < 42) {
+    mes("You need 42 Firemaking to heat this press.");
+    return;
+}
+if (inv_total(inv, tinderbox) < 1) { return; }
+%swansong_franklin = 3;
+mes("You ignite the firebox. The press begins to heat up.");
+
+[oplocu,loc_14956]
+if (last_useitem ! iron_bar | %swansong < ^swansong_met_arnold) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (%swansong_franklin < 3) {
+    mes("The metal press is not hot enough yet.");
+    return;
+}
+if (stat(smithing) < 45) {
+    mes("You need 45 Smithing to press the iron.");
+    return;
+}
+if (inv_total(inv, iron_bar) < 1) { return; }
+inv_del(inv, iron_bar, 1);
+inv_add(inv, iron_sheet, 1);
+mes("You press the iron bar into a sturdy sheet.");
+
+// The five damaged walls are placed in map m36_57 via patch 0020. A wall is
+// identified by its exact coordinate, not by loc model (five share three models).
+// Per-character swansong_wall_1..5 varbits prevent claiming the same tile twice.
+[oplocu,loc_14945] @swan_wall_repair;
+[oplocu,loc_14946] @swan_wall_repair;
+[oplocu,loc_14947] @swan_wall_repair;
+[label,swan_wall_repair]
+if (last_useitem ! iron_sheet | %swansong < ^swansong_met_arnold | %swansong > ^swansong_fish) {
+    ~displaymessage(^dm_default);
+    return;
+}
+def_int $wall = 0;
+switch_coord (loc_coord) {
+    case 0_36_57_7_19 : $wall = 1;
+    case 0_36_57_7_25 : $wall = 2;
+    case 0_36_57_7_31 : $wall = 3;
+    case 0_36_57_7_43 : $wall = 4;
+    case 0_36_57_7_45 : $wall = 5;
+    case default :
+        mes("This is not one of Franklin's five damaged wall sections.");
+        return;
+}
+switch_int ($wall) {
+    case 1 : if (%swansong_wall_1 = 1) { mes("You have already repaired this section."); return; }
+    case 2 : if (%swansong_wall_2 = 1) { mes("You have already repaired this section."); return; }
+    case 3 : if (%swansong_wall_3 = 1) { mes("You have already repaired this section."); return; }
+    case 4 : if (%swansong_wall_4 = 1) { mes("You have already repaired this section."); return; }
+    case 5 : if (%swansong_wall_5 = 1) { mes("You have already repaired this section."); return; }
+}
+if (inv_total(inv, iron_sheet) < 1 | inv_total(inv, hammer) < 1) {
+    mes("Bring an iron sheet and a hammer to repair this wall.");
+    return;
+}
+if (stat(crafting) < 40) {
+    mes("You need 40 Crafting to repair this wall.");
+    return;
+}
+inv_del(inv, iron_sheet, 1);
+switch_int ($wall) {
+    case 1 : %swansong_wall_1 = 1;
+    case 2 : %swansong_wall_2 = 1;
+    case 3 : %swansong_wall_3 = 1;
+    case 4 : %swansong_wall_4 = 1;
+    case 5 : %swansong_wall_5 = 1;
+}
+mes("You patch a wall section. Progress: <tostring(~swan_wall_count)> of 5.");
+~swan_rebuild_advance;
diff --git a/scripts/quests/quest_swansong/scripts/swan_fresh_monkfish.rs2 b/scripts/quests/quest_swansong/scripts/swan_fresh_monkfish.rs2
new file mode 100644
index 0000000..76709e6
--- /dev/null
+++ b/scripts/quests/quest_swansong/scripts/swan_fresh_monkfish.rs2
@@ -0,0 +1,49 @@
+// Swan Song small-net fishing at the actual pinned 377 NPC option 3.
+// Quest stage: only fresh food-store fish; after quest: ordinary monkfish.
+// Neither stage grants items before the three real sea-troll deaths.
+[opnpc1,swan_fishingspot]
+mes("Use your small net to catch fresh monkfish here.");
+
+[opnpc3,swan_fishingspot]
+if (%swansong ! ^swansong_fish & %swansong ! ^swansong_complete) {
+    mes("Fishing here will be possible when the colony is safe.");
+    return;
+}
+if (stat(fishing) < 62) {
+    ~mesbox("You need at least 62 Fishing to catch fresh monkfish.");
+    return;
+}
+if (~check_fish_equipment(net) = false) {
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    ~mesbox("You can't carry any more fish.");
+    return;
+}
+// The three genuine fishing troll deaths are required before food collection.
+// Each kill is credited by the NPC death queue, never by the fishing click.
+if (%swansong = ^swansong_fish & %swansong_trolls < 3) {
+    ~swan_spawn_fishing_troll;
+    return;
+}
+if (%action_delay >= map_clock) {
+    mes("You are still gathering your net.");
+    return;
+}
+%action_delay = calc(map_clock + 4);
+anim(human_smallnet, 0);
+sound_synth(net, 1, 0);
+p_delay(4);
+// Recheck after the delay: do not hand out fish after a stage change or full inventory.
+if ((%swansong ! ^swansong_fish & %swansong ! ^swansong_complete) | inv_total(inv, net) < 1 | inv_freespace(inv) < 1) {
+    return;
+}
+if (%swansong = ^swansong_fish) {
+    inv_add(inv, swan_raw_monkfish, 1);
+    stat_advance(fishing, 10);
+    mes("You catch a fresh monkfish for the colony.");
+} else {
+    inv_add(inv, raw_monkfish, 1);
+    stat_advance(fishing, 1200);
+    mes("You catch a monkfish.");
+}
diff --git a/scripts/quests/quest_swansong/scripts/swan_malignius_crafter.rs2 b/scripts/quests/quest_swansong/scripts/swan_malignius_crafter.rs2
new file mode 100644
