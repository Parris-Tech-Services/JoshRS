+// Rum Deal (30 August 2005). Original JoshRS stage values; cache varp is deal_quest.
+^dl_not_started = 0
+^dl_island = 1
+^dl_blindweed = 2
+^dl_stagnant = 3
+^dl_blessed = 4
+^dl_brew = 5
+^dl_complete = 6
+^dl_questpoints = 2
