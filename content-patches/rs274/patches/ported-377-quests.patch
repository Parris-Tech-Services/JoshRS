diff --git a/scripts/quests/quest_golem/scripts/golem_b.rs2 b/scripts/quests/quest_golem/scripts/golem_b.rs2
new file mode 100644
index 0000000..952063e
--- /dev/null
+++ b/scripts/quests/quest_golem/scripts/golem_b.rs2
@@ -0,0 +1,32 @@
+[opheld1,golem_letter]
+if(%golem_b < ^golem_b_read_letter) {
+    %golem_b = ^golem_b_read_letter;
+}
+if_openmain(scroll);
+if_settext(scroll:com_1, "");
+if_settext(scroll:com_2, "");
+if_settext(scroll:com_3, "Dearest Varmen,");
+if_settext(scroll:com_4, "I hope this finds you well. Here are the books you asked for");
+if_settext(scroll:com_5, "There has been an exciting development closer to home --");
+if_settext(scroll:com_6, "another city from the same period has been discovered east");
+if_settext(scroll:com_7, "of Varrock, and we are starting a huge excavation project");
+if_settext(scroll:com_8, "here. I don't know if the museum will be able to finance your");
+if_settext(scroll:com_9, "expedition as well as this one, so I fear your current trip will be");
+if_settext(scroll:com_10, "the last.");
+if_settext(scroll:com_11, "May Saradomin grant you a safe journey home.");
+if_settext(scroll:com_12, "Your loving Elissa.");
+if_settext(scroll:com_13, "");
+
+[oploc1,golem_bookcase]
+mes("You search the bookcase...");
+p_delay(2);
+if (%golem_b < ^golem_b_spoke_elissa) {
+    mes("You find nothing of interest.");
+    return;
+}
+if(inv_total(inv, golem_notes) = 0) {
+    inv_add(inv, golem_notes, 1);
+    ~objbox(golem_notes, "You find Varmen's expedition notes.", 200, 0, divide(^objbox_height, 3));
+} else {
+    mes("You already have Varmen's expedition notes, so you find nothing of interest.");
+}
diff --git a/scripts/quests/quest_golem/scripts/golem_elissa.rs2 b/scripts/quests/quest_golem/scripts/golem_elissa.rs2
new file mode 100644
index 0000000..6cf8fe8
--- /dev/null
+++ b/scripts/quests/quest_golem/scripts/golem_elissa.rs2
@@ -0,0 +1,52 @@
+[opnpc1,golem_elissa]
+~chatnpc("<p,happy>Hello there.");
+if (%golem_b = ^golem_b_read_letter) {
+    @multi4("What do you do here?", golem_elissa_ask_generic, "What is this place?", golem_elissa_ask_about_digsite, "I found a letter in the desert with your name on.", golem_elissa_ask_about_letter, "Sorry, I need to go.", golem_elissa_exit);
+} else if (%golem_b = ^golem_b_spoke_elissa) {
+    @multi4("What do you do here?", golem_elissa_ask_generic, "What is this place?", golem_elissa_ask_about_digsite, "Where did you say the notes were?", golem_elissa_remind_notes, "Sorry, I need to go.", golem_elissa_exit);
+} else if (%golem_b = ^golem_b_read_varmen_notes & %golem_a = ^golem_repaired & %golem_retrieved_statuette = 0) {
+    @multi4("What do you do here?", golem_elissa_ask_generic, "What is this place?", golem_elissa_ask_about_digsite, "Where is the statuette that Varmen took back from Uzer?", golem_elissa_ask_about_statuette, "Sorry, I need to go.", golem_elissa_exit);
+} else {
+    @multi3("What do you do here?", golem_elissa_ask_generic, "What is this place?", golem_elissa_ask_about_digsite, "Sorry, I need to go.", golem_elissa_exit);
+}
+
+[label,golem_elissa_ask_generic]
+~chatplayer("<p,neutral>What do you do here?");
+~chatnpc("<p,neutral>I'm helping with the dig. I'm an expert on Third Age architecture.");
+
+[label,golem_elissa_ask_about_digsite]
+~chatplayer("<p,neutral>What is this place?");
+~chatnpc("<p,shifty>In the Third Age, this was a great city. Look at these giant walls! They put Varrock to shame!");
+switch_int(~p_choice2("I don't know, Varrock is pretty impressive.", 1, "What happened to the city?", 2)) {
+    case 1 :
+        ~chatplayer("<p,neutral>I don't know, Varrock palace is impressive.");
+        ~chatnpc("<p,angry>Hmph. I don't think it will look this good when it's been buried in the ground for three thousand years!");
+    case 2 :
+        ~chatplayer("<p,quiz>What happened to the city?");
+        ~chatnpc("<p,shifty>No one knows for sure.");
+        ~chatnpc("<p,neutral>But the Third Age was a time of destruction, when the gods were violently at war.");
+        ~chatnpc("<p,sad>Many great civilizations were destroyed then.");
+}
+
+[label,golem_elissa_exit]
+~chatplayer("<p,neutral>Sorry, I need to go.");
+
+[label,golem_elissa_ask_about_letter]
+~chatplayer("<p,quiz>I found a letter in the desert with your name on.");
+~chatnpc("<p,neutral>Ah, so you've found the ruins of Uzer.");
+~chatnpc("<p,sad>I wrote that letter to my late husband when he was exploring there.");
+~chatnpc("<p,sad>That was a great city as well, but the museum could only fund one excavation and this one was closer to home.");
+~chatnpc("<p,neutral>If you're interested in his expedition, the notes he made are in the library in the Exam Centre.");
+%golem_b = ^golem_b_spoke_elissa;
+
+[label,golem_elissa_remind_notes]
+~chatplayer("<p,quiz>Where did you say the notes were?");
+~chatnpc("<p,neutral>They're on a bookcase in the Exam Centre."); // verify expression
+
+[label,golem_elissa_ask_about_statuette]
+~chatplayer("<p,quiz>Where is the statuette that Varmen took back from Uzer?");
+~chatnpc("<p,neutral>The statuette? Oh, yes...");
+~chatnpc("<p,sad>That statuette was the only thing we had to show from that expedition.");
+~chatnpc("<p,neutral>It was very worn, but you can still make out a lot of detail. The Uzerians were expert sculptors. It's a pity we only have that small example.");
+~chatnpc("<p,neutral>Now it's on display in the Varrock museum.");
+%golem_a = ^golem_finished_b;
diff --git a/scripts/quests/quest_golem/scripts/golem_golem.rs2 b/scripts/quests/quest_golem/scripts/golem_golem.rs2
new file mode 100644
index 0000000..a72bf4a
--- /dev/null
+++ b/scripts/quests/quest_golem/scripts/golem_golem.rs2
@@ -0,0 +1,139 @@
+[proc,get_golem_state]()(npc)
+if(%golem_clay < 2) {
+    return (golem_broken_golem);
+} else if(%golem_clay < 4) {
+    return (golem_partially_broken_golem);
+}
+return (golem_fixed_golem);
+
+[proc,get_golem_name]()(string)
+return (nc_name(~get_golem_state));
+
+[opnpc1,golem_golem]
+def_string $golem_name = ~get_golem_name;
+def_npc $golem_npc = ~get_golem_state;
+if(%golem_a = ^golem_not_started) {
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,sad>Damage... severe...|task... incomplete...");
+    switch_int(~p_choice2("Shall I try to repair you?", 1, "I'm not going to find a conversation here!", 2)) {
+        case 1 :
+            %golem_a = ^golem_started;
+            ~send_quest_progress_colour(questlist:golem, %golem_a, ^golem_complete);
+            ~chatplayer("<p,quiz>Shall I try to repair you?");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,happy>Repairs... needed...");
+        case 2 :
+            ~chatplayer("<p,bored>I'm not going to find a conversation here!");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,angry>Graar!");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,angry>Must... not... injure... human...");
+    }
+} else if(%golem_a = ^golem_started) {
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,sad>Damage... severe...");
+} else if(%golem_a < ^golem_statuette_inserted) {
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,sad>My task is incomplete. You must open the portal so I can defeat the great demon.");
+    switch_int(~p_choice3("How do I open the portal?", 1, "What makes you think you can defeat the demon?", 2, "I'll get right on it.", 3)) {
+        case 1 :
+            ~chatplayer("<p,quiz>How do I open the portal?");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>The four statuettes in the temple must be turned to the correct pattern.");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>I do not know the pattern. Golems are not permitted to open the portal.");
+        case 2 :
+            ~chatplayer("<p,quiz>What makes you think you can defeat the demon?");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>If not I, then who else?  No living being can destroy the demon. That is why the golems were created in the first place.");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>But the demon was badly wounded and elder-demons heal very slowly indeed. It was almost dead when it retreated to its own dimension.");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>Now that I am repaired, I will be able to destory it easily!");
+        case 3 :
+            ~chatplayer("<p,happy>I'll get right on it.");
+    }
+} else if(%golem_a = ^golem_doors_open) {
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,sad>My task is incomplete. You must open the portal so I can defeat the great demon.");
+    ~chatplayer("<p,neutral>I opened the portal.");
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>Golems cannot pass through the portal. But the demon will soon emerge. I must ready myself for combat!");
+} else if(%golem_a = ^golem_entered_portal) {
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,sad>My task is incomplete. You must open the portal so I can defeat the great demon.");
+    ~chatplayer("<p,happy>It's okay, the demon is dead!");
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,quiz>The demon must be defeated...");
+    ~chatplayer("<p,quiz>No, you don't understand. I saw the demon's skeleton. It must have died of its wounds.");
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,quiz>Demon must be defeated!  Task incomplete.");
+    %golem_a = ^golem_informed_golem;
+} else if(%golem_a = ^golem_informed_golem) {
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,sad>My task is incomplete. You must open the portal so I can defeat the great demon.");
+    ~chatplayer("<p,angry>I already told you, he's dead!");
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,sad>Task incomplete.");
+    ~chatplayer("<p,neutral>Oh, how am I going to convince you?");
+} else if(%golem_a = ^golem_complete) {
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,happy>Thank you for helping me. A golem can have no greater satisfaction than knowing that its task is complete.");
+    ~chatplayer("<p,quiz>But the whole city is destroyed! Doesn't that bother you?");
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,happy>I was never programmed to appreciate the city. My only purpose was the destruction of the demon, and that is achieved!");
+}
+
+[opnpcu,golem_golem]
+if(stat(crafting) < 20) {
+    mes("You need level 20 crafting to repair the golem.");
+    return;
+}
+if(last_useitem = softclay) {
+    if(%golem_a = ^golem_not_started) {
+        mes("Maybe you should ask the golem first!");
+        return;
+    }
+    switch_int(%golem_clay)
+    {
+        case 0 :
+            %golem_clay = 1;
+            anim(human_pickpocket, 0);
+            inv_del(inv, softclay, 1);
+            ~objbox(softclay, "You apply some clay to the golem's wounds. The clay begins to harden in the hot sun.", 200, 0, divide(^objbox_height, 3));
+        case 1 :
+            %golem_clay = 2;
+            anim(human_pickpocket, 0);
+            inv_del(inv, softclay, 1);
+            ~objbox(softclay, "You fix the golem's legs.", 200, 0, divide(^objbox_height, 3));
+        case 2 :
+            %golem_clay = 3;
+            anim(human_pickpocket, 0);
+            inv_del(inv, softclay, 1);
+            ~objbox(softclay, "The golem is nearly whole.", 200, 0, divide(^objbox_height, 3));
+        case 3 :
+            %golem_clay = 4;
+            %golem_a = ^golem_repaired;
+            def_string $golem_name = ~get_golem_name;
+            def_npc $golem_npc = ~get_golem_state;
+            anim(human_pickpocket, 0);
+            inv_del(inv, softclay, 1);
+            ~objbox(softclay, "You repair the golem with a final piece of clay.", 200, 0, divide(^objbox_height, 3));
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,confused>Damage repaired...");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,happy>Thank you. My body and mind are fully healed.");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>Now I must complete my task by defeating the great enemy.");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>A great demon. It broke through from its dimension to attack the city.");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>The golem army was created to fight it. Many were destroyed, but we drove the demon back!");
+            ~chatnpc_specific($golem_name, $golem_npc, "<p,neutral>The demon is still wounded. You must open the portal so that I can strike the final blow and complete my task.");
+        case 4 :
+            mes("You have already repaired the golem.");
+    }
+} else if(last_useitem = clay) {
+    mes("The clay is not soft enough to stick to the golem.");
+} else if(last_useitem = golem_program) {
+    if (%golem_head_open = 0) {
+        mes("You can't see a way to put the instructions in the golem's skkull.");
+        return;
+    }
+    sound_synth(golem_program, 1, 0);
+    def_string $golem_name = ~get_golem_name;
+    def_npc $golem_npc = ~get_golem_state;
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,confused>New instructions...|Updating program....");
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,happy>Task complete!");
+    ~chatnpc_specific($golem_name, $golem_npc, "<p,happy>Thank you. Now my mind is at rest.");
+    queue(golem_complete, 0, 0);
+} else if(last_useitem = golem_golemkey) {
+    if(%golem_head_open = 0) {
+        mes("You insert the key and the golem's skull hinges open.");
+        queue(golem_head_queue, 10, 0);
+        %golem_head_open = 1;
+    } else {
+        mes("The golem's head is already open.");
+    }
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[queue,golem_head_queue]
+%golem_head_open = 0;
+mes("The golem's skull shuts automatically.");
diff --git a/scripts/quests/quest_golem/scripts/golem_journal.rs2 b/scripts/quests/quest_golem/scripts/golem_journal.rs2
new file mode 100644
index 0000000..4526f0e
--- /dev/null
+++ b/scripts/quests/quest_golem/scripts/golem_journal.rs2
@@ -0,0 +1,97 @@
+[if_button,questlist:golem]
+// Sourced from osrs 30/Oct/2025
+def_string $text;
+if(%golem_a = ^golem_complete) {
+    $text = "@str@I have spoken to the golem.|";
+    $text = append($text, "@str@I have repaired the golem.|");
+    $text = append($text, "@str@The golem asked me to open the portal so it could defeat a|@str@demon.|");
+    $text = append($text, "@str@I talked to Elissa about the letter from the desert.|");
+    $text = append($text, "@str@I took Varmen's notes from the Digsite Exam Centre.|");
+    $text = append($text, "@str@I have retrieved the missing statuette from the Varrock|");
+    $text = append($text, "@str@Museum and repaired the puzzle in the temple.|");
+    $text = append($text, "@str@I have opened the portal.|");
+    $text = append($text, "@str@I have visited the demon's lair and seen its skeleton.|");
+    $text = append($text, "@str@I told the golem that the demon was dead, but it did not|@str@believe me!|");
+    $text = append($text, "@str@I reprogrammed the golem so that it knows its task is|@str@complete.|");
+    $text = append($text, "@red@QUEST COMPLETE!");
+    ~quest_journal("The Golem", $text);
+    return;
+}
+
+if(%golem_a = ^golem_not_started) {
+    // Sourced from rs3 30/Oct/2025
+    $text = "@dbl@I can start this quest by speaking to the golem who is in the|@dbl@ruined city of @dre@Uzer@dbl@, which is in the desert to the east of @dre@Shantay Pass@dbl@.";
+    // golem_b journals should still show, so we won't return here. source: rs3
+}
+
+if(%golem_a > ^golem_not_started) {
+    $text = "@str@I have spoken to the golem.";
+    if(%golem_a >= ^golem_repaired) {
+        $text = append($text, "|@str@I have repaired the golem.");
+        if(%golem_a < ^golem_doors_open) {
+            $text = append($text, "|@dbl@The golem asked me to open the @dre@portal@dbl@ so it can defeat a|@dbl@@dre@demon@dbl@.");
+            if(%golem_retrieved_statuette = 0) {
+                if(%golem_seen_underground = 0) {
+                    $text = append($text, "|@dbl@I should go down the stairs in @dre@Uzer@dbl@ and work out how to open|@dbl@the @dre@portal@dbl@.");
+                } else {
+                    $text = append($text, "|@dbl@To open the portal I will need to find a missing @dre@statuette@dbl@.");
+                }
+            }
+        } else {
+            $text = append($text, "|@str@The golem asked me to open the portal so it could defeat a|@str@demon.");
+        }
+    } else {
+        $text = append($text, "|@dbl@The @dre@golem@dbl@ asked me to repair him.");
+    }
+}
+
+if(%golem_a < ^golem_finished_b) {
+    if(%golem_b = ^golem_b_read_letter) {
+        $text = append($text, "|@dbl@Maybe I should speak to @dre@Elissa@dbl@ at the @dre@Digsite@dbl@ about the letter I|@dbl@found in Uzer.");
+    } else if(%golem_b > ^golem_b_read_letter) {
+        $text = append($text, "|@str@I talked to Elissa about the letter from the desert.");
+        if(%golem_b = ^golem_b_read_varmen_notes) {
+            $text = append($text, "|@str@I took Varmen's notes from the Digsite Exam Centre.");
+            if (%golem_a = ^golem_repaired) {
+                $text = append($text, "|@dbl@According to @dre@Varmen's notes@dbl@, he removed the @dre@statuette@dbl@");
+                $text = append($text, "|@dbl@during his expedition.");
+            }
+        } else {
+            $text = append($text, "|@dbl@Elissa told me that @dre@Varmen's expedition notes@dbl@ are in the");
+            $text = append($text, "|@dbl@library in the @dre@Exam Centre@dbl@.");
+        }
+    }
+} else {
+    $text = append($text, "|@str@I talked to Elissa about the letter from the desert.");
+    $text = append($text, "|@str@I took Varmen's notes from the Digsite Exam Centre.");
+
+    if(%golem_a < ^golem_statuette_inserted) {
+        if(%golem_retrieved_statuette = 1) {
+            $text = append($text, "|@str@I have retrieved the missing statuette from the Varrock|@str@Museum.");
+            $text = append($text, "|@dbl@I should take the @dre@statuette@dbl@ to Uzer and put it back in the|@dbl@temple.");
+        } else if(%golem_seen_underground = 1) {
+            $text = append($text, "|@dbl@To open the portal I will need the missing statuette which is in");
+            $text = append($text, "|@dbl@the @dre@Varrock Museum@dbl@.");
+        }
+    } else {
+        $text = append($text, "|@str@I have retrieved the missing statuette from the Varrock");
+        $text = append($text, "|@str@Museum and repaired the puzzle in the temple.");
+        if(%golem_a = ^golem_doors_open) {
+            $text = append($text, "|@str@I have opened the portal.");
+            $text = append($text, "|@dbl@I should find out what happened to the @dre@demon@dbl@.");
+        } else if(%golem_a >= ^golem_entered_portal) {
+            $text = append($text, "|@str@I have visited the demon's lair and seen its skeleton.");
+            if(%golem_a < ^golem_informed_golem) {
+                $text = append($text, "|@dbl@I should inform the @dre@golem@dbl@|@dbl@that the @dre@demon@dbl@ is dead.");
+            } else {
+                $text = append($text, "|@str@I told the golem that the demon was dead, but it did not|@str@believe me!");
+                $text = append($text, "|@dbl@I should find some way to convince the @dre@golem@dbl@ that its task is|@dbl@done.");
+            }
+        } else {
+            $text = append($text, "|@dbl@I should turn the @dre@statuettes@dbl@ to the correct sequence to open");
+            $text = append($text, "|@dbl@the @dre@portal@dbl@.");
+        }
+    }
+}
+
+~quest_journal("The Golem", $text);
diff --git a/scripts/quests/quest_golem/scripts/golem_notes.rs2 b/scripts/quests/quest_golem/scripts/golem_notes.rs2
new file mode 100644
index 0000000..991b4f6
--- /dev/null
+++ b/scripts/quests/quest_golem/scripts/golem_notes.rs2
@@ -0,0 +1,25 @@
+[opheld1,golem_notes]
+%book_page = 0;
+%open_book = golem_notes;
+if (%golem_b = ^golem_b_spoke_elissa) {
+    %golem_b = ^golem_b_read_varmen_notes;
+}
+@open_golem_notes;
+
+[label,open_golem_notes]
+@book_flip_page(0, 0, 9, golem_notes);
+
+// There are a few manual corrections done so it'd line up with source #3
+[proc,golem_notes]
+switch_int (%book_page) {
+    case 0 : ~book("The Ruins of Uzer", "Septober 19:|The nomads were right:|there is a city here, probably buried for millennia and revealed by the random motions of the sand. The architecture is impressive even in ruin, and must once have been amazing. One puzzling factor is the pottery -- there are fragments all over the ruins, surely too much for a city even of this size. We have set up camp and will do a proper survey tomorrow.");
+    case 1 : ~book("The Ruins of Uzer", "Septober 20:|The meaning of the pottery was explained today in a most surprising manner. We found a mostly-intact clay statue buried up to its waist in sand, and as soon as we dug it out, it started to walk around! It is a clay golem, built by the city's inhabitants and dormant all this time. Its head is badly damaged and it is uncommunicative, but its existence tells us that the city's inhabitants were expert magical craftsmen. The huge kilns in some of the buildings indicate that at some point before");
+    case 2 : ~book("The Ruins of Uzer", "its destruction the whole city was converted to the manufacture of these|golems.||We have also examined the carvings on the large building in the centre. There are symbols depicting several of the ancient gods, including Saradomin, Zamorak, and Armadyl, but there is another prominent symbol that I cannot identify. As it seems we will need to be here for longer than I had thought, I have sent to Elissa for books on golems and religious symbols.");
+    case 3 : ~book("The Ruins of Uzer", "Septober 21:|As we examine the ruins one thing becomes increasingly clear: most of the damage was not due to weathering. The buildings were destroyed by force, as if torn down by giant hands.|||Septober 22:|A breakthrough! We have found the staircase into the lower levels of the temple. This part has been untouched by the elements, and the carvings here are more intact, especially four beautiful statuettes in alcoves framing the large");
+    case 4 : ~book("The Ruins of Uzer", "door. I have removed one of them. The door will not open. I am glad I sent for a book on symbols, as the unidentified symbol is even more prominent here, especially on the door.||||Septober 23:|Our messenger returned with the books I asked for and a letter from Elissa. It is unfortunate that the museum will not be able to finance a full-scale excavation here as well as the one closer to Varrock, although I am of course pleased that the other city");
+    case 5 : ~book("The Ruins of Uzer", "has been uncovered. But with the books I am able to piece together more of the story of this city.||The unidentified symbol in the ruins is that of the demon Thammaron, who was Zamorak's chief lieutenant during the godwars of the Third Age. With that information I can say with confidence that these are the ruins of Uzer, an advanced human civilization said to have been destroyed towards the end of the Third Age (roughly 2,500 years ago). It was allied with Saradomin and enjoyed");
+    case 6 : ~book("The Ruins of Uzer", "his protection, as well as that of its own mages and warriors. Thammaron was able to open a portal from his own domain straight into the heart of the city, bypassing its defences. With Saradomin's help the army of Uzer was able to drive Thammaron back, but the record ends at that point and it has always been assumed that a later attack, either by Thammaron or by Zamorak's other forces, finished the city off.||Examining the door again, I now see that it is exactly the sort of door that could be used to seal");
+    case 7 : ~book("The Ruins of Uzer", "Thammaron's portal, I am suddenly glad I was not able to open it! I surmise that the army of golems was created in order to fight the demon, since Uzer's army had been wiped out and Saradomin's forces were increasingly stretched. However, this approach evidently failed, since the city was eventually|destroyed.||The art of the construction of golems has been lost since the Third Age, and, although they are sometimes discovered lying dormant in the ground, no");
+    case 8 : ~book("The Ruins of Uzer", "concerted effort has been made to regain it, thanks largely to the modern Saradomist Church's view of them as unnatural. This view is without foundation, as golems are neither good nor evil but follow instructions they are given to the letter and without imagination, indeed experiencing extreme discomfort for as long as a task assigned to them remains incomplete. Some golems were constructed to obey verbal instructions, but the main method of instruction was to place magical words into the golem's skull cavity.");
+    case 9 : ~book("The Ruins of Uzer", "These were written on papyrus using a naturally occuring source of ink, and their magical power derived from the use of a phoenix tail feather as a pen. These would be used for long-term or important tasks, and would override any verbal instructions.");
+}
diff --git a/scripts/quests/quest_golem/scripts/golem_phoenix.rs2 b/scripts/quests/quest_golem/scripts/golem_phoenix.rs2
new file mode 100644
index 0000000..f3569ac
--- /dev/null
+++ b/scripts/quests/quest_golem/scripts/golem_phoenix.rs2
@@ -0,0 +1,40 @@
+[opnpc3,golem_phoenix]
+if(inv_total(inv, golem_phoenixfeather) = 0 & inv_total(inv, golem_pen) = 0) {
+    if(stat(thieving) < 25) {
+        ~mesbox("You need to be a level 25 thief to grab the phoenix's tail-feather.");
+        return;
+    }
+    mes("You attempt to grab the phoenix's tail-feather.");
+    p_delay(0);
+
+    // success rates unknown, took warrior's chance as a base.
+    // TODO: revisit & move to skill_thieving when its implemented.
+    if(stat_random(thieving, 100, 240) = false) {
+        npc_say("Squawk!");
+        mes("You fail to grab the feather.");
+        npc_setmode(playerface);
+        p_delay(0);
+        spotanim_pl(stunned_thieving, 124, 0);
+        anim(%com_defendanim, 0);
+        npc_anim(firebird_attack, 0);
+        if (npc_param(attack_sound) ! null) {
+            sound_synth(npc_param(attack_sound), 0, 0);
+        }
+        sound_synth(stunned, 1, 0);
+        p_delay(0);
+        ~damage_self(1);
+        npc_setmode(null);
+
+        mes("You've been stunned!");
+        // stun timer isn't implemented.
+        return;
+    }
+
+    inv_add(inv, golem_phoenixfeather, 1);
+    anim(human_pickpocket, 1);
+    stat_advance(thieving, 260);
+    sound_synth(pick, 1, 0);
+    mes("You grab a tail-feather.");
+} else {
+    mes("You already have a phoenix tail-feather.");
+}
diff --git a/scripts/quests/quest_golem/scripts/golem_statuette.rs2 b/scripts/quests/quest_golem/scripts/golem_statuette.rs2
new file mode 100644
index 0000000..012c761
--- /dev/null
+++ b/scripts/quests/quest_golem/scripts/golem_statuette.rs2
@@ -0,0 +1,77 @@
+[oplocu,golem_statuetted]
+// todo: check anim/synth
+if(%golem_a ! ^golem_finished_b | last_useitem ! golem_statuette) {
+    ~displaymessage(^dm_default);
+    return;
+}
+%golem_a = ^golem_statuette_inserted;
+%golem_statuettestatusd = 1;
+mes("You insert the statuette into the alcove.");
+inv_del(inv, golem_statuette, 1);
+
+[oploc1,golem_statuettea]
+if(%golem_a > ^golem_statuette_inserted) {
+    mes("The statuette is now locked in place.");
+    return;
+}
+if(%golem_statuettestatusa = 0) {
+    mes("You turn the statuette to the left.");
+    %golem_statuettestatusa = 1;
+} else {
+    mes("You turn the statuette to the right.");
+    %golem_statuettestatusa = 0;
+}
+@golem_check_statues;
+
+[oploc1,golem_statuetteb]
+if(%golem_a > ^golem_statuette_inserted) {
+    mes("The statuette is now locked in place.");
+    return;
+}
+if(%golem_statuettestatusb = 0) {
+    mes("You turn the statuette to the left.");
+    %golem_statuettestatusb = 1;
+} else {
+    mes("You turn the statuette to the right.");
+    %golem_statuettestatusb = 0;
+}
+@golem_check_statues;
+
+[oploc1,golem_statuettec]
+if(%golem_a > ^golem_statuette_inserted) {
+    mes("The statuette is now locked in place.");
+    return;
+}
+if(%golem_statuettestatusc = 0) {
+    mes("You turn the statuette to the left.");
+    %golem_statuettestatusc = 1;
+} else {
+    mes("You turn the statuette to the right.");
+    %golem_statuettestatusc = 0;
+}
+@golem_check_statues;
+
+[oploc1,golem_statuetted]
+if(%golem_a > ^golem_statuette_inserted) {
+    mes("The statuette is now locked in place.");
+    return;
+}
+if(%golem_statuettestatusd = 1) {
+    mes("You turn the statuette to the right.");
+    %golem_statuettestatusd = 2;
+} else {
+    mes("You turn the statuette to the left.");
+    %golem_statuettestatusd = 1;
+}
+@golem_check_statues;
+
+[label,golem_check_statues]
+sound_synth(turn_statue, 1, 0);
+if (%golem_statuettestatusa = 1 & %golem_statuettestatusb = 1 & %golem_statuettestatusc = 0 & %golem_statuettestatusd = 2) {
+    mes("The door grinds open.");
+    if (loc_find(0_42_76_32_48, golem_portal) = true) {
+        loc_anim(golem_door_open);
+    }
+    %golem_a = ^golem_doors_open;
+    sound_synth(golem_demondoor, 1, 0);
+}
diff --git a/scripts/quests/quest_golem/scripts/quest_golem.rs2 b/scripts/quests/quest_golem/scripts/quest_golem.rs2
new file mode 100644
index 0000000..78937cb
--- /dev/null
+++ b/scripts/quests/quest_golem/scripts/quest_golem.rs2
@@ -0,0 +1,165 @@
+// Sources:
+// [1]-rsprox on 5 profiles in osrs
+// [2]-rs3 on 1 profile
+// [3]-december 2007 - https://www.youtube.com/watch?v=TvalMDEfVFE
+// [4]-october 2009 - https://www.youtube.com/watch?v=HlZRwIcXQIc journal 4:34
+// [5]-oplocu golem_displaycase - https://web.archive.org/web/20090705132153/http://www.global-rs.com/quests/golem/
+// [6]-runehq november 2005 - https://web.archive.org/web/20051130070312/http://runehq.com/RHQQuestsView.php?id=00478 - golem_letter, quest complete interface
+
+// TODO:
+// chatnpc_specific face the player, does so in actual rs
+// verify objbox scale/positionings
+// fix up respective code areas that are waiting behind porting efforts once ported
+// - shield of arrav / curator
+// - skill_thieving / golem_phoenix
+
+[oploc1,golem_insidestairs_base]
+p_arrivedelay;
+p_teleport(0_54_48_35_18);
+
+[oploc1,golem_insidestairs_top]
+%golem_seen_underground = 1;
+p_arrivedelay;
+p_teleport(0_42_76_33_22);
+
+[oploc1,golem_black_mushrooms]
+anim(human_pickuptable, 0);
+sound_synth(pick, 1, 0);
+inv_add(inv, golem_mushroom, 1);
+~objbox(golem_mushroom, "You pick a mushroom.", 250, 0, ^objbox_height);
+
+[oploc1,golem_portal]
+if(%golem_a < ^golem_doors_open) {
+    mes("You can't find any way to open the door.");
+    return;
+}
+mes("You step into the portal.");
+p_arrivedelay;
+p_teleport(2_42_76_32_20);
+if(%golem_a = ^golem_doors_open) {
+    %golem_a = ^golem_entered_portal;
+    mes("This room is dominated by a colossal horned skeleton!");
+}
+@music_playbyregionplane(coord);
+
+[oploc1,golem_demon_portal]
+mes("You step into the portal.");
+p_arrivedelay;
+p_teleport(0_42_76_25_49);
+@music_playbyregionplane(coord);
+
+[oploc1,golem_displaycase]
+// message from osrs. need a source before museum was reworked.
+mes("The cabinet is locked.");
+
+[oplocu,golem_displaycase]
+if(last_useitem ! golem_statuettekey) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if(inv_total(inv, golem_statuette) ! 0 | %golem_a >= ^golem_statuette_inserted) {
+    mes("You have already taken the statuette.");
+    return;
+}
+%golem_retrieved_statuette = 1;
+inv_add(inv, golem_statuette, 1);
+p_delay(1);
+~objbox(golem_statuette, "You open the cabinet and retrieve the statuette.", 200, 0, ^objbox_height);
+
+[oplocu,golem_demon_throne]
+def_obj $used_with = inv_getobj(inv, last_useslot);
+if($used_with ! hammer & $used_with ! chisel) {
+    ~displaymessage(^dm_default);
+    return;
+}
+
+if(%golem_throne_gems = 1) {
+    mes("You have already removed the gems from the throne.");
+    return;
+}
+
+if($used_with = hammer & inv_total(inv, chisel) = 0) {
+    mes("You'll need a chisel as well as a hammer to get the gems.");
+    return;
+} else if($used_with = chisel & inv_total(inv, hammer) = 0) {
+    mes("You'll need a hammer as well as a chisel to get the gems.");
+    return;
+}
+
+if(inv_freespace(inv) < 6) {
+    mes("You don't have enough free space to remove all six gems.");
+    return;
+}
+
+%golem_throne_gems = 1;
+sound_synth(pick, 1, 0);
+inv_add(inv, ruby, 2);
+inv_add(inv, emerald, 2);
+inv_add(inv, sapphire, 2);
+~objbox(ruby, "You prise the gems from the demon's throne.", 200, 0, divide(^objbox_height, 3));
+
+
+[opheld1,golem_mushroom]
+// rs3: no eat anim, osrs: no iop1
+mes("Eugh! It tastes horrible, and stains your fingers black.");
+inv_del(inv, golem_mushroom, 1);
+
+[opheldu,golem_mushroom]
+def_obj $used_with = inv_getobj(inv, last_useslot);
+
+// Using with empty vial works in osrs as well, but not in rs3, assume it's a "QoL change" done for osrs at some point.
+if($used_with ! pestle_and_mortar) {
+    ~displaymessage(^dm_default);
+    return;
+}
+
+if(inv_total(inv, vial_empty) = 0) {
+    ~mesbox("You crush the mushroom, but you have no vial to put the dye in and it goes everywhere!");
+    return;
+}
+
+inv_del(inv, golem_mushroom, 1);
+inv_del(inv, vial_empty, 1);
+inv_add(inv, golem_ink, 1);
+~objbox(golem_ink, "You crush the mushroom and create some black dye.", 250, 0, ^objbox_height);
+
+[opheldu,golem_phoenixfeather]
+def_obj $used_with = inv_getobj(inv, last_useslot);
+
+if($used_with = papyrus) {
+    mes("You will need some kind of ink to write with.");
+    return;
+}
+if($used_with ! golem_ink) {
+    ~displaymessage(^dm_default);
+    return;
+}
+
+inv_setslot(inv, last_slot, golem_pen, 1);
+~objbox(golem_pen, "You dip the phoenix feather into the dye.", 250, 0, 0);
+
+[opheldu,golem_pen]
+def_obj $used_with = inv_getobj(inv, last_useslot);
+
+if($used_with ! papyrus) {
+    ~displaymessage(^dm_default);
+    return;
+}
+
+if(%golem_a = ^golem_informed_golem) {
+    inv_setslot(inv, last_useslot, golem_program, 1);
+    ~objbox(golem_program, "You write on the papyrus:|YOUR TASK IS DONE", 250, 0, 0);
+} else {
+    mes("You don't know what to write.");
+}
+
+[opheld4,golem_ink]
+mes("You empty the dye out onto the ground.");
+inv_setslot(inv, last_slot, vial_empty, 1);
+
+[queue,golem_complete]
+%golem_a = ^golem_complete;
+stat_advance(crafting, 10000);
+stat_advance(thieving, 10000);
+session_log(^log_adventure, "Quest complete: The Golem");
+~send_quest_complete(questlist:golem, golem_statuette, 250, ^golem_questpoints, "You have completed the Golem quest!", "1000 Crafting XP|1000 Thieving XP");
diff --git a/scripts/quests/quest_handsand/README.md b/scripts/quests/quest_handsand/README.md
new file mode 100644
index 0000000..b3f783a
--- /dev/null
+++ b/scripts/quests/quest_handsand/README.md
@@ -0,0 +1,8 @@
+# The Hand in the Sand — JoshRS revision-377 original port
+All dialogue is original JoshRS writing. Gameplay mechanics follow publicly documented January 2006 quest objectives; pinned 377 object and NPC symbols checked.
+
+Quest chain: 17 Thieving/49 Crafting requirements; Bert gives sandy hand; guard takes hand + beer; Zavistic identifies it; Bert supplies rota; Sandy's real Brimhaven desk provides original; compare two rotas; wizard provides orb; pickpocket Sandy for sand; Betty makes serum from cache-defined items; use on coffee; Sandy records confession; hand recording + 5 earth runes + bucket sand to wizard; Mazion on Entrana finds head; hand-in grants 1 QP, 1000 Thieving and 9000 Crafting XP.
+
+Persistent server-owned %handsand stage varp. Existing Betty shop dialogue is preserved outside this quest; no administrative item grants and no mutations of family characters or saves.
+
+UNVERIFIED: Exact historical quiz dialogues, Betty potion-crafting substeps, coffee distraction sequence, animation/cutscene after sand spell, which Zavistic type appears at the Yanille bell, and real-player full flow including bank/relog/rewards. No proof of live Windows install from disposable CI.
