+// Fortunato's 2006 quest-aware dialogue. The pinned shop inventory already
+// defines wine_vinegar_merchant (500 jugs of vinegar), but the base script
+// never unlocks it. The rag_wine varbit persists through rag_bone_2.
+[opnpc1,rag_wine_merchant]
+if (map_members = ^false) {
+    ~chatnpc("<p,neutral>I'm selling wine and empty jugs, if you need any.");
+    return;
+}
+if (%rag_quest = ^rag_not_started) {
+    ~chatnpc("<p,neutral>Welcome to my wine shop. What can I get you?");
+} else if (%rag_wine = 0) {
+    ~chatnpc("<p,neutral>Vinegar? Not a popular request!|If you're helping that bone collector, I suppose I can sell you some.");
+    %rag_wine = 1;
+} else {
+    ~chatnpc("<p,happy>Welcome back. Do you need more vinegar?");
+}
+def_int $choice = ~p_choice2("Show me your stock.", 1, "Not right now.", 2);
+if ($choice = 1) {
+    ~openshop_fortunato;
+}
diff --git a/scripts/quests/quest_rag/scripts/rag_npc_drops.rs2 b/scripts/quests/quest_rag/scripts/rag_npc_drops.rs2
new file mode 100644
index 0000000..f75dc99
--- /dev/null
+++ b/scripts/quests/quest_rag/scripts/rag_npc_drops.rs2
@@ -0,0 +1,70 @@
+// Native 377 Rag and Bone Man kill-drop mapping: 35 raw bones from genuine named
+// NPC species in pinned 377 content. No teleport cheats, debug grants or duplicate
+// ai_queue3 handlers. Called exactly once inside existing core npc_death proc.
+// Players qualify only after starting the quest; required 8 before completion,
+// additional 27 after completion. Already-delivered bones never drop again.
+[proc,rag_npc_bone_index]()(int)
+if (npc_type = goblin | npc_type = goblin_armed) { return(0); }
+if (npc_type = brownbear | npc_type = darkbear) { return(1); }
+if (npc_type = ramunsheered | npc_type = ramsheered) { return(2); }
+if (npc_type = unicorn) { return(3); }
+if (npc_type = giantrat | npc_type = giantrat_grey) { return(4); }
+if (npc_type = bat) { return(5); }
+if (npc_type = wolf | npc_type = pack_wolf) { return(6); }
+if (npc_type = small_bat) { return(7); }
+if (npc_type = rat | npc_type = rat_indoors) { return(8); }
+if (npc_type = babybluedragon) { return(9); }
+if (npc_type = ogre | npc_type = ogre2) { return(10); }
+if (npc_type = jogre) { return(11); }
+if (npc_type = zogre_1 | npc_type = zogre_2) { return(12); }
+if (npc_type = mudskipper_ogre) { return(13); }
+if (npc_type = monkey) { return(14); }
+if (npc_type = horror_dagganoth_jr) { return(15); }
+if (npc_type = snake) { return(16); }
+if (npc_type = zombie_unarmed | npc_type = zombie_armed) { return(17); }
+if (npc_type = canafis_werewolf_man1 | npc_type = canafis_werewolf_woman1) { return(18); }
+if (npc_type = mossgiant | npc_type = mossgiant2) { return(19); }
+if (npc_type = firegiant | npc_type = firegiant2) { return(20); }
+if (npc_type = icegiant | npc_type = icegiant_low_wanderrange) { return(21); }
+if (npc_type = terrorbird) { return(22); }
+if (npc_type = ghoul) { return(23); }
+if (npc_type = troll) { return(24); }
+if (npc_type = sarim_seagull_pier | npc_type = sarim_seagull_pier_big) { return(25); }
+if (npc_type = ahoy_undead_cow) { return(26); }
+if (npc_type = fenk_experiment_1 | npc_type = fenk_experiment_2) { return(27); }
+if (npc_type = regicide_rabbit) { return(28); }
+if (npc_type = slayer_basilisk_baby) { return(29); }
+if (npc_type = slayer_lizard_large1_green) { return(30); }
+if (npc_type = cave_goblin_guard1 | npc_type = cave_goblin_guard2) { return(31); }
+if (npc_type = medium_frog) { return(32); }
+if (npc_type = rag_vulture) { return(33); }
+if (npc_type = ics_little_jackal) { return(34); }
+return(-1);
+
+[proc,rag_drop_quest_bone]
+if (%rag_quest ! ^rag_started & %rag_quest ! ^rag_complete) {
+    return;
+}
+def_int $index = ~rag_npc_bone_index;
+if ($index < 0 | $index >= ^rag_bone_catalog_total) {
+    return;
+}
+if (~rag_bone_delivered($index) = true) {
+    return;
+}
+if (%rag_quest = ^rag_started & ~rag_is_required_bone($index) = false) {
+    return;
+}
+if (%rag_quest = ^rag_complete & ~rag_is_required_bone($index) = true) {
+    return;
+}
+// The post-quest 27-bone wish list has the documented 1/4 tertiary drop chance.
+// The initial 8 bones remain guaranteed, matching modern OSRS behaviour.
+if (%rag_quest = ^rag_complete & random(4) ! 0) {
+    return;
+}
+def_namedobj $bone = ~rag_raw_bone($index);
+if ($bone = null) {
+    return;
+}
+obj_add(npc_coord, $bone, 1, ^lootdrop_duration);
diff --git a/scripts/quests/quest_rag/scripts/rag_potboiler.rs2 b/scripts/quests/quest_rag/scripts/rag_potboiler.rs2
new file mode 100644
index 0000000..397b101
--- /dev/null
+++ b/scripts/quests/quest_rag/scripts/rag_potboiler.rs2
@@ -0,0 +1,97 @@
+// Pot-boiler state machine. States come from the cache multiloc on varbit rag_boiler:
+// 0 no logs, 1 logs/no pot, 2 pot in place, 3 on fire, 4 boiled.
+// rag_potboiler (varbit) stores the bone index being polished (+1; 0 = none). UNVERIFIED: original encoding.
+// UNVERIFIED: boil duration.
+
+[oplocu,rag_potboiler_nologs]
+if (%rag_quest < ^rag_started) {
+    mes("You should speak to the Odd Old Man first.");
+    return;
+}
+if (last_useitem = logs) {
+    inv_del(inv, logs, 1);
+    %rag_boiler = 1;
+    mes("You place the logs under the pot-boiler.");
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[oplocu,rag_potboiler_nopot]
+if (%rag_quest < ^rag_started | %rag_potboiler ! 0) {
+    mes("Finish the bone already in the boiler first.");
+    return;
+}
+def_int $i = ~rag_bone_index(last_useitem);
+if ($i = -1 | last_useitem ! ~rag_potted_bone($i)) {
+    ~displaymessage(^dm_default);
+    return;
+}
+inv_del(inv, last_useitem, 1);
+%rag_potboiler = calc($i + 1);
+%rag_boiler = 2;
+mes("You place the bone in vinegar into the pot-boiler.");
+
+[oplocu,rag_potboiler_with_pot]
+if (last_useitem = tinderbox) {
+    %rag_boiler = 3;
+    mes("You light the logs.");
+    p_delay(20);
+    if (%rag_boiler ! 3 | %rag_potboiler < 1 | %rag_potboiler > ^rag_bone_catalog_total) {
+        return;
+    }
+    %rag_boiler = 4;
+    mes("The pot has boiled dry.");
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[oploc1,rag_potboiler_with_pot]
+if (%rag_potboiler < 1 | %rag_potboiler > ^rag_bone_catalog_total) {
+    mes("There is no bone to take from the boiler.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    mes("You need an empty inventory slot.");
+    return;
+}
+def_int $i = calc(%rag_potboiler - 1);
+inv_add(inv, ~rag_potted_bone($i), 1);
+%rag_potboiler = 0;
+%rag_boiler = 1;
+mes("You take the pot back out.");
+
+[oploc1,rag_potboiler_with_pot_boiled]
+if (%rag_potboiler < 1 | %rag_potboiler > ^rag_bone_catalog_total) {
+    mes("There is no polished bone to take.");
+    return;
+}
+if (inv_freespace(inv) < 2) {
+    mes("You need two empty inventory slots for the bone and its pot.");
+    return;
+}
+def_int $i = calc(%rag_potboiler - 1);
+inv_add(inv, ~rag_polished_bone($i), 1);
+inv_add(inv, pot_empty, 1);
+%rag_potboiler = 0;
+%rag_boiler = 0;
+mes("You take the polished bone out of the pot-boiler.");
+
+// The stage-3 pot is the cache's rag_potboiler_onfire loc. If a player
+// disconnects during the 20-tick wait the permanent stage survives, while
+// the suspended action does not. Using the tinderbox again permits safe
+// recovery; it NEVER creates a fresh bone and waits the full boil duration.
+[oplocu,rag_potboiler_onfire]
+if (last_useitem ! tinderbox | %rag_boiler ! 3) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (%rag_potboiler < 1 | %rag_potboiler > ^rag_bone_catalog_total) {
+    mes("There is no valid bone in the boiler.");
+    return;
+}
+mes("You tend the burning logs until the pot boils dry.");
+p_delay(20);
+if (%rag_boiler = 3 & %rag_potboiler >= 1 & %rag_potboiler <= ^rag_bone_catalog_total) {
+    %rag_boiler = 4;
+    mes("The pot has boiled dry. You can remove your polished bone.");
+}
