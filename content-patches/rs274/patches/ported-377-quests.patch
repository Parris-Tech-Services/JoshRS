--- /dev/null
+++ b/scripts/quests/quest_elid/scripts/quest_elid.rs2
@@ -0,0 +1,428 @@
+// Original JoshRS revision-377 quest reconstruction — no Jagex transcripts or assets.
+// Quest is a source-level playable slice. Map and spell approximations in README.
+// All rewards require player actions, actual golem kills and real handed-in quest items.
+[proc,elid_progress]()(int)
+if (testbit(%elid_main, ^elid_bit_complete) = ^true) {
+    return(2);
+}
+if (testbit(%elid_main, ^elid_bit_start) = ^true) {
+    return(1);
+}
+return(0);
+
+[opnpc1,elid_mayor]
+if (~elid_progress = 0) {
+    ~chatnpc("<p,sad>Our river is no longer filling the fountain. The people of Nardah need help.");
+    if (~p_choice2("I'll try to restore the water.", 1, "Not now.", 2) ! 1) {
+        return;
+    }
+    %elid_main = setbit(%elid_main, ^elid_bit_start);
+    ~chatnpc("<p,neutral>Ask Ghaslor about the old river legends. Our shrine keeper may also help.");
+    ~send_quest_progress(questlist:elid, 1, 2);
+    return;
+}
+if (~elid_progress = 2) {
+    ~chatnpc("<p,happy>The fountain is flowing again. You've given this town new hope!");
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_spirits) = ^true) {
+    ~chatnpc("<p,sad>We threw the sacred statue away when the fountain dried up. It fell into a crevice west of town.");
+    if (inv_total(inv, elid_shoes) = 0 & inv_total(bank, elid_shoes) = 0 &
+        testbit(%elid_main, ^elid_bit_sole) = ^false) {
+        if (inv_freespace(inv) < 1) {
+            ~chatnpc("<p,neutral>I can lend you an old pair of shoes, if you have room.");
+            return;
+        }
+        inv_add(inv, elid_shoes, 1);
+        %elid_main = setbit(%elid_main, ^elid_bit_shoes);
+        ~chatnpc("<p,neutral>Take these old shoes, if you need them. I don't know what use they could be.");
+    }
+    return;
+}
+~chatnpc("<p,neutral>Find out why the water is no longer reaching us. Ghaslor knows the old song.");
+
+[opnpc1,elid_ghaslor]
+if (~elid_progress = 0) {
+    ~chatnpc("<p,neutral>There was once a song to honour the river spirits.");
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_ballad) = ^true) {
+    ~chatnpc("<p,neutral>Wear the robes and carry the song when you approach the river source.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    ~chatnpc("<p,neutral>Make room for the old ballad.");
+    return;
+}
+inv_add(inv, elid_ballad, 1);
+%elid_main = setbit(%elid_main, ^elid_bit_ballad);
+~chatnpc("<p,neutral>The ballad honours three spirits. Read it before entering their cave.");
+
+[opnpc1,elid_shiratti]
+if (~elid_progress = 0) {
+    ~chatnpc("<p,neutral>Our shrine has long kept the river's memory.");
+    return;
+}
+~chatnpc("<p,neutral>The old cupboard contains torn ceremonial robes. Repair them with a needle and thread.");
+~chatnpc("<p,neutral>The ancestral key is also near the shrine. Retrieve it with magic before visiting the waterfall.");
+
+[oploc1,elid_cupboard_closed_withrobes]
+if (~elid_progress = 0) {
+    mes("An old cupboard full of torn ceremonial cloth.");
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_robes) = ^true |
+    inv_total(inv, elid_robetop_torn) > 0 | inv_total(inv, elid_robebottoms_torn) > 0 |
+    inv_total(inv, elid_robetop) > 0 | inv_total(inv, elid_robebottoms) > 0 |
+    inv_total(worn, elid_robetop) > 0 | inv_total(worn, elid_robebottoms) > 0) {
+    mes("You have already found the ceremonial robes.");
+    return;
+}
+if (inv_freespace(inv) < 2) {
+    mes("You need two free inventory spaces.");
+    return;
+}
+inv_add(inv, elid_robetop_torn, 1);
+inv_add(inv, elid_robebottoms_torn, 1);
+mes("You recover two torn sections of old ceremonial robes.");
+
+[opheldu,elid_robetop_torn]
+if (last_useitem = needle | last_useitem = thread) {
+    @elid_repair_robes;
+} else {
+    ~displaymessage(^dm_default);
+}
+[opheldu,elid_robebottoms_torn]
+if (last_useitem = needle | last_useitem = thread) {
+    @elid_repair_robes;
+} else {
+    ~displaymessage(^dm_default);
+}
+[label,elid_repair_robes]
+if (~elid_progress = 0 | inv_total(inv, elid_robetop_torn) < 1 |
+    inv_total(inv, elid_robebottoms_torn) < 1) {
+    mes("You need both torn pieces.");
+    return;
+}
+if (inv_total(inv, needle) < 1 | inv_total(inv, thread) < 1) {
+    mes("You need a needle and thread to repair the robes.");
+    return;
+}
+inv_del(inv, elid_robetop_torn, 1);
+inv_del(inv, elid_robebottoms_torn, 1);
+inv_del(inv, thread, 1);
+inv_add(inv, elid_robetop, 1);
+inv_add(inv, elid_robebottoms, 1);
+%elid_main = setbit(%elid_main, ^elid_bit_robes);
+mes("You sew the torn pieces into a set of ceremonial robes.");
+
+// The shrine's cache-backed statuette plinth supports both ancient-key retrieval
+// (requires a genuine item-on-object packet and rune costs) and final restoration.
+[oplocu,elid_statuette_multiloc]
+if (last_useitem = elid_statuette) {
+    @elid_restore_statue;
+    return;
+}
+if (last_useitem ! lawrune) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (~elid_progress = 0 | testbit(%elid_main, ^elid_bit_key) = ^true) {
+    mes("There is nothing else to retrieve.");
+    return;
+}
+if (stat_base(magic) < 33 | inv_total(inv, lawrune) < 1 |
+    inv_total(inv, airrune) < 1) {
+    mes("You need 33 Magic, a law rune and an air rune to retrieve the ancestral key.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    mes("Make some room for the key.");
+    return;
+}
+inv_del(inv, lawrune, 1);
+inv_del(inv, airrune, 1);
+inv_add(inv, elid_key, 1);
+%elid_main = setbit(%elid_main, ^elid_bit_key);
+mes("You draw the ancestral key away from the inaccessible ledge.");
+// Note: Telekinetic Grab spell targeting is a historical-fidelity follow-up.
+
+[oplocu,elid_climbing_rope_root]
+if (last_useitem ! rope) {
+    ~displaymessage(^dm_default);
+    return;
+}
+@elid_enter_river;
+[oploc1,elid_climbing_rope_up]
+@elid_enter_river;
+[label,elid_enter_river]
+if (~elid_progress = 0 | testbit(%elid_main, ^elid_bit_ballad) = ^false |
+    testbit(%elid_main, ^elid_bit_key) = ^false |
+    testbit(%elid_main, ^elid_bit_robes) = ^false) {
+    mes("Bring the old song, ancestral key and ceremonial robes before entering.");
+    return;
+}
+if (inv_total(worn, elid_robetop) < 1 | inv_total(worn, elid_robebottoms) < 1 |
+    inv_total(inv, elid_key) < 1) {
+    mes("Wear the ceremonial robes and carry your ancestral key.");
+    return;
+}
+if (inv_total(inv, rope) < 1) {
+    mes("You need a rope to reach the cave.");
+    return;
+}
+mes("You secure the rope and descend towards the river's hidden chambers.");
+p_teleport(0_52_149_40_38);
+
+[oploc1,elid_underground_robe_door]
+if (~elid_progress = 0 | inv_total(inv, elid_key) < 1 |
+    inv_total(worn, elid_robetop) < 1 | inv_total(worn, elid_robebottoms) < 1) {
+    mes("An ancestral key and the ceremonial robes are needed to enter.");
+    return;
+}
+mes("The ancestral key fits the lock, and the door opens.");
+loc_change(elid_underground_robe_door_open, 100);
+
+// The actual three golem NPCs are spawned by their real cache doors,
+// not granted as completed flags via dialogue.
+[oploc1,elid_blackgolem_door]
+if (testbit(%elid_main, ^elid_bit_black) = ^true) {
+    mes("The black golem has been defeated.");
+    return;
+}
+if (~elid_progress = 0 | inv_total(inv, elid_key) < 1) {
+    mes("You are not ready to challenge this guardian.");
+    return;
+}
+if (npc_find(loc_coord, elid_golem_black, 6, 0) = true) {
+    mes("The black golem already guards this room.");
+    return;
+}
+mes("A black golem blocks the way. Crushing blows are the most effective.");
+npc_add(movecoord(loc_coord, 1, 0, 0), elid_golem_black, 1000);
+npc_setmode(opplayer2);
+[oploc1,elid_greygolem_door]
+if (testbit(%elid_main, ^elid_bit_grey) = ^true) {
+    mes("The grey golem has been defeated.");
+    return;
+}
+if (~elid_progress = 0 | inv_total(inv, elid_key) < 1) {
+    mes("You are not ready to challenge this guardian.");
+    return;
+}
+if (npc_find(loc_coord, elid_golem_grey, 6, 0) = true) {
+    mes("The grey golem is already guarding this room.");
+    return;
+}
+mes("A grey golem challenges you. Slashing blows seem most effective.");
+npc_add(movecoord(loc_coord, 1, 0, 0), elid_golem_grey, 1000);
+npc_setmode(opplayer2);
+[oploc1,elid_whitegolem_door]
+if (testbit(%elid_main, ^elid_bit_white) = ^true) {
+    mes("The white golem has been defeated.");
+    return;
+}
+if (~elid_progress = 0 | inv_total(inv, elid_key) < 1) {
+    mes("You are not ready to challenge this guardian.");
+    return;
+}
+if (npc_find(loc_coord, elid_golem_white, 6, 0) = true) {
+    mes("The white golem already guards this room.");
+    return;
+}
+mes("A white golem attacks. Stabbing attacks seem particularly effective.");
+npc_add(movecoord(loc_coord, 1, 0, 0), elid_golem_white, 1000);
+npc_setmode(opplayer2);
+
+[ai_queue3,elid_golem_black]
+~npc_default_death;
+if (npc_findhero = ^false) {
+    return;
+}
+queue(elid_black_defeated, 0, 0);
+[queue,elid_black_defeated]
+if (~elid_progress = 1) {
+    %elid_main = setbit(%elid_main, ^elid_bit_black);
+    mes("The black golem falls. The ranged water channel is now accessible.");
+}
+[ai_queue3,elid_golem_grey]
+~npc_default_death;
+if (npc_findhero = ^false) {
+    return;
+}
+queue(elid_grey_defeated, 0, 0);
+[queue,elid_grey_defeated]
+if (~elid_progress = 1) {
+    %elid_main = setbit(%elid_main, ^elid_bit_grey);
+    mes("The grey golem falls. The mining water channel is now accessible.");
+}
+[ai_queue3,elid_golem_white]
+~npc_default_death;
+if (npc_findhero = ^false) {
+    return;
+}
+queue(elid_white_defeated, 0, 0);
+[queue,elid_white_defeated]
+if (~elid_progress = 1) {
+    %elid_main = setbit(%elid_main, ^elid_bit_white);
+    mes("The white golem falls. The trap water channel is now accessible.");
+}
+
+// Different channels require the corresponding defeated guardian and real
+// inventory/equipment or skill evidence; no generic option grants all three.
+[oploc1,elid_waterchannel_ranged_multiloc]
+if (testbit(%elid_main, ^elid_bit_black) = ^false) {
+    mes("The black golem must be defeated first.");
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_ranged) = ^true) {
+    mes("The distant target has already been cleared.");
+    return;
+}
+if (stat_base(ranged) < 37 |
+    inv_total(worn, shortbow) < 1 |
+    inv_total(inv, bronze_arrow) < 1) {
+    mes("You need 37 Ranged, an equipped shortbow, and a bronze arrow to hit the target.");
+    return;
+}
+inv_del(inv, bronze_arrow, 1);
+%elid_main = setbit(%elid_main, ^elid_bit_ranged);
+mes("The arrow strikes the target. Water rushes through the northern channel.");
+
+[oplocu,elid_waterchannel_mining_multiloc]
+if (last_useitem ! bronze_pickaxe & last_useitem ! iron_pickaxe &
+    last_useitem ! steel_pickaxe & last_useitem ! rune_pickaxe) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_grey) = ^false) {
+    mes("The grey golem still guards this channel.");
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_mining) = ^true) {
+    mes("You have already cleared the rocks.");
+    return;
+}
+if (stat_base(mining) < 37) {
+    mes("You need 37 Mining.");
+    return;
+}
+anim(human_dig, 0);
+p_delay(2);
+%elid_main = setbit(%elid_main, ^elid_bit_mining);
+mes("You break up the rocks blocking the second channel.");
+
+[oploc1,elid_waterchannel_thieving_multiloc]
+if (testbit(%elid_main, ^elid_bit_white) = ^false) {
+    mes("The white golem still guards this passage.");
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_thieving) = ^true) {
+    mes("The trap is already safe.");
+    return;
+}
+if (stat_base(thieving) < 37) {
+    mes("You need 37 Thieving.");
+    return;
+}
+anim(human_pickpocket, 0);
+p_delay(1);
+%elid_main = setbit(%elid_main, ^elid_bit_thieving);
+mes("You disarm the trap. Water begins to flow in the third channel.");
+
+[opnpc1,elid_waterspirit]
+@elid_speak_spirits;
+[opnpc1,elid_waterspirit_sitting]
+@elid_speak_spirits;
+[opnpc1,elid_waterspirit_male]
+@elid_speak_spirits;
+[label,elid_speak_spirits]
+if (~elid_progress = 0) {
+    ~chatnpc("<p,neutral>The river remembers the old days.");
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_ranged) = ^false |
+    testbit(%elid_main, ^elid_bit_mining) = ^false |
+    testbit(%elid_main, ^elid_bit_thieving) = ^false) {
+    ~chatnpc("<p,neutral>Three channels must flow before we can speak of the village.");
+    return;
+}
+%elid_main = setbit(%elid_main, ^elid_bit_spirits);
+~chatnpc("<p,neutral>Water was withdrawn when our sacred statue was cast away.");
+~chatnpc("<p,neutral>Find it in a crevice to the west of Nardah and restore it to our shrine.");
+
+[opheldu,elid_shoes]
+if (last_useitem ! knife) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_spirits) = ^false |
+    inv_total(inv, elid_shoes) < 1) {
+    mes("These shoes are of no use yet.");
+    return;
+}
+inv_del(inv, elid_shoes, 1);
+inv_add(inv, elid_sole, 1);
+%elid_main = setbit(%elid_main, ^elid_bit_sole);
+mes("You carefully remove the sole from the mayor's old shoes.");
+
+[oplocu,elid_crevice_clickzone]
+if (last_useitem ! rope) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_spirits) = ^false |
+    inv_total(inv, rope) < 1) {
+    mes("You need a rope and a reason to descend into this dark crevice.");
+    return;
+}
+mes("You secure your rope and descend into the crevice.");
+p_teleport(0_52_145_42_40);
+
+[opnpc1,elid_genie]
+if (~elid_progress = 0) {
+    ~chatnpc("<p,neutral>This place is not for sightseeing.");
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_genie) = ^true) {
+    ~chatnpc("<p,neutral>Enjoy your restored statue.");
+    return;
+}
+if (testbit(%elid_main, ^elid_bit_spirits) = ^false) {
+    ~chatnpc("<p,neutral>You wouldn't know what to do with the statue.");
+    return;
+}
+if (inv_total(inv, elid_sole) < 1) {
+    ~chatnpc("<p,neutral>I'll trade the statue for the mayor's sole. You know, the sole of a shoe.");
+    return;
+}
+inv_del(inv, elid_sole, 1);
+inv_add(inv, elid_statuette, 1);
+%elid_main = setbit(%elid_main, ^elid_bit_genie);
+~chatnpc("<p,happy>A fine bargain. You may take the old statue.");
+ 
+[label,elid_restore_statue]
+if (testbit(%elid_main, ^elid_bit_spirits) = ^false |
+    testbit(%elid_main, ^elid_bit_genie) = ^false |
+    inv_total(inv, elid_statuette) < 1 |
+    testbit(%elid_main, ^elid_bit_complete) = ^true) {
+    ~displaymessage(^dm_default);
+    return;
+}
+inv_del(inv, elid_statuette, 1);
+%elid_main = setbit(%elid_main, ^elid_bit_fountain);
+%elid_main = setbit(%elid_main, ^elid_bit_complete);
+queue(elid_complete, 0, 0);
+mes("You restore the old statue to the shrine. Water flows again into Nardah.");
+
+[queue,elid_complete]
+if (testbit(%elid_main, ^elid_bit_complete) = ^false) {
+    return;
+}
+session_log(^log_adventure, "Quest complete: Spirits of the Elid");
+~send_quest_complete(questlist:elid, elid_statuette, 250, ^elid_questpoints,
+    "You have completed the\\nSpirits of the Elid Quest!",
+    "2 Quest Points|8,000 Prayer XP|1,000 Thieving XP|1,000 Magic XP");
+stat_advance(prayer, ^elid_prayer_xp);
+stat_advance(thieving, ^elid_thieving_xp);
+stat_advance(magic, ^elid_magic_xp);
diff --git a/scripts/quests/quest_fenkenstrain/configs/quest_fenkenstrain.constant b/scripts/quests/quest_fenkenstrain/configs/quest_fenkenstrain.constant
new file mode 100644
index 0000000..8a12c6f
--- /dev/null
+++ b/scripts/quests/quest_fenkenstrain/configs/quest_fenkenstrain.constant
@@ -0,0 +1,17 @@
+// Creature of Fenkenstrain: stage values for %fenk_quest (varp defined in the 377 cache as fenk_quest).
+// The cache's multinpc morphs treat 0-7 as "in progress" and 8 as complete, so only 8 is fixed;
+// the in-between stage numbers are a reconstruction. See JOSHRS_FENKENSTRAIN_NOTES.md.
+^fenk_not_started = 0
+^fenk_hired = 1
+^fenk_sewn = 2
+^fenk_conductor_fixed = 3
+^fenk_tower_key_given = 4
+^fenk_met_creature = 5
+^fenk_complete = 8
+^fenk_questpoints = 2
+// stat_advance takes XP x10, so this is 1,000 XP. UNVERIFIED for 377.
+^fenk_thieving_xp = 10000
+^fenk_threads_needed = 5
+// UNVERIFIED start requirements (modern wiki values); enforced in one place: proc fenk_meets_requirements.
+^fenk_req_crafting = 20
+^fenk_req_thieving = 25
diff --git a/scripts/quests/quest_fenkenstrain/configs/quest_fenkenstrain.varp b/scripts/quests/quest_fenkenstrain/configs/quest_fenkenstrain.varp
new file mode 100644
index 0000000..ad71fe1
--- /dev/null
+++ b/scripts/quests/quest_fenkenstrain/configs/quest_fenkenstrain.varp
@@ -0,0 +1,10 @@
+// Moved out of scripts/_unpack/377/all.varp (see 0002-move-fenk-varps-out-of-unpack.patch).
+// transmit=yes is required: the cache's multinpc morphs (and the 17 fenk_* varbits on fenk_flags)
+// are resolved client-side. scope=perm is required to persist: engine default scope is temp.
+[fenk_quest]
+scope=perm
+transmit=yes
+
+[fenk_flags]
+scope=perm
+transmit=yes
diff --git a/scripts/quests/quest_fenkenstrain/scripts/fenk_castle.rs2 b/scripts/quests/quest_fenkenstrain/scripts/fenk_castle.rs2
new file mode 100644
index 0000000..b9f9adb
--- /dev/null
+++ b/scripts/quests/quest_fenkenstrain/scripts/fenk_castle.rs2
@@ -0,0 +1,327 @@
+// Creature of Fenkenstrain — original JoshRS castle interactions.
+// The cache provides scenery and item IDs, not executable quest steps.
+// Coordinate-specific rewards deliberately exclude unrelated identically-typed locs.
+// No character/account is modified until these ordinary player interactions occur.
+
+// The Canifis notice starts the narrative; Dr Fenkenstrain starts the quest.
+[oploc1,fenk_signpost]
+@fenk_read_notice;
+
+[oploc2,fenk_signpost]
+@fenk_read_notice;
+
+[label,fenk_read_notice]
+if (loc_coord ! 0_54_54_37_29) {
+    mes("The sign is too weathered to read.");
+    return;
+}
+%fenk_read_signpost = 1;
+~mesbox("Castle Fenkenstrain seeks an assistant.|A steady hand, a strong stomach and discretion required.|Applicants should speak with the doctor at the castle to the north-east.");
+mes("You decide to visit the doctor at the castle.");
+
+// Give normal, explicitly cache-defined puzzle items only once.
+[oploc1,fenk_bookcase]
+if (%fenk_quest = ^fenk_not_started) {
+    mes("The books are thick with dust.");
+    return;
+}
+def_namedobj $reward = null;
+if (loc_coord = 1_55_55_22_38) {
+    $reward = fenk_marble_amulet;
+} else if (loc_coord = 1_55_55_35_38) {
+    $reward = fenk_obsidian_amulet;
+} else {
+    mes("You search the books but discover nothing useful.");
+    return;
+}
+// After both halves are assembled, never allow repeat harvesting
+// from the same bookcase while the finished amulet exists.
+if (inv_total(inv, fenk_star_amulet) > 0 |
+    inv_total(bank, fenk_star_amulet) > 0) {
+    mes("You already assembled the star-shaped amulet.");
+    return;
+}
+if (inv_total(inv, $reward) > 0 | inv_total(bank, $reward) > 0) {
+    mes("You have already taken the strange amulet from these shelves.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    mes("You need room in your pack to take what you found.");
+    return;
+}
+inv_add(inv, $reward, 1);
+mes("Behind an old book you find an unusual amulet.");
+
+// Either order, normal item-on-item packet (OPHELDU).
+[opheldu,fenk_marble_amulet]
+if (last_useitem = fenk_obsidian_amulet) {
+    @fenk_join_amulets;
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[opheldu,fenk_obsidian_amulet]
+if (last_useitem = fenk_marble_amulet) {
+    @fenk_join_amulets;
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[label,fenk_join_amulets]
+if (inv_total(inv, fenk_marble_amulet) < 1 | inv_total(inv, fenk_obsidian_amulet) < 1) {
+    mes("You need both amulet halves to fit them together.");
+    return;
+}
+inv_del(inv, fenk_marble_amulet, 1);
+inv_del(inv, fenk_obsidian_amulet, 1);
+inv_add(inv, fenk_star_amulet, 1);
+mes("The two pieces lock together to form a star-shaped amulet.");
+
+// Broom cupboard and cane pile are distinct real castle locs.
+[oploc1,fenk_broomcupboard]
+@fenk_take_broom;
+
+[oploc1,fenk_broomcupboard_open]
+@fenk_take_broom;
+
+[label,fenk_take_broom]
+if (%fenk_quest < ^fenk_sewn) {
+    mes("The broom cupboard contains some old gardening tools.");
+    return;
+}
+if (inv_total(inv, fenk_brush0) > 0 | inv_total(inv, fenk_brush1) > 0 |
+    inv_total(inv, fenk_brush2) > 0 | inv_total(inv, fenk_brush3) > 0 |
+    inv_total(inv, fenk_lightning_mould) > 0 | inv_total(inv, fenk_conductor) > 0) {
+    mes("You already have the brush you need.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    mes("You need an empty inventory slot.");
+    return;
+}
+inv_add(inv, fenk_brush0, 1);
+mes("You take a worn garden brush from the cupboard.");
+
+[oploc1,fenk_canepile]
+if (%fenk_quest < ^fenk_sewn) {
+    mes("You see a stack of spare canes.");
+    return;
+}
+if (inv_total(inv, fenk_cane) >= 3) {
+    mes("You already have enough canes for the job.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    mes("You need an empty inventory slot.");
+    return;
+}
+inv_add(inv, fenk_cane, 1);
+mes("You take a cane from the pile.");
+
+// Three canes strengthen the brush. The bronze wire binds it to a mould.
+[opheldu,fenk_brush0]
+if (last_useitem = fenk_cane) {
+    @fenk_extend_brush(fenk_brush0, fenk_brush1);
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[opheldu,fenk_brush1]
+if (last_useitem = fenk_cane) {
+    @fenk_extend_brush(fenk_brush1, fenk_brush2);
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[opheldu,fenk_brush2]
+if (last_useitem = fenk_cane) {
+    @fenk_extend_brush(fenk_brush2, fenk_brush3);
+} else {
+    ~displaymessage(^dm_default);
+}
+
+// Revision 377 OPHELDU can designate either inventory item as source.
+// Both drag directions must reach the same guarded recipe and inventory checks.
+[opheldu,fenk_cane]
+switch_obj (last_useitem) {
+    case fenk_brush0 : @fenk_extend_brush(fenk_brush0, fenk_brush1);
+    case fenk_brush1 : @fenk_extend_brush(fenk_brush1, fenk_brush2);
+    case fenk_brush2 : @fenk_extend_brush(fenk_brush2, fenk_brush3);
+    case default : ~displaymessage(^dm_default);
+}
+
+[label,fenk_extend_brush](namedobj $old, namedobj $new)
+if (stat(crafting) < ^fenk_req_crafting) {
+    mes("You need 20 Crafting to extend the brush without breaking it.");
+    return;
+}
+if (inv_total(inv, $old) < 1 | inv_total(inv, fenk_cane) < 1) {
+    mes("You need the brush and one more cane.");
+    return;
+}
+inv_del(inv, $old, 1);
+inv_del(inv, fenk_cane, 1);
+inv_add(inv, $new, 1);
+mes("You fit another cane onto the brush handle.");
+
+// The upstairs west fireplace is the actual location, not any fireplace.
+[oplocu,fenk_fireplace]
+if (last_useitem ! fenk_brush3) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (loc_coord ! 1_55_55_24_35 | %fenk_quest < ^fenk_sewn) {
+    mes("This is not the right place to shape the mould.");
+    return;
+}
+if (inv_total(inv, bronzecraftwire) < 3 | inv_total(inv, fenk_brush3) < 1) {
+    mes("You need the completed brush and three pieces of bronze wire.");
+    return;
+}
+inv_del(inv, bronzecraftwire, 3);
+inv_del(inv, fenk_brush3, 1);
+inv_add(inv, fenk_lightning_mould, 1);
+mes("You bind the brush with bronze wire and shape the lightning-conductor mould.");
+
+// Cast silver in the *actual native furnace*. This proc is invoked by the
+// narrowly scoped extension to the existing smelting furnace handler. It
+// uses the normal item-on-furnace packet, furnace animation and game delay;
+// no direct item-on-mould shortcut or privileged inventory alteration.
+[proc,fenk_cast_conductor_furnace]
+if (%fenk_quest ! ^fenk_sewn) {
+    mes("The doctor has not asked you to make a lightning conductor yet.");
+    return;
+}
+if (inv_total(inv, fenk_lightning_mould) < 1) {
+    mes("You need the mould made from the garden brush.");
+    return;
+}
+if (inv_total(inv, silver_bar) < 1) {
+    mes("You need a silver bar to cast the conductor.");
+    return;
+}
+p_arrivedelay;
+anim(human_furnace, 0);
+sound_synth(furnace, 1, 0);
+mes("You pour the molten silver into the conductor mould.");
+p_delay(2);
+if (inv_total(inv, fenk_lightning_mould) < 1 | inv_total(inv, silver_bar) < 1) {
+    return;
+}
+inv_del(inv, silver_bar, 1);
+inv_add(inv, fenk_conductor, 1);
+mes("The silver cools into a usable lightning conductor.");
+
+[oplocu,fenk_conductor_broken]
+if (last_useitem ! fenk_conductor) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (%fenk_quest ! ^fenk_sewn) {
+    mes("You have no reason to repair the conductor now.");
+    return;
+}
+if (loc_coord ! 2_55_55_28_16 | inv_total(inv, fenk_conductor) < 1) {
+    mes("You cannot reach the conductor from here.");
+    return;
+}
+inv_del(inv, fenk_conductor, 1);
+%fenk_conductor_repaired = 1;
+%fenk_quest = ^fenk_conductor_fixed;
+loc_change(fenk_conductor_repaired, 600);
+mes("You secure the new conductor. Lightning crackles over the castle.");
+mes("You should tell Dr Fenkenstrain the experiment is ready.");
+
+// The doctor supplies the shed key at stage 2; opening is a standard
+// short-lived, collision-aware location change, while access is persistent.
+[oploc1,fenk_shed_door]
+@fenk_open_shed;
+
+[oplocu,fenk_shed_door]
+if (last_useitem = fenk_shed_key) {
+    @fenk_open_shed;
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[label,fenk_open_shed]
+if (%fenk_unlocked_shed = 0 & inv_total(inv, fenk_shed_key) < 1) {
+    mes("The shed door is locked. You need its key.");
+    return;
+}
+%fenk_unlocked_shed = 1;
+loc_change(fenk_shed_door_open, 100);
+mes("The shed door swings open.");
+
+[oploc1,fenk_tower_door]
+@fenk_open_tower;
+
+[oplocu,fenk_tower_door]
+if (last_useitem = fenk_tower_key) {
+    @fenk_open_tower;
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[label,fenk_open_tower]
+if (%fenk_quest < ^fenk_tower_key_given) {
+    mes("The tower door is firmly locked.");
+    return;
+}
+if (%fenk_unlocked_tower = 0 & inv_total(inv, fenk_tower_key) < 1) {
+    mes("You need the tower key from Dr Fenkenstrain.");
+    return;
+}
+%fenk_unlocked_tower = 1;
+loc_change(fenk_tower_door_open, 100);
+mes("You unlock the tower.");
+
+// Grave location is an unverified candidate in the cache. Only the one
+// candidate can supply the head, so random castle graves are not loot chests.
+[oploc2,fenk_grave_poor]
+if (loc_coord ! 0_56_54_24_35 | %fenk_quest < ^fenk_hired) {
+    mes("You find nothing that would help the doctor's experiment.");
+    return;
+}
+if (inv_total(inv, spade) < 1) {
+    mes("You need a spade to dig here.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    mes("You need some room to carry what you find.");
+    return;
+}
+if (inv_total(inv, fenk_head_empty) > 0 | inv_total(inv, fenk_head_full) > 0 |
+    %fenk_head = 1) {
+    mes("You have already found the head the doctor needs.");
+    return;
+}
+inv_add(inv, fenk_head_empty, 1);
+mes("You carefully uncover an old, empty skull.");
+
+[opheldu,fenk_head_empty]
+if (last_useitem ! fenk_brain) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (inv_total(inv, fenk_head_empty) < 1 | inv_total(inv, fenk_brain) < 1) {
+    mes("You need both the head and the preserved brain.");
+    return;
+}
+inv_del(inv, fenk_head_empty, 1);
+inv_del(inv, fenk_brain, 1);
+inv_add(inv, fenk_head_full, 1);
+mes("The preserved brain fits into the empty skull.");
+
+[oploc1,fenk_clock]
+if (loc_coord ! 1_55_55_20_25 | %fenk_quest < ^fenk_sewn) {
+    mes("A curious clock ticks away inside the castle.");
+    return;
+}
+%fenk_wound_clock = 1;
+mes("You wind the clock. Its mechanism begins ticking steadily.");
+
+// Native 377 stairs.rs2 already registers both Fenkenstrain stair
+// triggers, but its switch routes are placeholders. Patch 0005 extends
+// those original handlers with the coordinates from pinned m55_55.jm2;
+// never register duplicate handlers in this quest script.
diff --git a/scripts/quests/quest_fenkenstrain/scripts/fenk_dungeon.rs2 b/scripts/quests/quest_fenkenstrain/scripts/fenk_dungeon.rs2
new file mode 100644
index 0000000..21e526a
--- /dev/null
+++ b/scripts/quests/quest_fenkenstrain/scripts/fenk_dungeon.rs2
@@ -0,0 +1,126 @@
+// Fenkenstrain's experimental creatures and mausoleum, original JoshRS scripts.
+// Genuine combat death uses the normal NPC death/hero pipeline: no instant key
+// from chatting to a monster, no privileged setXP/setStage shortcut.
+[ai_queue3,fenk_experiment_1]
+~npc_default_death;
+if (npc_findhero = ^false) {
+    return;
+}
+if (%fenk_quest < ^fenk_hired | %fenk_quest >= ^fenk_complete) {
+    return;
+}
+if (inv_total(inv, fenk_mausoleum_key) > 0 | inv_total(bank, fenk_mausoleum_key) > 0) {
+    return;
+}
+obj_add(npc_coord, fenk_mausoleum_key, 1, ^lootdrop_duration);
+
+// A normal key opens the existing dungeon gate. It is not consumed, to avoid
+// trapping a player on logout or leaving them unable to replace a lost key.
+[oploc1,fenk_mausoleum_door]
+@fenk_open_mausoleum_gate;
+
+[oplocu,fenk_mausoleum_door]
+if (last_useitem = fenk_mausoleum_key) {
+    @fenk_open_mausoleum_gate;
+} else {
+    ~displaymessage(^dm_default);
+}
+
+[label,fenk_open_mausoleum_gate]
+if (%fenk_quest < ^fenk_hired) {
+    mes("You cannot enter the mausoleum yet.");
+    return;
+}
+if (inv_total(inv, fenk_mausoleum_key) = 0 & %fenk_unlocked_cavern = 0) {
+    mes("The gate is locked. One of the creatures nearby has the key.");
+    return;
+}
+%fenk_unlocked_cavern = 1;
+loc_change(fenk_mausoleum_door_open, 100);
+mes("The cavern key unlocks the gate.");
+
+// The old chest can provide a replacement for the return journey.
+[oploc1,fenk_chest_open]
+if (%fenk_unlocked_cavern = 0 | %fenk_quest < ^fenk_hired) {
+    mes("You search the chest, but find nothing useful.");
+    return;
+}
+if (inv_total(inv, fenk_mausoleum_key) > 0 | inv_total(bank, fenk_mausoleum_key) > 0) {
+    mes("You already have a cavern key.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    mes("You need room to take the key from the chest.");
+    return;
+}
+inv_add(inv, fenk_mausoleum_key, 1);
+mes("You find a spare cavern key in the chest.");
+
+// Three mausoleum memorials; west to east contains torso, arms, legs.
+// Pinned m54_55 loc coordinates were reconstructed from cache/map notes.
+// Keep the dungeon requirement: no skipping the fight to collect parts.
+[oploc2,fenk_grave]
+if (%fenk_quest < ^fenk_hired | %fenk_unlocked_cavern = 0) {
+    mes("You have not yet earned access to these mausoleum graves.");
+    return;
+}
+if (inv_total(inv, spade) < 1) {
+    mes("You need a spade.");
+    return;
+}
+def_namedobj $part = null;
+if (loc_coord = 0_54_55_46_56) {
+    if (%fenk_torso = 1) {
+        mes("You have already delivered the torso.");
+        return;
+    }
+    $part = fenk_torso;
+} else if (loc_coord = 0_54_55_48_57) {
+    if (%fenk_arms = 1) {
+        mes("You have already delivered the arms.");
+        return;
+    }
+    $part = fenk_arms;
+} else if (loc_coord = 0_54_55_50_56) {
+    if (%fenk_legs = 1) {
+        mes("You have already delivered the legs.");
+        return;
+    }
+    $part = fenk_legs;
+} else {
+    mes("This grave appears to have been disturbed already.");
+    return;
+}
+if (inv_total(inv, $part) > 0 | inv_total(bank, $part) > 0) {
+    mes("You have already recovered this part.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    mes("Make room before disturbing the grave.");
+    return;
+}
+inv_add(inv, $part, 1);
+mes("You uncover an old wrapped body part and place it carefully in your pack.");
+
+// Map-confirmed memorial at m55_55 (56,6) is aligned with the
+// excavated underground chamber at m55_155 (56,6). The entrance uses
+// a *normal* item-on-location action with the assembled star amulet.
+// This prevents teleporting a player from any other generic grave.
+[oplocu,fenk_grave]
+if (loc_coord ! 0_55_55_56_6 | last_useitem ! fenk_star_amulet) {
+    ~displaymessage(^dm_default);
+    return;
+}
+if (%fenk_quest < ^fenk_hired | inv_total(inv, fenk_star_amulet) < 1) {
+    mes("You must be helping the doctor and carrying the matching amulet.");
+    return;
+}
+%fenk_coffin = 1;
+mes("The amulet fits a small recess. You push the memorial aside.");
+p_teleport(0_55_155_56_6);
+
+// Both cave exits are already implemented by the upstream generic
+// [oploc1,loc_1757] handler in ladders.rs2, which calls
+// climb_ladder(movecoord(coord(), 0, 0, -6400), true).
+// Do not add a competing trigger: this preserves normal collision/movement
+// and safely returns to the matching overworld tile for each cave exit.
diff --git a/scripts/quests/quest_fenkenstrain/scripts/fenk_journal.rs2 b/scripts/quests/quest_fenkenstrain/scripts/fenk_journal.rs2
new file mode 100644
index 0000000..cca7f47
--- /dev/null
+++ b/scripts/quests/quest_fenkenstrain/scripts/fenk_journal.rs2
@@ -0,0 +1,50 @@
+[if_button,questlist:creatureoffenkenstrain]
+def_string $text;
+
+if(%fenk_quest = ^fenk_not_started) {
+    $text = "@dbl@I can start this quest by reading the @dre@signpost@dbl@ in the middle of|@dre@Canifis@dbl@, then speaking to @dre@Dr Fenkenstrain@dbl@ at his castle|north east of the village.||@dbl@I must have completed @dre@Priest in Peril@dbl@ to begin.|@dbl@Later tasks need @dre@20 Crafting@dbl@ and @dre@25 Thieving@dbl@.|@dbl@A @dre@ghostspeak amulet@dbl@ will help me speak to the castle gardener.";
+} else if(%fenk_quest = ^fenk_hired) {
+    $text = "@str@I read the signpost in Canifis and was hired by Dr Fenkenstrain.||@dbl@Dr Fenkenstrain wants a head with a brain, a torso, arms and legs,|@dbl@plus a needle and five spools of thread to sew them together.||";
+    if(%fenk_head = 1) {
+        $text = append($text, "@str@I have given him the head and brain.|");
+    } else {
+        $text = append($text, "@dre@A head with a brain.|");
+    }
+    if(%fenk_torso = 1) {
+        $text = append($text, "@str@I have given him the torso.|");
+    } else {
+        $text = append($text, "@dre@A torso.|");
+    }
+    if(%fenk_arms = 1) {
+        $text = append($text, "@str@I have given him the arms.|");
+    } else {
+        $text = append($text, "@dre@A pair of arms.|");
+    }
+    if(%fenk_legs = 1) {
+        $text = append($text, "@str@I have given him the legs.|");
+    } else {
+        $text = append($text, "@dre@A pair of legs.|");
+    }
+    if(%fenk_needle = 1) {
+        $text = append($text, "@str@I have given him a needle.|");
+    } else {
+        $text = append($text, "@dre@A needle.|");
+    }
+    if(%fenk_threads_given >= ^fenk_threads_needed) {
+        $text = append($text, "@str@I have given him enough thread.|");
+    } else {
+        $text = append($text, "@dre@Five spools of thread.|");
+    }
+} else if(%fenk_quest = ^fenk_sewn) {
+    $text = "@str@I was hired by Dr Fenkenstrain and gave him all the parts.||@dbl@The body is sewn together, but it needs lightning to bring it|@dbl@to life. I must repair the @dre@lightning conductor@dbl@ on the castle roof.||@dbl@I need a mould made from a @dre@garden brush@dbl@ and three @dre@canes@dbl@,|@dbl@then a @dre@silver bar@dbl@ cast in that mould.";
+} else if(%fenk_quest = ^fenk_conductor_fixed) {
+    $text = "@str@I repaired the lightning conductor and the body came to life.||@dbl@I should speak to @dre@Dr Fenkenstrain@dbl@ again.";
+} else if(%fenk_quest = ^fenk_tower_key_given) {
+    $text = "@str@I repaired the lightning conductor and the body came to life.||@dbl@Dr Fenkenstrain says the creature attacked him and he locked it in|@dbl@the tower. He gave me the key. I should go and see it.";
+} else if(%fenk_quest = ^fenk_met_creature) {
+    $text = "@str@I spoke to the creature in the tower. It is Lord Rologarth, the|@str@true owner of the castle.||@dbl@He wants Dr Fenkenstrain's experiments stopped. Perhaps I can|@dbl@take something useful from the doctor without him noticing.";
+} else {
+    $text = "@str@I helped Dr Fenkenstrain build his creature.||@str@I discovered it was Lord Rologarth, and took Dr Fenkenstrain's|@str@ring of charos from him.||@red@QUEST COMPLETE!";
+}
+
+~quest_journal("Creature of Fenkenstrain", $text);
diff --git a/scripts/quests/quest_fenkenstrain/scripts/fenk_npcs.rs2 b/scripts/quests/quest_fenkenstrain/scripts/fenk_npcs.rs2
new file mode 100644
index 0000000..b4738dd
--- /dev/null
+++ b/scripts/quests/quest_fenkenstrain/scripts/fenk_npcs.rs2
@@ -0,0 +1,317 @@
+// Creature of Fenkenstrain: NPC handlers.
+// STATUS: COMPILED against pinned disposable 377; full player playthrough unverified. Dialogue is original wording (nothing copied from game transcripts).
+//
+// Script triggers resolve on the spawned NPC's own type (Player.getOpTrigger uses npc.type), and
+// m55_55.jm2 spawns the PARENT multinpc types (1668 fenk_fenkenstrain, 1669 fenk_fenkenstrain_in_tower,
+// 1671 fenk_creature, 1672 fenk_creature_released, 1667 fenk_gardener_multi_2), so handlers bind to those.
+// The visible *_model children are only used by the engine to validate ops.
+
+[proc,fenk_meets_requirements]()(boolean)
+// Priest in Peril permits reaching Canifis. The other 377-era
+// requirements are for later quest actions, not for taking the job.
+if (%priestperil < ^priestperil_complete) {
+    return(false);
+}
+return(true);
+
+// ---------------------------------------------------------------------------
+// Dr Fenkenstrain (castle, stages 0-7)
+// ---------------------------------------------------------------------------
+[opnpc1,fenk_fenkenstrain]
+~chatplayer("<p,quiz>Hello there.");
+switch_int (%fenk_quest) {
+    case ^fenk_not_started : @fenk_doctor_not_started;
+    case ^fenk_hired : @fenk_doctor_hired;
+    case ^fenk_sewn : @fenk_doctor_sewn;
+    case ^fenk_conductor_fixed : @fenk_doctor_conductor_fixed;
+    case ^fenk_tower_key_given : @fenk_doctor_key_given;
+    case default : @fenk_doctor_after_meeting; // stages 5-7 (stage 8 uses fenk_fenkenstrain_in_tower)
+}
+
+[label,fenk_doctor_not_started]
+if (%fenk_read_signpost = 0) {
+    ~chatnpc("<p,angry>I am in the middle of delicate work. Go away.");
+    return;
+}
+~chatnpc("<p,neutral>You have the look of someone who read my notice in the village.");
+if (~fenk_meets_requirements = false) {
+    ~chatnpc("<p,neutral>Before we can work together you must be able to travel safely through Morytania.");
+    ~mesbox("Complete Priest in Peril to begin this quest. The later tasks require 20 Crafting and 25 Thieving, and a ghostspeak amulet is useful.");
+    return;
+}
+~chatnpc("<p,happy>Excellent. I require a helper who is discreet, and who will not ask what the work is for.");
+def_int $option = ~p_choice2("I'll help you.", 1, "No thanks. This sounds unpleasant.", 2);
+if ($option = 2) {
+    ~chatplayer("<p,neutral>No thanks. This sounds unpleasant.");
+    ~chatnpc("<p,sad>Pity. My offer stands, should you find your nerve.");
+    return;
+}
+~chatplayer("<p,happy>I'll help you.");
+~chatnpc("<p,neutral>Splendid. I am building a man. I have the idea, the castle and the lightning. What I lack is the material.");
+~chatnpc("<p,neutral>I need a head with a brain still in it, a torso, a pair of arms and a pair of legs.");
+~chatnpc("<p,neutral>I also need a needle and five spools of strong thread to join them together.");
+~chatnpc("<p,neutral>Bring each part to me, and ask no questions about where you found it.");
+%fenk_quest = ^fenk_hired;
+~chatplayer("<p,shock>Right. Charming.");
+
+[label,fenk_doctor_hired]
+~chatnpc("<p,quiz>Have you brought what I asked for?");
+def_string $missing = "";
+if (%fenk_head = 0) {
+    $missing = append($missing, "a head with a brain|");
+}
+if (%fenk_torso = 0) {
+    $missing = append($missing, "a torso|");
+}
+if (%fenk_arms = 0) {
+    $missing = append($missing, "a pair of arms|");
+}
+if (%fenk_legs = 0) {
+    $missing = append($missing, "a pair of legs|");
+}
+if (%fenk_needle = 0) {
+    $missing = append($missing, "a needle|");
+}
+if (%fenk_threads_given < ^fenk_threads_needed) {
+    $missing = append($missing, "more thread (I have <tostring(%fenk_threads_given)> of <tostring(^fenk_threads_needed)> spools)|");
+}
+~chatplayer("<p,neutral>Not yet. What did you still need?");
+~mesbox("The doctor still needs:|<$missing>");
+~chatnpc("<p,neutral>Hand each item over when you have it.");
+
+// Handing over parts: use the item on the doctor.
+[opnpcu,fenk_fenkenstrain]
+if (%fenk_quest ! ^fenk_hired) {
+    ~displaymessage(^dm_default);
+    return;
+}
+switch_obj (last_useitem) {
+    case fenk_head_full :
+        // A forged or stale item-on-NPC packet is never a real hand-in.
+        if (%fenk_head = 1 | inv_total(inv, fenk_head_full) < 1) {
+            ~chatnpc("<p,neutral>I cannot use that item again.");
+            return;
+        }
+        inv_del(inv, fenk_head_full, 1);
+        %fenk_head = 1;
+        ~chatnpc("<p,happy>A head, and the brain is intact. Very good indeed.");
+    case fenk_torso :
+        // A forged or stale item-on-NPC packet is never a real hand-in.
+        if (%fenk_torso = 1 | inv_total(inv, fenk_torso) < 1) {
+            ~chatnpc("<p,neutral>I cannot use that item again.");
+            return;
+        }
+        inv_del(inv, fenk_torso, 1);
+        %fenk_torso = 1;
+        ~chatnpc("<p,happy>A fine torso. Set it with the others.");
+    case fenk_arms :
+        // A forged or stale item-on-NPC packet is never a real hand-in.
+        if (%fenk_arms = 1 | inv_total(inv, fenk_arms) < 1) {
+            ~chatnpc("<p,neutral>I cannot use that item again.");
+            return;
+        }
+        inv_del(inv, fenk_arms, 1);
+        %fenk_arms = 1;
+        ~chatnpc("<p,happy>Arms. Strong ones too.");
+    case fenk_legs :
+        // A forged or stale item-on-NPC packet is never a real hand-in.
+        if (%fenk_legs = 1 | inv_total(inv, fenk_legs) < 1) {
+            ~chatnpc("<p,neutral>I cannot use that item again.");
+            return;
+        }
+        inv_del(inv, fenk_legs, 1);
+        %fenk_legs = 1;
+        ~chatnpc("<p,happy>Legs. Now he can walk away from his critics.");
+    case needle :
+        if (%fenk_needle = 1) {
+            ~chatnpc("<p,neutral>I already have a needle, thank you.");
+            return;
+        }
+        if (inv_total(inv, needle) < 1) {
+            ~displaymessage(^dm_default);
+            return;
+        }
+        inv_del(inv, needle, 1);
+        %fenk_needle = 1;
+        ~chatnpc("<p,happy>A needle. Sharp. Just what I need.");
+    case thread :
+        if (%fenk_threads_given >= ^fenk_threads_needed) {
+            ~chatnpc("<p,neutral>I have all the thread I need.");
+            return;
+        }
+        def_int $wanted = sub(^fenk_threads_needed, %fenk_threads_given);
+        def_int $have = inv_total(inv, thread);
+        def_int $give = min($wanted, $have);
+        inv_del(inv, thread, $give);
+        %fenk_threads_given = calc(%fenk_threads_given + $give);
+        if (%fenk_threads_given >= ^fenk_threads_needed) {
+            ~chatnpc("<p,happy>That is enough thread.");
+        } else {
+            ~chatnpc("<p,neutral>Thank you. I still need more thread than that.");
+        }
+    case default :
+        ~displaymessage(^dm_default);
+        return;
+}
+@fenk_check_parts_complete;
+
+[label,fenk_check_parts_complete]
+if (%fenk_head = 0 | %fenk_torso = 0 | %fenk_arms = 0 | %fenk_legs = 0 | %fenk_needle = 0) {
+    return;
+}
+if (%fenk_threads_given < ^fenk_threads_needed) {
+    return;
+}
+~chatnpc("<p,happy>That is everything. Stand back while I work.");
+mes("Dr Fenkenstrain stitches the parts together with quick, careful stitches.");
+p_delay(2);
+%fenk_quest = ^fenk_sewn;
+~chatnpc("<p,neutral>The body is whole. What it needs now is lightning, and my lightning conductor on the roof is broken.");
+~chatnpc("<p,neutral>Repair it. You will need a mould from a garden brush and canes, then a silver bar cast in that mould.");
+~chatnpc("<p,neutral>The gardener left tools in the shed. Be careful in this place, it is not as empty as it looks.");
+
+[label,fenk_doctor_sewn]
+~chatnpc("<p,neutral>The conductor on the roof must be repaired before the storm breaks.");
+~chatplayer("<p,quiz>Remind me what I need?");
+~chatnpc("<p,neutral>A mould, made from a garden brush and three canes. Bind it with bronze wire, cast silver in it, and repair the conductor.");
+
+[label,fenk_doctor_conductor_fixed]
+~chatnpc("<p,shock>You did it! The lightning struck, and the creature moves!");
+~chatnpc("<p,angry>But it turned on me. I have shut it in the tower. Take this key, and see to it that it is calm.");
+if (inv_freespace(inv) < 1) {
+    ~chatnpc("<p,neutral>Your pack is full. Make some room and speak to me again.");
+    return;
+}
+inv_add(inv, fenk_tower_key, 1);
+%fenk_quest = ^fenk_tower_key_given;
+~objbox(fenk_tower_key, "The doctor gives you a key.", 250, 0, 0);
+
+[label,fenk_doctor_key_given]
+~chatnpc("<p,neutral>The creature is in the tower. Go and deal with it.");
+if (inv_total(inv, fenk_tower_key) = 0 & inv_total(bank, fenk_tower_key) = 0) {
+    ~chatplayer("<p,sad>I've lost the key.");
+    if (inv_freespace(inv) < 1) {
+        ~chatnpc("<p,neutral>Make some room in your pack first.");
+        return;
+    }
+    ~chatnpc("<p,angry>Careless. Here is another.");
+    inv_add(inv, fenk_tower_key, 1);
+    ~objbox(fenk_tower_key, "The doctor gives you another key.", 250, 0, 0);
+}
+
+[label,fenk_doctor_after_meeting]
+~chatnpc("<p,quiz>Have you dealt with my creature?");
+~chatplayer("<p,neutral>I've seen it.");
+~chatnpc("<p,neutral>Good. Do not let it out. Now, I must get back to my notes.");
+
+// ---------------------------------------------------------------------------
+// Pickpocketing the doctor finishes the quest. Success odds are a guess (UNVERIFIED).
+// ---------------------------------------------------------------------------
+[opnpc3,fenk_fenkenstrain]
+if (%fenk_quest ! ^fenk_met_creature) {
+    mes("You have no reason to rob Dr Fenkenstrain right now.");
+    return;
+}
+if (stat(thieving) < ^fenk_req_thieving) {
+    mes("You need 25 Thieving to steal the ring.");
+    return;
+}
+if (inv_freespace(inv) < 1) {
+    mes("You need a free inventory space to hold what you steal.");
+    return;
+}
+if (%stunned > map_clock) {
+    return;
+}
+mes("You attempt to pick the doctor's pocket.");
+p_delay(0);
+if (stat_random(thieving, 80, 220) = false) {
+    ~fail_pick_pocket(2, 8, "doctor's pocket");
+    return;
+}
+anim(human_pickpocket, 0);
+sound_synth(pick, 1, 0);
+mes("You pick the doctor's pocket.");
+queue(fenk_quest_complete, 0, 0);
+
+[queue,fenk_quest_complete]
+if (%fenk_quest ! ^fenk_met_creature) {
+    return;
+}
+%fenk_quest = ^fenk_complete;
+inv_add(inv, ring_of_charos, 1);
+session_log(^log_adventure, "Quest complete: Creature of Fenkenstrain");
+~send_quest_complete(questlist:creatureoffenkenstrain, ring_of_charos, 250, ^fenk_questpoints, "You have completed the\\nCreature of Fenkenstrain Quest!", "2 Quest points|1,000 Thieving XP|A Ring of Charos");
+stat_advance(thieving, ^fenk_thieving_xp);
+
+// ---------------------------------------------------------------------------
+// Dr Fenkenstrain (tower, stage 8 only)
+// ---------------------------------------------------------------------------
+[opnpc1,fenk_fenkenstrain_in_tower]
+~chatplayer("<p,quiz>Doctor?");
+~chatnpc("<p,sad>Leave me be. You have already taken enough from me.");
+
+[opnpc3,fenk_fenkenstrain_in_tower]
+mes("You have already taken everything of value from the doctor.");
+
+// ---------------------------------------------------------------------------
+// The creature (tower)
+// ---------------------------------------------------------------------------
+[opnpc1,fenk_creature]
+if (%fenk_quest < ^fenk_tower_key_given) {
+    mes("The creature growls and ignores you.");
+    return;
+}
+if (%fenk_quest = ^fenk_tower_key_given) {
+    ~chatplayer("<p,neutral>Hello. Are you all right?");
+    ~chatnpc("<p,sad>I am not what he made me to be.");
+    ~chatplayer("<p,quiz>What do you mean?");
+    ~chatnpc("<p,neutral>I am Lord Rologarth. This castle was mine, before the doctor stitched my remains into this shape.");
+    ~chatplayer("<p,shock>Lord Rologarth? He built you from the dead lord of the castle?");
+    ~chatnpc("<p,angry>He did. I only want his experiments stopped, and my home returned.");
+    ~chatnpc("<p,neutral>Take something from him. Something he values. Then I will have my chance.");
+    %fenk_quest = ^fenk_met_creature;
+    return;
+}
+~chatplayer("<p,neutral>How are you holding up?");
+~chatnpc("<p,neutral>Patient. Do what you must to stop him. He keeps a ring on him that he values.");
+
+// After the quest: Lord Rologarth, in the castle hall.
+[opnpc1,fenk_creature_released]
+~chatplayer("<p,happy>You look more at home, Lord Rologarth.");
+~chatnpc("<p,happy>It is good to walk my own halls again. I owe you my thanks.");
+
+// ---------------------------------------------------------------------------
+// Gardener Ghost: only understood while wearing the amulet of ghostspeak.
+// fenk_gardener_multi (1666) and fenk_gardener_multi_2 (1667) differ only by fenk_gardener_directions state.
+// ---------------------------------------------------------------------------
+[opnpc1,fenk_gardener_multi]
+@fenk_gardener_talk;
+
+[opnpc1,fenk_gardener_multi_2]
+@fenk_gardener_talk;
+
+[label,fenk_gardener_talk]
+if (inv_total(worn, amulet_of_ghostspeak) = 0) {
+    mes("The ghost wails and moans, but you cannot understand a word he says.");
+    return;
+}
+~chatplayer("<p,neutral>Hello. Are you the gardener?");
+~chatnpc("<p,sad>I was. Now I only drift about the garden, with nothing left to dig up.");
+~chatplayer("<p,quiz>Do you know anything about the doctor?");
+~chatnpc("<p,neutral>He is not a gentleman. He has been busy in the graveyard beyond the castle, and not with flowers.");
+%fenk_spoken_to_gardener = 1;
+if (%fenk_quest >= ^fenk_sewn & %fenk_unlocked_shed = 0) {
+    if (inv_total(inv, fenk_shed_key) > 0 | inv_total(bank, fenk_shed_key) > 0) {
+        ~chatnpc("<p,neutral>Keep the shed key safe. You will need it for the doctor's repairs.");
+    } else if (inv_freespace(inv) < 1) {
+        ~chatnpc("<p,neutral>Make some room, and I will give you my old shed key.");
+    } else {
+        ~chatnpc("<p,neutral>The garden shed key is mine. Use it to find the tools you need.");
+        inv_add(inv, fenk_shed_key, 1);
+        ~objbox(fenk_shed_key, "The ghost gives you the shed key.", 250, 0, 0);
+    }
+}
+// TODO(unverified): the cache has a fenk_gardener_directions varbit (flags bit 31) that morphs the gardener
+// between fenk_gardener_multi and fenk_gardener_multi_2. What toggles it, and what directions he gives,
+// has not been reconstructed.
