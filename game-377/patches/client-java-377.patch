+	public static int[] toOverworldMapCoord(int x, int z) {
+		if (x >= 2368 && x <= 2559 && z >= 5056 && z <= 5183) {
+			return new int[] { 2856, 3168, 1 };
+		}
+		if (x >= 2240 && x <= 2303 && z >= 4672 && z <= 4735) {
+			return new int[] { 3017, 3849, 1 };
+		}
+		if (x >= 2500 && x <= 2559 && z >= 4680 && z <= 4735) {
+			return new int[] { 3091, 3956, 1 };
+		}
+		if (z >= 9000) {
+			return new int[] { x, z - 6400, 1 };
+		}
+		return new int[] { x, z, 0 };
+	}
