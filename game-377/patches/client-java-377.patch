+	public void requestTeleport(Destination dest, boolean forceConfirmed) {
+		if (dest == null) {
+			return;
+		}
+		if (dest.dangerous && this.confirmDangerous && !forceConfirmed) {
+			this.pendingDangerousDestination = dest;
+			if (this.shell != null) {
+				this.shell.presentFrame();
+			}
+			return;
+		}
+
+		this.pendingDangerousDestination = null;
+		this.lastDestinationId = dest.id;
+		this.recentIds.remove(dest.id);
+		this.recentIds.add(0, dest.id);
+		while (this.recentIds.size() > 10) {
+			this.recentIds.remove(this.recentIds.size() - 1);
+		}
+
+		Client.queueCheatCommand("tele_dest " + dest.id + " confirm");
+		this.visible = false;
+		if (this.shell != null) {
+			if (this.shell.frame != null) {
+				this.shell.frame.updateToolbarState();
+			}
+			this.shell.saveDisplayPreferences();
+			this.shell.presentFrame();
+		}
+	}
