+	public void clampCenter() {
+		if (this.centerX < MAP_MIN_TILE_X) this.centerX = MAP_MIN_TILE_X;
+		if (this.centerX > MAP_MAX_TILE_X) this.centerX = MAP_MAX_TILE_X;
+		if (this.centerZ < MAP_MIN_TILE_Z) this.centerZ = MAP_MIN_TILE_Z;
+		if (this.centerZ > MAP_MAX_TILE_Z) this.centerZ = MAP_MAX_TILE_Z;
+	}
+
+	public void adjustZoom(double factor, int pivotScreenX, int pivotScreenY) {
+		double oldZoom = this.zoom;
+		double newZoom = oldZoom * factor;
+		if (newZoom < 0.35) newZoom = 0.35;
+		if (newZoom > 4.0) newZoom = 4.0;
+		if (Math.abs(newZoom - oldZoom) < 1e-4) {
+			return;
+		}
+
+		if (this.mapCanvasRect.contains(pivotScreenX, pivotScreenY)) {
+			double tileUnderCursorX = this.screenToTileX(pivotScreenX);
+			double tileUnderCursorZ = this.screenToTileZ(pivotScreenY);
+			this.zoom = newZoom;
+			double newTileUnderCursorX = this.screenToTileX(pivotScreenX);
+			double newTileUnderCursorZ = this.screenToTileZ(pivotScreenY);
+			this.centerX += (tileUnderCursorX - newTileUnderCursorX);
+			this.centerZ += (tileUnderCursorZ - newTileUnderCursorZ);
+		} else {
+			this.zoom = newZoom;
+		}
+		this.clampCenter();
+		if (this.shell != null) {
+			this.shell.saveDisplayPreferences();
+			this.shell.presentFrame();
+		}
+	}
+
+	public double screenToTileX(int screenX) {
+		double cx = this.mapCanvasRect.x + this.mapCanvasRect.width / 2.0;
+		double pxPerTile = TILE_PX * this.zoom;
+		return this.centerX + (screenX - cx) / pxPerTile;
+	}
+
+	public double screenToTileZ(int screenY) {
+		double cy = this.mapCanvasRect.y + this.mapCanvasRect.height / 2.0;
+		double pxPerTile = TILE_PX * this.zoom;
+		return this.centerZ - (screenY - cy) / pxPerTile;
+	}
+
+	public int tileToScreenX(double tileX) {
+		double cx = this.mapCanvasRect.x + this.mapCanvasRect.width / 2.0;
+		double pxPerTile = TILE_PX * this.zoom;
+		return (int) Math.round(cx + (tileX - this.centerX) * pxPerTile);
+	}
+
+	public int tileToScreenY(double tileZ) {
+		double cy = this.mapCanvasRect.y + this.mapCanvasRect.height / 2.0;
+		double pxPerTile = TILE_PX * this.zoom;
+		return (int) Math.round(cy - (tileZ - this.centerZ) * pxPerTile);
+	}
