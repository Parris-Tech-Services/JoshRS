+	// ---- Input Event Handlers ----
+
+	public boolean handleMousePressed(int x, int y, int button) {
+		if (!this.visible) {
+			return false;
+		}
+
+		for (int i = this.hitTargets.size() - 1; i >= 0; i--) {
+			HitTarget t = this.hitTargets.get(i);
+			if (t.bounds.contains(x, y)) {
+				this.executeHitAction(t.action, t.value);
+				return true;
+			}
+		}
+
+		if (this.mapCanvasRect.contains(x, y)) {
+			// Check if user clicked a destination marker on the map
+			Destination clickedMarker = this.findMarkerAt(x, y);
+			if (clickedMarker != null) {
+				long now = System.currentTimeMillis();
+				boolean isDoubleClick = clickedMarker.id.equals(this.lastClickedDestId) && (now - this.lastClickTime < 420L);
+				this.selectedDestination = clickedMarker;
+				this.lastClickedDestId = clickedMarker.id;
+				this.lastClickTime = now;
+				if (isDoubleClick || button == 3) {
+					this.requestTeleport(clickedMarker, false);
+				} else if (this.shell != null) {
+					this.shell.presentFrame();
+				}
+				return true;
+			}
+
+			// Otherwise start click-and-drag pan
+			this.dragging = true;
+			this.dragMoved = false;
+			this.dragStartScreenX = x;
+			this.dragStartScreenY = y;
+			this.dragStartCenterX = this.centerX;
+			this.dragStartCenterZ = this.centerZ;
+			return true;
+		}
+
+		return true;
+	}
+
+	public boolean handleMouseDragged(int x, int y) {
+		if (!this.visible) {
+			return false;
+		}
+		if (this.dragging) {
+			int dx = x - this.dragStartScreenX;
+			int dy = y - this.dragStartScreenY;
+			if (Math.abs(dx) > 2 || Math.abs(dy) > 2) {
+				this.dragMoved = true;
+			}
+			double pxPerTile = TILE_PX * this.zoom;
+			this.centerX = this.dragStartCenterX - dx / pxPerTile;
+			this.centerZ = this.dragStartCenterZ + dy / pxPerTile;
+			this.clampCenter();
+			if (this.shell != null) {
+				this.shell.presentFrame();
+			}
+		}
+		return true;
+	}
+
+	public boolean handleMouseReleased(int x, int y) {
+		if (!this.visible) {
+			return false;
+		}
+		if (this.dragging) {
+			this.dragging = false;
+			if (this.dragMoved && this.shell != null) {
+				this.shell.saveDisplayPreferences();
+			}
+		}
+		return true;
+	}
+
+	public boolean handleMouseMoved(int x, int y) {
+		if (!this.visible) {
+			return false;
+		}
+		Destination hovered = this.mapCanvasRect.contains(x, y) ? this.findMarkerAt(x, y) : null;
+		if (hovered != this.hoveredDestination) {
+			this.hoveredDestination = hovered;
+			if (this.shell != null) {
+				this.shell.presentFrame();
+			}
+		}
+		return true;
+	}
+
+	public boolean handleMouseWheel(int notches, int x, int y) {
+		if (!this.visible) {
+			return false;
+		}
+		if (this.sidebarListRect.contains(x, y)) {
+			this.sidebarScrollOffset = Math.max(0, this.sidebarScrollOffset + notches * 2);
+			if (this.shell != null) {
+				this.shell.presentFrame();
+			}
+			return true;
+		}
+		double factor = notches < 0 ? 1.22 : (1.0 / 1.22);
+		this.adjustZoom(factor, x, y);
+		return true;
+	}
+
+	public boolean handleKeyPressed(KeyEvent e) {
+		if (!this.visible) {
+			return false;
+		}
+		int code = e.getKeyCode();
+		char ch = e.getKeyChar();
+
+		if (code == KeyEvent.VK_ESCAPE) {
+			if (this.pendingDangerousDestination != null) {
+				this.pendingDangerousDestination = null;
+			} else if (!this.searchQuery.isEmpty()) {
+				this.searchQuery = "";
+				this.sidebarScrollOffset = 0;
+			} else {
+				this.setVisible(false);
+			}
+			if (this.shell != null) {
+				this.shell.presentFrame();
+			}
+			return true;
+		}
+
+		if (code == KeyEvent.VK_ENTER) {
+			if (this.pendingDangerousDestination != null) {
+				this.requestTeleport(this.pendingDangerousDestination, true);
+			} else if (this.selectedDestination != null) {
+				this.requestTeleport(this.selectedDestination, false);
+			}
+			return true;
+		}
+
+		if (code == KeyEvent.VK_BACK_SPACE) {
+			if (!this.searchQuery.isEmpty()) {
+				this.searchQuery = this.searchQuery.substring(0, this.searchQuery.length() - 1);
+				this.sidebarScrollOffset = 0;
+				List<Destination> filtered = this.getFilteredDestinations();
+				if (!filtered.isEmpty()) {
+					this.selectedDestination = filtered.get(0);
+					this.centerX = this.selectedDestination.mapX;
+					this.centerZ = this.selectedDestination.mapZ;
+					this.clampCenter();
+				}
+				if (this.shell != null) {
+					this.shell.presentFrame();
+				}
+			}
+			return true;
+		}
+
+		// Arrow keys pan the map
+		double panStep = 24.0 / this.zoom;
+		if (code == KeyEvent.VK_LEFT) {
+			this.centerX -= panStep;
+			this.clampCenter();
+			if (this.shell != null) this.shell.presentFrame();
+			return true;
+		} else if (code == KeyEvent.VK_RIGHT) {
+			this.centerX += panStep;
+			this.clampCenter();
+			if (this.shell != null) this.shell.presentFrame();
+			return true;
+		} else if (code == KeyEvent.VK_UP) {
+			this.centerZ += panStep;
+			this.clampCenter();
+			if (this.shell != null) this.shell.presentFrame();
+			return true;
+		} else if (code == KeyEvent.VK_DOWN) {
+			this.centerZ -= panStep;
+			this.clampCenter();
+			if (this.shell != null) this.shell.presentFrame();
+			return true;
+		}
+
+		if (ch >= 32 && ch < 127 && !e.isControlDown() && !e.isAltDown()) {
+			if (this.searchQuery.length() < 28) {
+				this.searchQuery += ch;
+				this.sidebarScrollOffset = 0;
+				List<Destination> filtered = this.getFilteredDestinations();
+				if (!filtered.isEmpty()) {
+					this.selectedDestination = filtered.get(0);
+					this.centerX = this.selectedDestination.mapX;
+					this.centerZ = this.selectedDestination.mapZ;
+					this.clampCenter();
+				}
+				if (this.shell != null) {
+					this.shell.presentFrame();
+				}
+			}
+			return true;
+		}
+
+		return true;
+	}
+
+	private Destination findMarkerAt(int screenX, int screenY) {
+		List<Destination> filtered = this.getFilteredDestinations();
+		Destination best = null;
+		double bestDistSq = 13.0 * 13.0;
+		for (int i = 0; i < filtered.size(); i++) {
+			Destination d = filtered.get(i);
+			int mx = this.tileToScreenX(d.mapX);
+			int my = this.tileToScreenY(d.mapZ);
+			double dx = screenX - mx;
+			double dy = screenY - my;
+			double dSq = dx * dx + dy * dy;
+			if (dSq <= bestDistSq) {
+				bestDistSq = dSq;
+				best = d;
+			}
+		}
+		return best;
+	}
+
+	private void executeHitAction(String action, String value) {
+		if ("CLOSE_MAP".equals(action)) {
+			this.setVisible(false);
+		} else if ("CLEAR_SEARCH".equals(action)) {
+			this.searchQuery = "";
+			this.sidebarScrollOffset = 0;
+		} else if ("SET_CATEGORY".equals(action)) {
+			this.categoryFilter = value;
+			this.sidebarScrollOffset = 0;
+			if (this.shell != null) this.shell.saveDisplayPreferences();
+		} else if ("CYCLE_REGION".equals(action)) {
+			int idx = 0;
+			for (int i = 0; i < REGIONS.length; i++) {
+				if (REGIONS[i].equals(this.regionFilter)) {
+					idx = (i + 1) % REGIONS.length;
+					break;
+				}
+			}
+			this.regionFilter = REGIONS[idx];
+			this.sidebarScrollOffset = 0;
+			if (this.shell != null) this.shell.saveDisplayPreferences();
+		} else if ("SELECT_DEST".equals(action)) {
+			Destination d = getDestinationById(value);
+			if (d != null) {
+				long now = System.currentTimeMillis();
+				boolean isDouble = d.id.equals(this.lastClickedDestId) && (now - this.lastClickTime < 420L);
+				this.selectedDestination = d;
+				this.centerX = d.mapX;
+				this.centerZ = d.mapZ;
+				this.clampCenter();
+				this.lastClickedDestId = d.id;
+				this.lastClickTime = now;
+				if (isDouble) {
+					this.requestTeleport(d, false);
+					return;
+				}
+			}
+		} else if ("TOGGLE_FAV".equals(action)) {
+			this.toggleFavourite(value);
+			return;
+		} else if ("TELEPORT_NOW".equals(action)) {
+			Destination d = getDestinationById(value);
+			if (d != null) {
+				this.requestTeleport(d, false);
+				return;
+			}
+		} else if ("CONFIRM_DANGEROUS".equals(action)) {
+			if (this.pendingDangerousDestination != null) {
+				this.requestTeleport(this.pendingDangerousDestination, true);
+				return;
+			}
+		} else if ("CANCEL_DANGEROUS".equals(action)) {
+			this.pendingDangerousDestination = null;
+		} else if ("QUICK_HUB".equals(action)) {
+			Destination hub = getDestinationById("varrock_portal_hub");
+			this.requestTeleport(hub, true);
+			return;
+		} else if ("QUICK_VARROCK".equals(action)) {
+			Destination varrock = getDestinationById("varrock");
+			this.requestTeleport(varrock, true);
+			return;
+		} else if ("QUICK_LAST".equals(action)) {
+			Destination last = getDestinationById(this.lastDestinationId);
+			if (last != null) {
+				this.requestTeleport(last, false);
+				return;
+			}
+		} else if ("QUICK_BACK".equals(action)) {
+			Client.queueCheatCommand("back");
+			this.setVisible(false);
+			return;
+		} else if ("CENTER_PLAYER".equals(action)) {
+			this.centerOnPlayer();
+		} else if ("ZOOM_IN".equals(action)) {
+			this.adjustZoom(1.3, this.mapCanvasRect.x + this.mapCanvasRect.width / 2, this.mapCanvasRect.y + this.mapCanvasRect.height / 2);
+			return;
+		} else if ("ZOOM_OUT".equals(action)) {
+			this.adjustZoom(1.0 / 1.3, this.mapCanvasRect.x + this.mapCanvasRect.width / 2, this.mapCanvasRect.y + this.mapCanvasRect.height / 2);
+			return;
+		} else if ("ZOOM_RESET".equals(action)) {
+			this.zoom = 1.0;
+			if (this.shell != null) this.shell.saveDisplayPreferences();
+		} else if ("TOGGLE_LABELS".equals(action)) {
+			this.showLabels = !this.showLabels;
+			if (this.shell != null) this.shell.saveDisplayPreferences();
+		} else if ("TOGGLE_CONFIRM".equals(action)) {
+			this.confirmDangerous = !this.confirmDangerous;
+			if (this.shell != null) this.shell.saveDisplayPreferences();
+		} else if ("SCROLL_UP".equals(action)) {
+			this.sidebarScrollOffset = Math.max(0, this.sidebarScrollOffset - 4);
+		} else if ("SCROLL_DOWN".equals(action)) {
+			this.sidebarScrollOffset += 4;
+		}
+
+		if (this.shell != null) {
+			this.shell.presentFrame();
+		}
+	}
