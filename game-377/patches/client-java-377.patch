+	private int drawHeaderButton(Graphics2D g, int x, int y, int maxX, String label, String action, Color bg) {
+		g.setFont(new Font("SansSerif", Font.BOLD, 11));
+		FontMetrics fm = g.getFontMetrics();
+		int w = fm.stringWidth(label) + 14;
+		int h = 26;
+		if (x + w < maxX) {
+			this.drawButtonBox(g, x, y, w, h, label, bg, new Color(240, 224, 185));
+			this.hitTargets.add(new HitTarget(action, "", x, y, w, h));
+		}
+		return x + w + 5;
+	}
+
+	private void drawButtonBox(Graphics2D g, int x, int y, int w, int h, String label, Color bg, Color fg) {
+		g.setColor(bg);
+		g.fillRoundRect(x, y, w, h, 6, 6);
+		g.setColor(new Color(130, 110, 74));
+		g.drawRoundRect(x, y, w, h, 6, 6);
+		g.setFont(new Font("SansSerif", Font.BOLD, 11));
+		FontMetrics fm = g.getFontMetrics();
+		g.setColor(fg);
+		g.drawString(label, x + (w - fm.stringWidth(label)) / 2, y + (h + fm.getAscent() - fm.getDescent()) / 2);
+	}
+
+	private void renderSidebar(Graphics2D g, int x, int y, int w, int h) {
+		g.setColor(new Color(30, 25, 19));
+		g.fillRect(x, y, w, h);
+		g.setColor(new Color(102, 85, 56));
+		g.drawLine(x + w - 1, y, x + w - 1, y + h);
+
+		int pad = 8;
+		int curY = y + pad;
+
+		// Search Box
+		int searchH = 28;
+		g.setColor(new Color(18, 15, 11));
+		g.fillRoundRect(x + pad, curY, w - pad * 2, searchH, 6, 6);
+		g.setColor(new Color(150, 125, 78));
+		g.drawRoundRect(x + pad, curY, w - pad * 2, searchH, 6, 6);
+
+		g.setFont(new Font("SansSerif", Font.PLAIN, 12));
+		if (this.searchQuery.isEmpty()) {
+			g.setColor(new Color(145, 132, 108));
+			g.drawString("Search towns, guilds, bosses... (type)", x + pad + 8, curY + 19);
+		} else {
+			g.setColor(new Color(255, 235, 175));
+			g.drawString(this.searchQuery + "|", x + pad + 8, curY + 19);
+			int clearX = x + w - pad - 22;
+			g.setColor(new Color(190, 90, 80));
+			g.drawString("X", clearX + 5, curY + 19);
+			this.hitTargets.add(new HitTarget("CLEAR_SEARCH", "", clearX, curY, 22, searchH));
+		}
+		curY += searchH + 6;
+
+		// Region Filter Selector
+		int regH = 24;
+		this.drawButtonBox(g, x + pad, curY, w - pad * 2, regH, "Region: " + this.regionFilter + " (click)", new Color(46, 39, 29), new Color(225, 208, 165));
+		this.hitTargets.add(new HitTarget("CYCLE_REGION", "", x + pad, curY, w - pad * 2, regH));
+		curY += regH + 6;
+
+		// Category Tabs (2 rows of 4)
+		int cols = 4;
+		int tabW = (w - pad * 2 - (cols - 1) * 4) / cols;
+		int tabH = 22;
+		for (int i = 0; i < CATEGORIES.length; i++) {
+			String cat = CATEGORIES[i];
+			int row = i / cols;
+			int col = i % cols;
+			int tx = x + pad + col * (tabW + 4);
+			int ty = curY + row * (tabH + 4);
+			boolean active = cat.equalsIgnoreCase(this.categoryFilter);
+			this.drawButtonBox(
+				g,
+				tx,
+				ty,
+				tabW,
+				tabH,
+				cat,
+				active ? new Color(128, 42, 28) : new Color(44, 37, 28),
+				active ? new Color(255, 235, 175) : new Color(205, 190, 155)
+			);
+			this.hitTargets.add(new HitTarget("SET_CATEGORY", cat, tx, ty, tabW, tabH));
+		}
+		curY += (tabH + 4) * 2 + 4;
+
+		// Destination List Header
+		List<Destination> filtered = this.getFilteredDestinations();
+		g.setFont(new Font("SansSerif", Font.BOLD, 11));
+		g.setColor(new Color(185, 168, 130));
+		g.drawString("Destinations (" + filtered.size() + ")", x + pad, curY + 12);
+
+		// Up / Down scroll buttons
+		int sbW = 24;
+		this.drawButtonBox(g, x + w - pad - sbW * 2 - 4, curY - 2, sbW, 18, "^", new Color(45, 38, 29), new Color(230, 210, 165));
+		this.hitTargets.add(new HitTarget("SCROLL_UP", "", x + w - pad - sbW * 2 - 4, curY - 2, sbW, 18));
+		this.drawButtonBox(g, x + w - pad - sbW, curY - 2, sbW, 18, "v", new Color(45, 38, 29), new Color(230, 210, 165));
+		this.hitTargets.add(new HitTarget("SCROLL_DOWN", "", x + w - pad - sbW, curY - 2, sbW, 18));
+		curY += 20;
+
+		int listH = y + h - curY - 6;
+		this.sidebarListRect = new Rectangle(x + pad, curY, w - pad * 2, listH);
+		int rowH = 30;
+		int maxVisibleRows = Math.max(1, listH / rowH);
+		if (this.sidebarScrollOffset > Math.max(0, filtered.size() - maxVisibleRows)) {
+			this.sidebarScrollOffset = Math.max(0, filtered.size() - maxVisibleRows);
+		}
+
+		for (int i = 0; i < maxVisibleRows && (i + this.sidebarScrollOffset) < filtered.size(); i++) {
+			Destination d = filtered.get(i + this.sidebarScrollOffset);
+			int ry = curY + i * rowH;
+			boolean isSel = this.selectedDestination != null && this.selectedDestination.id.equals(d.id);
+
+			g.setColor(isSel ? new Color(76, 58, 34) : (i % 2 == 0 ? new Color(36, 30, 23) : new Color(31, 26, 20)));
+			g.fillRoundRect(x + pad, ry, w - pad * 2, rowH - 2, 5, 5);
+			if (isSel) {
+				g.setColor(new Color(215, 175, 85));
+				g.drawRoundRect(x + pad, ry, w - pad * 2, rowH - 2, 5, 5);
+			}
+
+			// Favourite star toggle
+			boolean isFav = this.favourites.contains(d.id);
+			g.setFont(new Font("SansSerif", Font.BOLD, 13));
+			g.setColor(isFav ? new Color(255, 210, 60) : new Color(105, 95, 75));
+			g.drawString(isFav ? "★" : "☆", x + pad + 6, ry + 19);
+			this.hitTargets.add(new HitTarget("TOGGLE_FAV", d.id, x + pad + 2, ry, 22, rowH - 2));
+
+			// Destination Name + Region
+			g.setFont(new Font("SansSerif", Font.BOLD, 12));
+			g.setColor(d.dangerous ? new Color(255, 130, 110) : new Color(242, 228, 190));
+			g.drawString(d.name, x + pad + 24, ry + 14);
+
+			g.setFont(new Font("SansSerif", Font.PLAIN, 10));
+			g.setColor(new Color(165, 150, 120));
+			g.drawString(d.region + " • " + d.category + (d.dangerous ? " • RISK" : ""), x + pad + 24, ry + 25);
+
+			// Quick Go button on row
+			int goW = 34;
+			int goX = x + w - pad - goW - 4;
+			this.drawButtonBox(g, goX, ry + 4, goW, rowH - 10, "Go", new Color(38, 92, 52), new Color(235, 255, 225));
+			this.hitTargets.add(new HitTarget("TELEPORT_NOW", d.id, goX, ry + 4, goW, rowH - 10));
+
+			this.hitTargets.add(new HitTarget("SELECT_DEST", d.id, x + pad + 24, ry, w - pad * 2 - 24 - goW - 6, rowH - 2));
+		}
+	}
