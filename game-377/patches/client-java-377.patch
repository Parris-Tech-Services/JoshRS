+	private static String joinSet(Set<String> set) {
+		StringBuilder sb = new StringBuilder();
+		for (String s : set) {
+			if (sb.length() > 0) sb.append(",");
+			sb.append(s);
+		}
+		return sb.toString();
+	}
+
+	private static String joinList(List<String> list) {
+		StringBuilder sb = new StringBuilder();
+		for (int i = 0; i < list.size(); i++) {
+			if (i > 0) sb.append(",");
+			sb.append(list.get(i));
+		}
+		return sb.toString();
+	}
