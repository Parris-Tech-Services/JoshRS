+	// ---- Rendering ----
+
+	public void render(Graphics2D g, int width, int height) {
+		this.hitTargets.clear();
+		g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+		g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
+
+		int headerH = 42;
+		int sidebarW = Math.max(225, Math.min(310, width * 30 / 100));
+		this.mapCanvasRect = new Rectangle(sidebarW, headerH, Math.max(100, width - sidebarW), Math.max(100, height - headerH));
+
+		// 1. Header Bar (OSRS/RS2 Stone & Gold Trim)
+		g.setPaint(new GradientPaint(0, 0, new Color(46, 39, 29), 0, headerH, new Color(28, 23, 17)));
+		g.fillRect(0, 0, width, headerH);
+		g.setColor(new Color(118, 98, 64));
+		g.drawLine(0, headerH - 1, width, headerH - 1);
+
+		boolean compactHeader = width <= 840;
+		g.setFont(new Font("SansSerif", Font.BOLD, compactHeader ? 13 : 14));
+		g.setColor(new Color(255, 215, 110));
+		g.drawString(compactHeader ? "GIELINOR MAP & TELEPORTS" : "GIELINOR WORLD MAP & FAST TRAVEL", 10, 26);
+
+		// Header Quick Controls
+		int bx = sidebarW + 6;
+		int maxHeaderX = width - 76;
+		bx = this.drawHeaderButton(g, bx, 8, maxHeaderX, compactHeader ? "Hub" : "Portal Hub", "QUICK_HUB", new Color(42, 92, 85));
+		bx = this.drawHeaderButton(g, bx, 8, maxHeaderX, "Varrock", "QUICK_VARROCK", new Color(55, 48, 36));
+		bx = this.drawHeaderButton(g, bx, 8, maxHeaderX, compactHeader ? "Last" : "Last Dest", "QUICK_LAST", new Color(55, 48, 36));
+		bx = this.drawHeaderButton(g, bx, 8, maxHeaderX, compactHeader ? "Back" : "Return Prev", "QUICK_BACK", new Color(55, 48, 36));
+		bx = this.drawHeaderButton(g, bx, 8, maxHeaderX, compactHeader ? "Center" : "Center Me", "CENTER_PLAYER", new Color(44, 68, 95));
+		bx = this.drawHeaderButton(g, bx, 8, maxHeaderX, "Labels: " + (this.showLabels ? "ON" : "OFF"), "TOGGLE_LABELS", new Color(55, 48, 36));
+		bx = this.drawHeaderButton(g, bx, 8, maxHeaderX, (compactHeader ? "Risks: " : "Risk Warn: ") + (this.confirmDangerous ? "ON" : "OFF"), "TOGGLE_CONFIRM", new Color(55, 48, 36));
+
+		// Close button at top-right
+		int closeW = 68;
+		int closeX = width - closeW - 8;
+		this.drawButtonBox(g, closeX, 7, closeW, 27, "Close (M)", new Color(135, 34, 28), new Color(255, 230, 190));
+		this.hitTargets.add(new HitTarget("CLOSE_MAP", "", closeX, 7, closeW, 27));
+
+		// 2. Left Sidebar (Search, Region selector, Category tabs, Destination list)
+		this.renderSidebar(g, 0, headerH, sidebarW, height - headerH);
+
+		// 3. Map Viewport
+		this.renderMapViewport(g, this.mapCanvasRect);
+
+		// 4. Dangerous Teleport Confirmation Modal (if active)
+		if (this.pendingDangerousDestination != null) {
+			this.renderDangerousModal(g, width, height, this.pendingDangerousDestination);
+		}
+	}
