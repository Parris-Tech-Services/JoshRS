+	private void renderMapViewport(Graphics2D g, Rectangle rect) {
+		Shape oldClip = g.getClip();
+		g.setClip(rect.x, rect.y, rect.width, rect.height);
+
+		// Ocean backdrop
+		g.setColor(new Color(0x1d, 0x31, 0x4d));
+		g.fillRect(rect.x, rect.y, rect.width, rect.height);
+
+		// Draw #377 World Map Image
+		if (this.mapImage != null) {
+			int x0 = this.tileToScreenX(MAP_MIN_TILE_X);
+			int y0 = this.tileToScreenY(MAP_MAX_TILE_Z + 1);
+			int drawW = (int) Math.round(TILES_W * TILE_PX * this.zoom);
+			int drawH = (int) Math.round(TILES_H * TILE_PX * this.zoom);
+			g.setRenderingHint(
+				RenderingHints.KEY_INTERPOLATION,
+				this.zoom < 1.0 ? RenderingHints.VALUE_INTERPOLATION_BILINEAR : RenderingHints.VALUE_INTERPOLATION_NEAREST_NEIGHBOR
+			);
+			g.drawImage(this.mapImage, x0, y0, drawW, drawH, null);
+		}
+
+		// Draw Authentic #377 Map Labels
+		if (this.showLabels) {
+			for (int i = 0; i < LABELS.size(); i++) {
+				MapLabel lbl = LABELS.get(i);
+				if (lbl.tier == 0 && this.zoom < 0.85) {
+					continue;
+				}
+				int lx = this.tileToScreenX(lbl.tileX);
+				int ly = this.tileToScreenY(lbl.tileZ);
+				if (lx < rect.x - 80 || lx > rect.x + rect.width + 80 || ly < rect.y - 40 || ly > rect.y + rect.height + 40) {
+					continue;
+				}
+
+				Font font = lbl.tier == 2
+					? new Font("Serif", Font.BOLD, 14)
+					: (lbl.tier == 1 ? new Font("SansSerif", Font.BOLD, 11) : new Font("SansSerif", Font.PLAIN, 10));
+				Color color = lbl.tier == 2
+					? new Color(255, 220, 115)
+					: (lbl.tier == 1 ? new Color(255, 255, 240) : new Color(220, 215, 195));
+
+				g.setFont(font);
+				FontMetrics fm = g.getFontMetrics();
+				String[] lines = lbl.text.split("/");
+				for (int lineIdx = 0; lineIdx < lines.length; lineIdx++) {
+					String line = lines[lineIdx];
+					int tw = fm.stringWidth(line);
+					int tx = lx - tw / 2;
+					int ty = ly + (lineIdx * 11) - ((lines.length - 1) * 5);
+					g.setColor(Color.BLACK);
+					g.drawString(line, tx + 1, ty + 1);
+					g.drawString(line, tx - 1, ty - 1);
+					g.setColor(color);
+					g.drawString(line, tx, ty);
+				}
+			}
+		}
+
+		// Draw Teleport Destination Markers
+		List<Destination> visibleDests = this.getFilteredDestinations();
+		for (int i = 0; i < visibleDests.size(); i++) {
+			Destination d = visibleDests.get(i);
+			int mx = this.tileToScreenX(d.mapX);
+			int my = this.tileToScreenY(d.mapZ);
+			if (mx < rect.x - 20 || mx > rect.x + rect.width + 20 || my < rect.y - 20 || my > rect.y + rect.height + 20) {
+				continue;
+			}
+
+			boolean isSel = this.selectedDestination != null && this.selectedDestination.id.equals(d.id);
+			boolean isHov = this.hoveredDestination != null && this.hoveredDestination.id.equals(d.id);
+			boolean isFav = this.favourites.contains(d.id);
+
+			int radius = isSel || isHov ? 8 : 6;
+			Color fill = d.dangerous
+				? new Color(220, 55, 45)
+				: ("Cities".equals(d.category) ? new Color(45, 175, 235)
+					: ("Guilds".equals(d.category) ? new Color(180, 110, 245) : new Color(65, 205, 105)));
+
+			if (isSel) {
+				g.setColor(new Color(255, 230, 90, 110));
+				g.fillOval(mx - radius - 5, my - radius - 5, (radius + 5) * 2, (radius + 5) * 2);
+			}
+
+			g.setColor(Color.BLACK);
+			g.fillOval(mx - radius - 1, my - radius - 1, (radius + 1) * 2, (radius + 1) * 2);
+			g.setColor(fill);
+			g.fillOval(mx - radius, my - radius, radius * 2, radius * 2);
+			g.setColor(isSel || isFav ? new Color(255, 225, 80) : Color.WHITE);
+			g.drawOval(mx - radius, my - radius, radius * 2, radius * 2);
+
+			// Inner nexus dot
+			g.fillOval(mx - 2, my - 2, 4, 4);
+		}
+
+		// Draw Live Player Marker
+		int[] playerPos = Client.getActivePlayerPosition();
+		if (playerPos != null && playerPos[0] > 0 && playerPos[1] > 0) {
+			int[] mapped = toOverworldMapCoord(playerPos[0], playerPos[1]);
+			int px = this.tileToScreenX(mapped[0]);
+			int py = this.tileToScreenY(mapped[1]);
+			int pulse = (int) ((System.currentTimeMillis() / 120L) % 6L);
+
+			g.setColor(new Color(0, 255, 140, 120));
+			g.fillOval(px - 8 - pulse, py - 8 - pulse, (8 + pulse) * 2, (8 + pulse) * 2);
+			g.setColor(Color.BLACK);
+			g.fillOval(px - 6, py - 6, 12, 12);
+			g.setColor(new Color(40, 255, 120));
+			g.fillOval(px - 5, py - 5, 10, 10);
+			g.setColor(Color.WHITE);
+			g.drawOval(px - 5, py - 5, 10, 10);
+
+			g.setFont(new Font("SansSerif", Font.BOLD, 11));
+			String youLabel = "YOU (" + playerPos[0] + ", " + playerPos[1] + (mapped[2] == 1 ? " Cave" : "") + ")";
+			g.setColor(Color.BLACK);
+			g.drawString(youLabel, px + 9, py + 5);
+			g.setColor(new Color(120, 255, 165));
+			g.drawString(youLabel, px + 8, py + 4);
+		}
+
+		// Zoom Overlay Controls (top-right of map viewport)
+		int zx = rect.x + rect.width - 138;
+		int zy = rect.y + 10;
+		this.drawButtonBox(g, zx, zy, 36, 26, "+", new Color(38, 32, 24), new Color(245, 225, 175));
+		this.hitTargets.add(new HitTarget("ZOOM_IN", "", zx, zy, 36, 26));
+		this.drawButtonBox(g, zx + 40, zy, 36, 26, "-", new Color(38, 32, 24), new Color(245, 225, 175));
+		this.hitTargets.add(new HitTarget("ZOOM_OUT", "", zx + 40, zy, 36, 26));
+		String zoomPct = (int) Math.round(this.zoom * 100) + "%";
+		this.drawButtonBox(g, zx + 80, zy, 48, 26, zoomPct, new Color(38, 32, 24), new Color(245, 225, 175));
+		this.hitTargets.add(new HitTarget("ZOOM_RESET", "", zx + 80, zy, 48, 26));
+
+		// Selected Destination Details Card (bottom-right of map viewport)
+		Destination cardDest = this.hoveredDestination != null ? this.hoveredDestination : this.selectedDestination;
+		if (cardDest != null) {
+			this.renderDestinationCard(g, rect, cardDest);
+		}
+
+		g.setClip(oldClip);
+	}
+
+	private void renderDestinationCard(Graphics2D g, Rectangle mapRect, Destination d) {
+		int cardW = Math.min(370, mapRect.width - 20);
+		int cardH = d.dangerous ? 118 : 98;
+		int cx = mapRect.x + mapRect.width - cardW - 12;
+		int cy = mapRect.y + mapRect.height - cardH - 12;
+
+		g.setColor(new Color(24, 20, 15, 238));
+		g.fillRoundRect(cx, cy, cardW, cardH, 10, 10);
+		g.setColor(d.dangerous ? new Color(205, 70, 55) : new Color(155, 130, 80));
+		g.drawRoundRect(cx, cy, cardW, cardH, 10, 10);
+
+		g.setFont(new Font("SansSerif", Font.BOLD, 14));
+		g.setColor(new Color(255, 220, 120));
+		g.drawString(d.name, cx + 12, cy + 22);
+
+		g.setFont(new Font("SansSerif", Font.PLAIN, 11));
+		g.setColor(new Color(185, 172, 140));
+		g.drawString(d.region + " • " + d.category + " • Tile (" + d.x + ", " + d.z + ", " + d.level + ")", cx + 12, cy + 38);
+
+		g.setColor(new Color(228, 218, 195));
+		String desc = d.description;
+		if (desc.length() > 56) {
+			desc = desc.substring(0, 54) + "...";
+		}
+		g.drawString(desc, cx + 12, cy + 55);
+
+		if (d.dangerous && d.riskWarning != null) {
+			g.setFont(new Font("SansSerif", Font.BOLD, 10));
+			g.setColor(new Color(255, 120, 105));
+			String warn = "⚠ " + d.riskWarning;
+			if (warn.length() > 60) {
+				warn = warn.substring(0, 58) + "...";
+			}
+			g.drawString(warn, cx + 12, cy + 72);
+		}
+
+		int btnY = cy + cardH - 32;
+		boolean isFav = this.favourites.contains(d.id);
+		this.drawButtonBox(
+			g,
+			cx + 12,
+			btnY,
+			96,
+			24,
+			isFav ? "★ Favourite" : "☆ Favourite",
+			new Color(52, 44, 32),
+			new Color(255, 215, 90)
+		);
+		this.hitTargets.add(new HitTarget("TOGGLE_FAV", d.id, cx + 12, btnY, 96, 24));
+
+		int teleW = cardW - 128;
+		this.drawButtonBox(
+			g,
+			cx + 116,
+			btnY,
+			teleW,
+			24,
+			"Teleport to " + d.name,
+			d.dangerous ? new Color(155, 42, 32) : new Color(38, 108, 56),
+			new Color(255, 245, 215)
+		);
+		this.hitTargets.add(new HitTarget("TELEPORT_NOW", d.id, cx + 116, btnY, teleW, 24));
+	}
+
+	private void renderDangerousModal(Graphics2D g, int width, int height, Destination d) {
+		g.setColor(new Color(0, 0, 0, 175));
+		g.fillRect(0, 0, width, height);
+
+		int mw = 420;
+		int mh = 175;
+		int mx = (width - mw) / 2;
+		int my = (height - mh) / 2;
+
+		g.setColor(new Color(34, 24, 20));
+		g.fillRoundRect(mx, my, mw, mh, 12, 12);
+		g.setColor(new Color(215, 75, 60));
