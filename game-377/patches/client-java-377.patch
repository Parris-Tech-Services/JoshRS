+	public List<Destination> getFilteredDestinations() {
+		List<Destination> result = new ArrayList<Destination>();
+		String q = this.searchQuery != null ? this.searchQuery.trim().toLowerCase() : "";
+
+		if ("Recent".equals(this.categoryFilter)) {
+			for (int i = 0; i < this.recentIds.size(); i++) {
+				Destination d = getDestinationById(this.recentIds.get(i));
+				if (d != null && matchesQueryAndRegion(d, q)) {
+					result.add(d);
+				}
+			}
+			return result;
+		}
+
+		for (int i = 0; i < DESTINATIONS.size(); i++) {
+			Destination d = DESTINATIONS.get(i);
+			if ("Favs".equals(this.categoryFilter)) {
+				if (!this.favourites.contains(d.id)) {
+					continue;
+				}
+			} else if (!"All".equals(this.categoryFilter)) {
+				if (!d.category.equalsIgnoreCase(this.categoryFilter)) {
+					continue;
+				}
+			}
+			if (matchesQueryAndRegion(d, q)) {
+				result.add(d);
+			}
+		}
+		return result;
+	}
+
+	private boolean matchesQueryAndRegion(Destination d, String q) {
+		if (!"All Regions".equals(this.regionFilter) && !d.region.equalsIgnoreCase(this.regionFilter)) {
+			return false;
+		}
+		if (q.isEmpty()) {
+			return true;
+		}
+		return d.name.toLowerCase().contains(q)
+			|| d.id.toLowerCase().contains(q)
+			|| d.region.toLowerCase().contains(q)
+			|| d.category.toLowerCase().contains(q)
+			|| d.description.toLowerCase().contains(q);
+	}
