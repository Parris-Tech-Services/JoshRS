+	public static Destination getDestinationById(String id) {
+		if (id == null) return null;
+		for (int i = 0; i < DESTINATIONS.size(); i++) {
+			Destination d = DESTINATIONS.get(i);
+			if (d.id.equalsIgnoreCase(id)) {
+				return d;
