diff --git a/scripts/areas/area_varrock/scripts/teleport_hub.rs2 b/scripts/areas/area_varrock/scripts/teleport_hub.rs2
new file mode 100644
index 000000000..7ef0ae266
--- /dev/null
+++ b/scripts/areas/area_varrock/scripts/teleport_hub.rs2
@@ -0,0 +1,190 @@
+// Gielinor Teleport Portal Hub (Varrock North Plaza) & Teleport Guide
+
+[proc,hub_teleport_to](coord $dest, string $name)
+if_close;
+p_stopaction;
+if (~wilderness_level(coord) > 20 & staffmodlevel < 2) {
+    mes("A mysterious force blocks your teleport beyond level 20 Wilderness!");
+    return;
+}
+sound_synth(teleport_all, 1, 0);
+anim(human_castteleport, 0);
+spotanim_pl(teleport_casting, 92, 0);
+p_delay(2);
+p_telejump($dest);
+mes("You step through the portal and arrive at <$name>.");
+
+// Portal 1: Lumbridge Portal (3207, 3436)
+[oploc1,rd_portal_room1_entrance]
+~hub_teleport_to(0_50_50_22_18, "Lumbridge Castle");
+
+// Portal 2: Falador Portal (3209, 3437)
+[oploc1,rd_portal_room1_exit]
+~hub_teleport_to(0_46_52_21_51, "Falador Square");
+
+// Portal 3: Camelot & Seers' Portal (3211, 3437)
+[oploc1,rd_portal_room2_entrance]
+~hub_teleport_to(0_43_54_5_21, "Camelot Castle");
+
+// Portal 4: East Ardougne Portal (3213, 3437)
+[oploc1,rd_portal_room2_exit]
+~hub_teleport_to(0_41_51_38_41, "East Ardougne Market");
+
+// Portal 5: Al Kharid & Desert Portal (3215, 3436)
+[oploc1,rd_portal_room3_entrance]
+~hub_teleport_to(0_51_49_29_38, "Al Kharid Palace");
+
+// Portal 6: Guilds & Training Portal (3207, 3434)
+[oploc1,rd_portal_room3_exit]
+@hub_guilds_training_menu;
+
+// Portal 7: Dungeons, Minigames & Frontiers Portal (3215, 3434)
+[oploc1,rd_portal_room4_entrance]
+@hub_dungeons_minigames_menu;
+
+// Portal 8: Return-to-Varrock-Hub Portal (placed at Lumbridge, Falador, Camelot, Ardougne, Al Kharid, Yanille, Castle Wars)
+[oploc1,rd_portal_room4_exit]
+~hub_teleport_to(0_50_53_11_43, " the Varrock Portal Hub");
+
+// Gielinor Teleport Guide NPC (2244 = lumbridge_guide at 3211, 3436)
+[opnpc1,lumbridge_guide]
+~chatnpc("<p,happy>Welcome to the Gielinor Fast-Travel Plaza! Where in the world would you like to travel today?");
+@teleport_guide_main_menu;
+
+[label,teleport_guide_main_menu]
+def_int $cat = ~p_choice5_header(
+    "Major Cities (Misthalin & Asgarnia)", 1,
+    "Major Cities (Kandarin & Desert)", 2,
+    "Guilds & Training Locations", 3,
+    "Dungeons, Minigames & Other Regions", 4,
+    "Return Home (Varrock Square)", 5,
+    "Gielinor Teleport Guide"
+);
+if ($cat = 1) {
+    @hub_cities_east_menu;
+} else if ($cat = 2) {
+    @hub_cities_west_menu;
+} else if ($cat = 3) {
+    @hub_guilds_training_menu;
+} else if ($cat = 4) {
+    @hub_dungeons_minigames_menu;
+} else {
+    ~hub_teleport_to(0_50_53_13_32, "Varrock Square");
+}
+
+[label,hub_cities_east_menu]
+def_int $c1 = ~p_choice5_header(
+    "Lumbridge Castle (Misthalin)", 1,
+    "Falador Square (Asgarnia)", 2,
+    "Edgeville Bank (Misthalin)", 3,
+    "Draynor Village & Port Sarim", 4,
+    "Back to Main Menu", 5,
+    "Misthalin & Asgarnia Cities"
+);
+if ($c1 = 1) {
+    ~hub_teleport_to(0_50_50_22_18, "Lumbridge Castle");
+} else if ($c1 = 2) {
+    ~hub_teleport_to(0_46_52_21_51, "Falador Square");
+} else if ($c1 = 3) {
+    ~hub_teleport_to(0_48_54_15_40, "Edgeville");
+} else if ($c1 = 4) {
+    def_int $sub = ~p_choice4_header(
+        "Draynor Village Market", 1,
+        "Port Sarim Docks", 2,
+        "Barbarian Village", 3,
+        "Rimmington & Taverley", 4,
+        "Select Town"
+    );
+    if ($sub = 1) ~hub_teleport_to(0_48_50_21_44, "Draynor Village");
+    if ($sub = 2) ~hub_teleport_to(0_47_50_15_8, "Port Sarim");
+    if ($sub = 3) ~hub_teleport_to(0_48_53_11_27, "Barbarian Village");
+    if ($sub = 4) ~hub_teleport_to(0_45_53_14_63, "Taverley");
+} else {
+    @teleport_guide_main_menu;
+}
+
+[label,hub_cities_west_menu]
+def_int $c2 = ~p_choice5_header(
+    "Camelot & Seers' Village (Kandarin)", 1,
+    "Catherby Coast (Kandarin)", 2,
+    "East Ardougne Market (Kandarin)", 3,
+    "Yanille & Watchtower (South Kandarin)", 4,
+    "Al Kharid Palace (Kharidian Desert)", 5,
+    "Kandarin & Desert Cities"
+);
+if ($c2 = 1) {
+    ~hub_teleport_to(0_42_54_37_29, "Seers' Village");
+} else if ($c2 = 2) {
+    ~hub_teleport_to(0_43_53_52_41, "Catherby");
+} else if ($c2 = 3) {
+    ~hub_teleport_to(0_41_51_38_41, "East Ardougne");
+} else if ($c2 = 4) {
+    ~hub_teleport_to(0_40_48_45_21, "Yanille");
+} else {
+    ~hub_teleport_to(0_51_49_29_38, "Al Kharid");
+}
+
+[label,hub_guilds_training_menu]
+def_int $g = ~p_choice5_header(
+    "Mining Guild & Al Kharid Mine", 1,
+    "Fishing Guild (North of Ardougne)", 2,
+    "Crafting Guild & Champions' Guild", 3,
+    "Wizards' Guild (Yanille)", 4,
+    "Barbarian Training Longhall", 5,
+    "Guilds & Training Locations"
+);
+if ($g = 1) {
+    def_int $m = ~p_choice2_header("Mining Guild (Dwarven Mine)", 1, "Al Kharid Scorpion Mine", 2, "Select Mining Site");
+    if ($m = 1) ~hub_teleport_to(0_47_152_13_11, "the Mining Guild");
+    if ($m = 2) ~hub_teleport_to(0_51_51_35_21, "Al Kharid Mine");
+} else if ($g = 2) {
+    ~hub_teleport_to(0_40_52_51_63, "the Fishing Guild");
+} else if ($g = 3) {
+    def_int $cg = ~p_choice2_header("Crafting Guild", 1, "Champions' Guild", 2, "Select Guild");
+    if ($cg = 1) ~hub_teleport_to(0_45_51_52_24, "the Crafting Guild");
+    if ($cg = 2) ~hub_teleport_to(0_49_52_55_35, "the Champions' Guild");
+} else if ($g = 4) {
+    ~hub_teleport_to(0_40_48_37_15, "the Wizards' Guild");
+} else {
+    ~hub_teleport_to(0_48_53_7_42, "Barbarian Training Area");
+}
+
+[label,hub_dungeons_minigames_menu]
+def_int $d = ~p_choice5_header(
+    "Castle Wars & Duel Arena (Minigames)", 1,
+    "Tree Gnome Stronghold & Burthorpe", 2,
+    "Karamja, Brimhaven & TzHaar City", 3,
+    "Canifis (Morytania) & Rellekka (Fremennik)", 4,
+    "Dangerous Dungeons (Sewers, Edge Dungeon, Barrows)", 5,
+    "Minigames, Frontiers & Dungeons"
+);
+if ($d = 1) {
+    def_int $mg = ~p_choice2_header("Castle Wars Lobby", 1, "Al Kharid Duel Arena", 2, "Select Minigame");
+    if ($mg = 1) ~hub_teleport_to(0_38_48_9_18, "Castle Wars");
+    if ($mg = 2) ~hub_teleport_to(0_52_51_38_2, "the Duel Arena");
+} else if ($d = 2) {
+    def_int $tg = ~p_choice2_header("Tree Gnome Stronghold", 1, "Burthorpe", 2, "Select Destination");
+    if ($tg = 1) ~hub_teleport_to(0_38_53_29_52, "the Tree Gnome Stronghold");
+    if ($tg = 2) ~hub_teleport_to(0_45_55_19_25, "Burthorpe");
+} else if ($d = 3) {
+    def_int $kr = ~p_choice3_header("Karamja Docks (Musa Point)", 1, "Brimhaven", 2, "TzHaar City (Volcano)", 3, "Select Karamja Destination");
+    if ($kr = 1) ~hub_teleport_to(0_45_49_36_40, "Karamja");
+    if ($kr = 2) ~hub_teleport_to(0_43_49_20_45, "Brimhaven");
+    if ($kr = 3) ~hub_teleport_to(0_38_80_12_52, "TzHaar City");
+} else if ($d = 4) {
+    def_int $mr = ~p_choice2_header("Canifis (Morytania)", 1, "Rellekka (Fremennik)", 2, "Select Frontier");
+    if ($mr = 1) ~hub_teleport_to(0_54_54_39_32, "Canifis");
+    if ($mr = 2) ~hub_teleport_to(0_41_57_36_9, "Rellekka");
+} else {
+    ~mesbox("Warning: These dungeons contain aggressive monsters! Are you sure you wish to proceed?");
+    def_int $dg = ~p_choice4_header(
+        "Yes: Varrock Sewers (Dangerous)", 1,
+        "Yes: Edgeville Dungeon (Dangerous)", 2,
+        "Yes: Barrows Mounds (Dangerous)", 3,
+        "No, keep me safe in Varrock!", 4,
+        "Confirm Dangerous Teleport"
+    );
+    if ($dg = 1) ~hub_teleport_to(0_50_154_37_3, "Varrock Sewers");
+    if ($dg = 2) ~hub_teleport_to(0_48_154_24_12, "Edgeville Dungeon");
+    if ($dg = 3) ~hub_teleport_to(0_55_51_45_44, "Barrows Mounds");
+}
