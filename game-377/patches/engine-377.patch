+
+// Exact Jagex #377 FloType RGB colors from tools/pack/map/Worldmap.ts
+const REF_COLORS: number[] = [
+    0x847776, 0x504746, 0x564d4d, 0x766a69, 0x3a1c0c, 0x4f648d, 0x1f6248, 0x504746, 0xbbb9b2, 0x463f3f, 0x100f0f, 0x3f3934, 0x95342f, 0x503911, 0x3b250c, 0x674204, 0x4f3a03, 0x12068c, 0xe15f15, 0x4d4d4f, 0x887006, 0x544a24, 0x605528, 0x38322d,
