// JoshRS original dialogue for Lost City 377. Administrative spawn only.

[opnpc1,joshrs_ore_buyer]
~chatnpc("<p,neutral>I pay eight coins for two pieces of copper ore.");
def_int $choice = ~p_choice2_header("Sell 2 copper ores for 8 coins.", 1, "Not today.", 2, "Would you like to trade?");
if ($choice ! 1) { return; }
if (inv_total(inv, copper_ore) < 2) {
    mes("You do not have enough supplies to complete this trade.");
    return;
}
inv_del(inv, copper_ore, 2);
inv_add(inv, coins, 8);
mes("You sell two copper ores for eight coins.");

[debugproc,joshrs_spawn_joshrs_ore_buyer]
npc_add(coord, joshrs_ore_buyer, 500);
mes("Ore Buyer has been summoned near you.");

[opnpc1,joshrs_timber_buyer]
~chatnpc("<p,neutral>I pay twelve coins for three ordinary logs.");
def_int $choice = ~p_choice2_header("Sell 3 logs for 12 coins.", 1, "Not today.", 2, "Would you like to trade?");
if ($choice ! 1) { return; }
if (inv_total(inv, logs) < 3) {
    mes("You do not have enough supplies to complete this trade.");
    return;
}
inv_del(inv, logs, 3);
inv_add(inv, coins, 12);
mes("You exchange three logs for twelve coins.");

[debugproc,joshrs_spawn_joshrs_timber_buyer]
npc_add(coord, joshrs_timber_buyer, 500);
mes("Timber Buyer has been summoned near you.");

[opnpc1,joshrs_trail_provisioner]
~chatnpc("<p,neutral>A hot meal costs four coins if your pack has room.");
def_int $choice = ~p_choice2_header("Buy cooked meat for 4 coins.", 1, "Not today.", 2, "Would you like to trade?");
if ($choice ! 1) { return; }
if (inv_total(inv, coins) < 4) {
    mes("You do not have enough supplies to complete this trade.");
    return;
}
if (inv_freespace(inv) < 1) {
    mes("Make room in your inventory before trading.");
    return;
}
inv_del(inv, coins, 4);
inv_add(inv, cooked_meat, 1);
mes("You buy a warm meal for four coins.");

[debugproc,joshrs_spawn_joshrs_trail_provisioner]
npc_add(coord, joshrs_trail_provisioner, 500);
mes("Trail Provisioner has been summoned near you.");

[opnpc1,joshrs_woodland_guide]
~chatnpc("<p,happy>Welcome to the woodland trail!");
~chatnpc("<p,neutral>An original guide who welcomes explorers to the woodland trail.");
mes("This original JoshRS guide is ready to talk.");

[debugproc,joshrs_spawn_joshrs_woodland_guide]
npc_add(coord, joshrs_woodland_guide, 500);
mes("Woodland Guide has been summoned near you.");
