// JoshRS original dialogue for Lost City 377. Administrative spawn only.

[opnpc1,joshrs_crafting_supplier]
~chatnpc("<p,neutral>I sell amulet moulds to help you make your own jewellery.");
def_int $choice = ~p_choice2_header("Buy an amulet mould for 25 coins.", 1, "Not today.", 2, "Would you like to trade?");
if ($choice ! 1) { return; }
if (inv_total(inv, coins) < 25) {
    mes("You do not have enough supplies to complete this trade.");
    return;
}
if (inv_freespace(inv) < 1) {
    mes("Make room in your inventory before trading.");
    return;
}
inv_del(inv, coins, 25);
inv_add(inv, amulet_mould, 1);
mes("You buy an amulet mould.");

[debugproc,joshrs_spawn_joshrs_crafting_supplier]
npc_add(coord, joshrs_crafting_supplier, 500);
mes("Crafting Supplier has been summoned near you.");

